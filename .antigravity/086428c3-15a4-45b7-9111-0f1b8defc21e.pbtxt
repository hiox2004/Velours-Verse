          target_content: "          {/* User Accounts Directory Table */}\n          <div className=\"space-y-3 pt-4\">\n            <h3 className=\"font-display-chic text-lg font-bold text-zinc-950 dark:text-white\">\n              User Accounts Directory (God Mode Display)\n            </h3>\n\n            <div className=\"overflow-x-auto rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-2xs\">\n              <table className=\"w-full text-left text-xs\">\n                <thead className=\"bg-zinc-50 dark:bg-zinc-800/80 border-b-2 border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-bold\">\n                  <tr>\n                    <th className=\"p-3\">User</th>\n                    <th className=\"p-3\">Private Gmail (Dev View)</th>\n                    <th className=\"p-3\">Penpal ID</th>\n                    <th className=\"p-3\">Role</th>\n                    <th className=\"p-3\">Pieces Authored</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-zinc-200 dark:divide-zinc-800\">\n                  {allUsers.map(user => {\n                    const count = pieces.filter(p => p.authorId === user.id || p.authorEmail === user.email).length;\n                    return (\n                      <tr key={user.id} className=\"hover:bg-zinc-50 dark:hover:bg-zinc-800/40\">\n                        <td className=\"p-3 flex items-center gap-2\">\n                          <img src={user.avatar} alt=\"\" className=\"w-6 h-6 rounded-full object-cover ring-1 ring-zinc-300\" />\n                          <span className=\"font-bold text-zinc-950 dark:text-white\">{user.displayName}</span>\n                        </td>\n                        <td className=\"p-3 font-mono text-indigo-600 dark:text-indigo-400 font-bold\">{user.email}</td>\n                        <td className=\"p-3 font-mono text-pink-600 font-bold\">{user.penpalId}</td>\n                        <td className=\"p-3\">\n                          <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold ${\n                            user.role === \'developer\' ? \'bg-indigo-100 text-indigo-800\' : \'bg-zinc-100 text-zinc-700\'\n                          }`}>\n                            {user.role}\n                          </span>\n                        </td>\n                        <td className=\"p-3 font-mono font-bold text-zinc-900 dark:text-white\">{count}</td>\n                      </tr>\n                    );\n                  })}\n                </tbody>\n              </table>\n            </div>\n          </div>"
          replacement_content: "          {/* User Accounts Directory (Writing Log Glass Depth & Interactive Dossier) */}\n          <div\n            style={glassStyle}\n            className={`group relative p-6 md:p-8 rounded-3xl border-3 ${cardStyle.border} ${cardStyle.shadow} overflow-hidden backdrop-blur-xl shadow-xl transition-all space-y-5`}\n          >\n            {/* Top Accent Strip Bar */}\n            <div className={`absolute top-0 left-0 right-0 h-2 ${cardStyle.accentBar}`} />\n\n            {/* Frosted Glass Sheen Overlay */}\n            <div\n              className=\"absolute inset-0 bg-gradient-to-b from-white/35 dark:from-white/10 to-transparent pointer-events-none rounded-3xl\"\n              style={{ backgroundClip: \'padding-box\', WebkitBackgroundClip: \'padding-box\' }}\n            />\n\n            {/* Decorative Theme Watermark */}\n            <div className=\"absolute right-4 top-4 opacity-15 pointer-events-none text-black dark:text-white\" aria-hidden=\"true\">\n              <ThemeMotifIcon themeId={themeId} className=\"w-16 h-16\" />\n            </div>\n\n            {/* Directory Header Bar */}\n            <div className=\"relative z-10 space-y-2\">\n              <div className=\"flex items-center justify-between flex-wrap gap-2\">\n                <span className={`px-3 py-1 rounded-full ${cardStyle.accentBar} text-white text-[11px] font-black uppercase tracking-wider flex items-center gap-1.5 shadow-2xs`}>\n                  <Users className=\"w-3.5 h-3.5\" />\n                  <span>User Accounts Directory & Records ({allUsers.length})</span>\n                </span>\n                <span className=\"text-xs text-black/70 dark:text-zinc-300 font-bold flex items-center gap-1\">\n                  <ShieldCheck className=\"w-3.5 h-3.5 text-indigo-600 dark:text-indigo-400\" />\n                  <span>God Mode Access \302\267 Click any account to view complete DB dossier</span>\n                </span>\n              </div>\n\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1\">\n                <div>\n                  <h3 className=\"font-display-chic text-xl font-black text-black dark:text-white\">\n                    Registered Writers & Developer Profiles\n                  </h3>\n                  <p className=\"text-xs font-bold text-black/80 dark:text-zinc-200\">\n                    Comprehensive ledger of all user entities, private Gmails, Penpal IDs, manifestos, goals, and writings.\n                  </p>\n                </div>\n\n                {/* Filter and Search controls */}\n                <div className=\"flex items-center gap-2 flex-wrap sm:flex-nowrap\">\n                  <div className=\"relative\">\n                    <Search className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-black/50 dark:text-zinc-400 stroke-[2.5]\" />\n                    <input\n                      type=\"text\"\n                      placeholder=\"Search accounts...\"\n                      value={userSearchQuery}\n                      onChange={e => setUserSearchQuery(e.target.value)}\n                      className=\"pl-8 pr-3 py-1.5 text-xs rounded-xl bg-white/80 dark:bg-zinc-800/80 border-2 border-black/30 dark:border-zinc-700 font-bold text-black dark:text-white focus:outline-hidden focus:ring-2 focus:ring-indigo-500 w-44 sm:w-52\"\n                    />\n                  </div>\n\n                  <div className=\"flex items-center p-0.5 rounded-xl bg-black/5 dark:bg-white/5 border border-black/20 dark:border-white/10 text-[11px] font-bold\">\n                    <button\n                      onClick={() => setUserRoleFilter(\'all\')}\n                      className={`px-2.5 py-1 rounded-lg transition-all ${\n                        userRoleFilter === \'all\'\n                          ? \'bg-black text-white dark:bg-white dark:text-black font-black shadow-xs\'\n                          : \'text-black dark:text-zinc-300\'\n                      }`}\n                    >\n                      All ({allUsers.length})\n                    </button>\n                    <button\n                      onClick={() => setUserRoleFilter(\'developer\')}\n                      className={`px-2.5 py-1 rounded-lg transition-all ${\n                        userRoleFilter === \'developer\'\n                          ? \'bg-indigo-600 text-white font-black shadow-xs\'\n                          : \'text-black dark:text-zinc-300\'\n                      }`}\n                    >\n                      Devs\n                    </button>\n                    <button\n                      onClick={() => setUserRoleFilter(\'writer\')}\n                      className={`px-2.5 py-1 rounded-lg transition-all ${\n                        userRoleFilter === \'writer\'\n                          ? \'bg-black text-white dark:bg-white dark:text-black font-black shadow-xs\'\n                          : \'text-black dark:text-zinc-300\'\n                      }`}\n                    >\n                      Writers\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Account Cards Grid / List with Writing Log depth */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3.5 relative z-10 pt-1\">\n              {filteredUsers.length === 0 ? (\n                <div className=\"col-span-full py-8 text-center text-xs font-bold text-black/60 dark:text-zinc-400\">\n                  No user accounts matching &ldquo;{userSearchQuery}&rdquo;\n                </div>\n              ) : (\n                filteredUsers.map(user => {\n                  const userPieces = pieces.filter(p => p.authorId === user.id || p.authorEmail === user.email);\n                  const isUserDev = devRoster.some(e => e.toLowerCase() === user.email.toLowerCase()) || user.role === \'developer\';\n                  const totalWords = userPieces.reduce((acc, p) => acc + (p.wordCount || 0), 0);\n\n                  return (\n                    <div\n                      key={user.id}\n                      onClick={() => setSelectedUserForModal(user)}\n                      style={glassStyle}\n                      className={`group/card relative p-4 rounded-2xl border-2 ${cardStyle.border} ${cardStyle.shadow} backdrop-blur-md cursor-pointer hover:-translate-y-1 hover:shadow-lg transition-all duration-200 overflow-hidden flex flex-col justify-between`}\n                    >\n                      {/* Top micro accent strip */}\n                      <div className={`absolute top-0 left-0 right-0 h-1 ${isUserDev ? \'bg-indigo-600\' : cardStyle.accentBar}`} />\n\n                      {/* Header row: Avatar, Name, Role badge */}\n                      <div className=\"space-y-2.5\">\n                        <div className=\"flex items-start justify-between gap-2\">\n                          <div className=\"flex items-center gap-3 min-w-0\">\n                            <div className=\"relative shrink-0\">\n                              <img\n                                src={user.avatar}\n                                alt={user.displayName}\n                                className=\"w-11 h-11 rounded-2xl object-cover ring-2 ring-black/20 dark:ring-white/20 shadow-xs group-hover/card:scale-105 transition-transform\"\n                              />\n                              {isUserDev && (\n                                <span className=\"absolute -bottom-1 -right-1 p-0.5 rounded-full bg-indigo-600 text-white shadow-2xs\" title=\"Developer\">\n                                  <ShieldCheck className=\"w-3 h-3 stroke-[2.5]\" />\n                                </span>\n                              )}\n                            </div>\n\n                            <div className=\"min-w-0\">\n                              <div className=\"flex items-center gap-1.5 flex-wrap\">\n                                <h4 className=\"font-display-chic text-sm font-black text-black dark:text-white truncate\">\n                                  {user.displayName}\n                                </h4>\n                                {user.id === currentUser.id && (\n                                  <span className=\"text-[10px] px-1.5 py-0.2 rounded-md bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-300 font-black border border-emerald-300\">\n                                    Current Session\n                                  </span>\n                                )}\n                              </div>\n                              <span className=\"text-[11px] font-mono text-pink-700 dark:text-pink-400 font-black block\">\n                                {user.penpalId}\n                              </span>\n                            </div>\n                          </div>\n\n                          <span className={`text-[10px] font-black px-2 py-0.5 rounded-full shrink-0 uppercase tracking-wider ${\n                            isUserDev\n                              ? \'bg-indigo-100 text-indigo-900 dark:bg-indigo-950 dark:text-indigo-200 border border-indigo-400\'\n                              : \'bg-zinc-100 text-zinc-900 dark:bg-zinc-800 dark:text-zinc-200 border border-zinc-300 dark:border-zinc-700\'\n                          }`}>\n                            {isUserDev ? \'Developer\' : \'Writer\'}\n                          </span>\n                        </div>\n\n                        {/* Private Gmail indicator (God Mode perk) */}\n                        <div className=\"flex items-center gap-1.5 text-[11px] font-mono text-indigo-700 dark:text-indigo-300 font-bold bg-indigo-50/70 dark:bg-indigo-950/40 px-2 py-1 rounded-lg border border-indigo-200 dark:border-indigo-800/60 truncate\">\n                          <Lock className=\"w-3 h-3 shrink-0 text-indigo-600 stroke-[2.5]\" />\n                          <span className=\"truncate\">Gmail: {user.email}</span>\n                        </div>\n\n                        {/* Bio snippet */}\n                        {user.bio && (\n                          <p className=\"text-xs text-black/80 dark:text-zinc-300 font-medium line-clamp-2 italic\">\n                            &ldquo;{user.bio}&rdquo;\n                          </p>\n                        )}\n                      </div>\n\n                      {/* Footer metrics & CTA */}\n                      <div className=\"pt-3 mt-2 border-t border-black/10 dark:border-white/10 flex items-center justify-between text-xs font-bold gap-2\">\n                        <div className=\"flex items-center gap-2 text-[11px] text-black/70 dark:text-zinc-300 font-mono\">\n                          <span className=\"font-black text-black dark:text-white\">{userPieces.length} pieces</span>\n                          <span>\302\267</span>\n                          <span>{totalWords.toLocaleString()} words</span>\n                          <span>\302\267</span>\n                          <span className=\"text-pink-600 font-bold\">{user.penpalIds.length} penpals</span>\n                        </div>\n\n                        <button\n                          type=\"button\"\n                          onClick={(e) => {\n                            e.stopPropagation();\n                            setSelectedUserForModal(user);\n                          }}\n                          className=\"px-2.5 py-1 rounded-xl text-[11px] font-black bg-black text-white dark:bg-white dark:text-black hover:opacity-90 active:scale-95 transition-all flex items-center gap-1 shadow-2xs shrink-0\"\n                        >\n                          <span>Open Details</span>\n                          <ArrowRight className=\"w-3 h-3 stroke-[2.5]\" />\n                        </button>\n                      </div>\n                    </div>\n                  );\n                })\n              )}\n            </div>\n          </div>"
          start_line: 662
          end_line: 705
        }
      }
    }
