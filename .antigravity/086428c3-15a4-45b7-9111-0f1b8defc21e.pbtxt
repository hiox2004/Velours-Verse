    end_line: 119
    content: "import React, { useState } from \'react\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { useTheme } from \'../context/ThemeContext\';\nimport { StorageService } from \'../services/storage\';\nimport { ThemeMotifIcon } from \'./ThemeIllustrations\';\nimport {\n  Mail,\n  UserPlus,\n  Copy,\n  Check,\n  Coffee,\n  Quote,\n  Sparkles,\n  Users,\n  ShieldAlert,\n  ArrowRight\n} from \'lucide-react\';\n\ninterface PenpalHubProps {\n  onOpenFeedForPenpals: () => void;\n  onOpenProfile: () => void;\n}\n\nexport const PenpalHub: React.FC<PenpalHubProps> = ({\n  onOpenFeedForPenpals,\n  onOpenProfile\n}) => {\n  const { currentUser, addPenpal, removePenpal } = useAuth();\n  const { theme, themeId } = useTheme();\n\n  const [inputPenpalId, setInputPenpalId] = useState(\'\');\n  const [copiedMyId, setCopiedMyId] = useState(false);\n  const [statusMessage, setStatusMessage] = useState<{ text: string; isError: boolean } | null>(null);\n\n  // Retrieve penpals from global user directory based on IDs\n  const allUsers = StorageService.getAllUsers();\n  const myPenpals = allUsers.filter(u => currentUser.penpalIds.includes(u.penpalId));\n\n  const handleCopyId = () => {\n    navigator.clipboard.writeText(currentUser.penpalId);\n    setCopiedMyId(true);\n    setTimeout(() => setCopiedMyId(false), 2000);\n  };\n\n  const handleAddSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setStatusMessage(null);\n    const res = addPenpal(inputPenpalId);\n    setStatusMessage({\n      text: res.message,\n      isError: !res.success\n    });\n    if (res.success) {\n      setInputPenpalId(\'\');\n    }\n  };\n\n  return (\n    <div className=\"max-w-4xl mx-auto px-4 py-8 space-y-8 animate-in fade-in duration-200\">\n      {/* Hero Banner with Theme Motif */}\n      <div className=\"p-6 md:p-8 rounded-3xl bg-white dark:bg-zinc-900 border-3 border-black/20 dark:border-zinc-800 relative overflow-hidden shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-none\">\n        <div className=\"relative z-10 max-w-xl space-y-3\">\n          <div className=\"flex items-center gap-2 text-xs font-black text-pink-700 dark:text-pink-400\">\n            <Mail className=\"w-4 h-4 stroke-[2.5]\" />\n            <span>Penpal Circle & Creative Network</span>\n          </div>\n\n          <h2 className=\"font-display-chic text-2xl md:text-3xl font-black text-black dark:text-white\">\n            Letters & Verses Between Kindred Spirits\n          </h2>\n\n          <p className=\"font-serif-literary text-black dark:text-zinc-200 text-base leading-relaxed font-bold\">\n            Exchange writings exclusively with chosen friends. Connect through uniquely generated Penpal IDs with complete email privacy.\n          </p>\n        </div>\n\n        <div className=\"absolute right-4 bottom-2 text-black/10 dark:text-zinc-800 opacity-60 pointer-events-none\" aria-hidden=\"true\">\n          <ThemeMotifIcon themeId={themeId} className=\"w-24 h-24\" />\n        </div>\n      </div>\n\n      {/* Grid: My Penpal Identity Card & Add Penpal Box */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        {/* Card 1: My Personal Penpal Identity */}\n        <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-3 border-black/20 dark:border-zinc-800 space-y-5 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-none\">\n          <div className=\"flex items-start justify-between\">\n            <div className=\"flex items-center gap-3\">\n              <img\n                src={currentUser.avatar}\n                alt={currentUser.displayName}\n                className=\"w-12 h-12 rounded-full object-cover ring-2 ring-black dark:ring-white\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div>\n                <h3 className=\"font-display-chic text-lg font-black text-black dark:text-white\">\n                  {currentUser.displayName}\n                </h3>\n                <p className=\"text-xs text-black dark:text-zinc-300 font-bold\">Your Public Identity</p>\n              </div>\n            </div>\n\n            <button\n              onClick={onOpenProfile}\n              className=\"text-xs font-black text-black dark:text-zinc-200 hover:underline\"\n            >\n              Edit Bio\n            </button>\n          </div>\n\n          {/* Penpal ID Copy Box */}\n          <div className=\"p-4 rounded-xl bg-zinc-50 dark:bg-zinc-800/80 border-2 border-black/30 dark:border-zinc-700 space-y-2\">\n            <div className=\"text-[11px] font-black text-black dark:text-zinc-300 uppercase tracking-wider\">\n              Your Unique Penpal ID\n            </div>\n            <div className=\"flex items-center justify-between\">\n              <span className=\"font-mono text-xl font-black text-pink-700 dark:text-pink-400 tracking-wider\">\n                {currentUser.penpalId}\n              </span>\n              <button\n                onClick={handleCopyId}"
