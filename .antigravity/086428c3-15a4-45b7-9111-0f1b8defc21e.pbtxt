  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useTheme } from \'../context/ThemeContext\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { AppView } from \'../types/writing\';\nimport { AestheticThemeId } from \'../types/theme\';\nimport { ThemeMotifIcon } from \'./ThemeIllustrations\';\nimport {\n  Compass,\n  BookOpen,\n  Mail,\n  Sparkles,\n  Code2,\n  Sun,\n  Moon,\n  Plus,\n  Wifi,\n  WifiOff,\n  User,\n  ShieldCheck,\n  Palette,\n  Check\n} from \'lucide-react\';\n\ninterface NavigationProps {\n  currentView: AppView;\n  onSelectView: (view: AppView) => void;\n  onOpenNewPiece: () => void;\n  onOpenProfile: () => void;\n  isOnline: boolean;\n  syncState: \'synced\' | \'syncing\' | \'offline\';\n}\n\nexport const Navigation: React.FC<NavigationProps> = ({\n  currentView,\n  onSelectView,\n  onOpenNewPiece,\n  onOpenProfile,\n  isOnline,\n  syncState\n}) => {\n  const { themeId, setThemeId, mode, toggleMode, theme } = useTheme();\n  const { currentUser, isDeveloper } = useAuth();\n  const [showThemePicker, setShowThemePicker] = useState(false);\n\n  const themeOptions: { id: AestheticThemeId; name: string; motif: string }[] = [\n    { id: \'coquette\', name: \'Coquette Blush\', motif: \'Silk Bow\' },\n    { id: \'y2k\', name: \'Cyber Y2K\', motif: \'Chrome Star\' },\n    { id: \'matcha\', name: \'Matcha Latte\', motif: \'Tea Leaf\' },\n    { id: \'midnight\', name: \'Midnight Muse\', motif: \'Crescent Moon\' }\n  ];\n\n  return (\n    <>\n      {/* DESKTOP / TABLET TOP APP BAR (Crisp, High Contrast, 3-Zone Contract) */}\n      <header className=\"hidden md:block sticky top-0 z-40 backdrop-blur-md bg-white/95 dark:bg-zinc-950/95 border-b-2 border-zinc-200 dark:border-zinc-800 no-print transition-colors duration-200 shadow-2xs\">\n        <div className=\"max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-8\">\n          {/* Zone 1: Brand Wordmark with Theme Vector Icon */}\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <button\n              onClick={() => onSelectView(\'feed\')}\n              className=\"flex items-center gap-2.5 text-left group\"\n            >\n              <div className=\"w-8 h-8 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-white border border-zinc-300 dark:border-zinc-700 group-hover:scale-105 transition-transform\">\n                <ThemeMotifIcon themeId={themeId} className=\"w-4 h-4 text-zinc-900 dark:text-white\" />\n              </div>\n              <span className=\"font-display-chic text-xl font-black tracking-tight text-zinc-900 dark:text-white group-hover:opacity-90 transition-opacity whitespace-nowrap\">\n                Velours & Verse\n              </span>\n            </button>\n\n            {/* Offline / Synced Indicator Badge */}\n            <div className=\"hidden lg:flex items-center gap-1.5 px-2.5 py-1 text-xs rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700 font-medium\">\n              {isOnline ? (\n                <Wifi className=\"w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400\" />\n              ) : (\n                <WifiOff className=\"w-3.5 h-3.5 text-amber-600 dark:text-amber-400\" />\n              )}\n              <span className=\"text-[11px] font-semibold\">\n                {syncState === \'synced\' ? \'Synced\' : syncState === \'syncing\' ? \'Syncing...\' : \'Offline (Cached)\'}\n              </span>\n            </div>\n          </div>\n\n          {/* Zone 2: Navigation Links (Single-Line, 4-5 Items, High-Contrast Text) */}\n          <nav className=\"flex items-center gap-7 text-sm font-semibold text-zinc-600 dark:text-zinc-300\">\n            <button\n              onClick={() => onSelectView(\'feed\')}\n              className={`hover:text-zinc-950 dark:hover:text-white transition-colors whitespace-nowrap shrink-0 pb-1 ${\n                currentView === \'feed\'\n                  ? \'text-zinc-950 dark:text-white border-b-2 border-zinc-900 dark:border-white\'\n                  : \'\'\n              }`}\n            >\n              Writing Log\n            </button>\n            <button\n              onClick={() => onSelectView(\'penpals\')}\n              className={`hover:text-zinc-950 dark:hover:text-white transition-colors whitespace-nowrap shrink-0 pb-1 ${\n                currentView === \'penpals\'\n                  ? \'text-zinc-950 dark:text-white border-b-2 border-zinc-900 dark:border-white\'\n                  : \'\'\n              }`}\n            >\n              Penpals Circle\n            </button>\n            <button\n              onClick={() => onSelectView(\'widgets\')}\n              className={`hover:text-zinc-950 dark:hover:text-white transition-colors whitespace-nowrap shrink-0 pb-1 ${\n                currentView === \'widgets\'\n                  ? \'text-zinc-950 dark:text-white border-b-2 border-zinc-900 dark:border-white\'\n                  : \'\'\n              }`}\n            >\n              Sound & Widgets\n            </button>\n            {isDeveloper && (\n              <button\n                onClick={() => onSelectView(\'dev_academy\')}\n                className={`flex items-center gap-1.5 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors whitespace-nowrap shrink-0 pb-1 ${\n                  currentView === \'dev_academy\'\n                    ? \'text-indigo-600 dark:text-indigo-400 border-b-2 border-indigo-600 dark:border-indigo-400\'\n                    : \'text-indigo-600 dark:text-indigo-400\'\n                }`}\n              >\n                <ShieldCheck className=\"w-4 h-4\" />\n                <span>Dev Academy</span>\n              </button>\n            )}\n          </nav>\n\n          {/* Zone 3: Actions (Theme Picker, Dark Toggle, Profile, New Piece) */}\n          <div className=\"flex items-center gap-2.5 shrink-0\">\n            {/* Theme Picker Dropdown */}\n            <div className=\"relative\">\n              <button\n                onClick={() => setShowThemePicker(!showThemePicker)}\n                className=\"h-9 px-2.5 rounded-xl flex items-center gap-1.5 text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 border border-zinc-300 dark:border-zinc-700 transition-colors font-medium text-xs\"\n                title=\"Change aesthetic theme\"\n                aria-label=\"Change aesthetic theme\"\n              >\n                <ThemeMotifIcon themeId={themeId} className=\"w-3.5 h-3.5\" />\n                <span className=\"hidden sm:inline font-semibold\">{theme.name.split(\' \')[0]}</span>\n              </button>\n\n              {showThemePicker && (\n                <div className=\"absolute right-0 mt-2 w-56 py-2 bg-white dark:bg-zinc-900 rounded-2xl shadow-2xl border-2 border-zinc-200 dark:border-zinc-700 z-50 animate-in fade-in zoom-in-95 duration-100\">\n                  <div className=\"px-3.5 py-1.5 text-[11px] font-bold text-zinc-500 uppercase tracking-wider\">\n                    Select Aesthetic Theme\n                  </div>\n                  {themeOptions.map(t => (\n                    <button\n                      key={t.id}\n                      onClick={() => {\n                        setThemeId(t.id);\n                        setShowThemePicker(false);\n                      }}\n                      className={`w-full px-3.5 py-2.5 text-left text-xs flex items-center justify-between transition-colors ${\n                        themeId === t.id\n                          ? \'bg-zinc-100 dark:bg-zinc-800 font-bold text-zinc-950 dark:text-white\'\n                          : \'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-800/60\'\n                      }`}\n                    >\n                      <span className=\"flex items-center gap-2.5\">\n                        <div className=\"w-6 h-6 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center border border-zinc-200 dark:border-zinc-700\">\n                          <ThemeMotifIcon themeId={t.id} className=\"w-3.5 h-3.5\" />\n                        </div>\n                        <div>\n                          <div className=\"font-semibold text-zinc-900 dark:text-white\">{t.name}</div>\n                          <div className=\"text-[10px] text-zinc-500\">{t.motif}</div>\n                        </div>\n                      </span>\n                      {themeId === t.id && <Check className=\"w-4 h-4 text-zinc-900 dark:text-white\" />}\n                    </button>\n                  ))}\n                </div>\n              )}\n            </div>\n\n            {/* Dark / Light Toggle */}\n            <button\n              onClick={toggleMode}\n              className=\"w-9 h-9 rounded-xl flex items-center justify-center text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 border border-zinc-300 dark:border-zinc-700 transition-colors\"\n              title={`Switch to ${mode === \'light\' ? \'Dark\' : \'Light\'} Mode`}\n              aria-label=\"Toggle theme mode\"\n            >\n              {mode === \'light\' ? <Moon className=\"w-4 h-4 text-zinc-800\" /> : <Sun className=\"w-4 h-4 text-amber-300\" />}\n            </button>\n\n            {/* Profile Avatar / Login */}\n            <button\n              onClick={onOpenProfile}\n              className=\"flex items-center gap-2 pl-1.5 pr-3 py-1 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 border border-zinc-300 dark:border-zinc-700 transition-colors\"\n              title=\"Open profile & penpal info\"\n            >\n              <img\n                src={currentUser.avatar}\n                alt={currentUser.displayName}\n                className=\"w-6 h-6 rounded-full object-cover ring-1 ring-zinc-400\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <span className=\"text-xs font-bold text-zinc-900 dark:text-zinc-100 max-w-[90px] truncate\">\n                {currentUser.displayName}\n              </span>\n            </button>\n\n            {/* Primary Action Button */}\n            <button\n              onClick={onOpenNewPiece}\n              className=\"flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-white bg-zinc-950 dark:bg-white dark:text-zinc-950 hover:opacity-90 active:scale-[0.98] transition-all shadow-sm border border-zinc-800 dark:border-white\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              <span>Write Piece</span>\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* MOBILE TOP BAR (High contrast header) */}\n      <header className=\"md:hidden sticky top-0 z-40 backdrop-blur-md bg-white/95 dark:bg-zinc-950/95 border-b-2 border-zinc-200 dark:border-zinc-800 px-4 h-14 flex items-center justify-between no-print\">\n        <button\n          onClick={() => onSelectView(\'feed\')}\n          className=\"flex items-center gap-2 text-left\"\n        >\n          <div className=\"w-7 h-7 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center border border-zinc-300 dark:border-zinc-700\">\n            <ThemeMotifIcon themeId={themeId} className=\"w-3.5 h-3.5 text-zinc-900 dark:text-white\" />\n          </div>\n          <span className=\"font-display-chic text-lg font-black tracking-tight text-zinc-950 dark:text-white truncate max-w-[150px]\">\n            Velours & Verse\n          </span>\n        </button>\n\n        <div className=\"flex items-center gap-1.5\">\n          <button\n            onClick={() => setShowThemePicker(!showThemePicker)}\n            className=\"w-9 h-9 rounded-xl flex items-center justify-center text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700\"\n            aria-label=\"Theme\"\n          >\n            <ThemeMotifIcon themeId={themeId} className=\"w-4 h-4\" />\n          </button>\n\n          <button\n            onClick={toggleMode}\n            className=\"w-9 h-9 rounded-xl flex items-center justify-center text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700\"\n            aria-label=\"Toggle dark mode\"\n          >\n            {mode === \'light\' ? <Moon className=\"w-4 h-4\" /> : <Sun className=\"w-4 h-4\" />}\n          </button>\n\n          <button\n            onClick={onOpenProfile}\n            className=\"w-9 h-9 rounded-xl flex items-center justify-center ml-0.5\"\n            aria-label=\"Profile\"\n          >\n            <img\n              src={currentUser.avatar}\n              alt={currentUser.displayName}\n              className=\"w-7 h-7 rounded-full object-cover ring-1 ring-zinc-400\"\n              referrerPolicy=\"no-referrer\"\n            />\n          </button>\n        </div>\n\n        {/* Mobile Theme Popover */}\n        {showThemePicker && (\n          <div className=\"absolute top-14 right-4 w-52 py-2 bg-white dark:bg-zinc-900 rounded-2xl shadow-2xl border-2 border-zinc-300 dark:border-zinc-700 z-50\">\n            <div className=\"px-3.5 py-1 text-[10px] font-bold text-zinc-500 uppercase tracking-wider\">\n              Aesthetic Styles\n            </div>\n            {themeOptions.map(t => (\n              <button\n                key={t.id}\n                onClick={() => {\n                  setThemeId(t.id);\n                  setShowThemePicker(false);\n                }}\n                className={`w-full px-3.5 py-2.5 text-left text-xs flex items-center justify-between ${\n                  themeId === t.id\n                    ? \'bg-zinc-100 dark:bg-zinc-800 font-bold text-zinc-950 dark:text-white\'\n                    : \'text-zinc-700 dark:text-zinc-300\'\n                }`}\n              >\n                <span className=\"flex items-center gap-2.5\">\n                  <ThemeMotifIcon themeId={t.id} className=\"w-3.5 h-3.5\" />\n                  <span>{t.name}</span>\n                </span>\n                {themeId === t.id && <Check className=\"w-4 h-4 text-zinc-900 dark:text-white\" />}\n              </button>\n            ))}\n          </div>\n        )}\n      </header>\n\n      {/* MOBILE FLOATING COMPOSE ACTION BUTTON (Pinned above bottom bar) */}\n      <div className=\"md:hidden fixed bottom-20 right-4 z-40 no-print\">\n        <button\n          onClick={onOpenNewPiece}\n          className=\"w-14 h-14 rounded-full flex items-center justify-center bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 shadow-2xl border-2 border-white/20 active:scale-95 transition-transform\"\n          aria-label=\"Compose new piece\"\n        >\n          <Plus className=\"w-6 h-6\" />\n        </button>\n      </div>\n\n      {/* MOBILE FIXED BOTTOM TAB BAR (Navigation Anchor, Touch targets >= 44px, High Contrast) */}\n      <nav className=\"md:hidden fixed bottom-0 left-0 right-0 z-40 backdrop-blur-md bg-white/98 dark:bg-zinc-950/98 border-t-2 border-zinc-200 dark:border-zinc-800 h-16 grid grid-cols-4 items-center pb-safe no-print\">\n        <button\n          onClick={() => onSelectView(\'feed\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n            currentView === \'feed\'\n              ? \'text-zinc-950 dark:text-white font-bold\'\n              : \'text-zinc-500 dark:text-zinc-400\'\n          }`}\n        >\n          <BookOpen className=\"w-5 h-5\" />\n          <span className=\"text-[10px] mt-1 font-semibold\">Logs</span>\n        </button>\n\n        <button\n          onClick={() => onSelectView(\'penpals\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n            currentView === \'penpals\'\n              ? \'text-zinc-950 dark:text-white font-bold\'\n              : \'text-zinc-500 dark:text-zinc-400\'\n          }`}\n        >\n          <Mail className=\"w-5 h-5\" />\n          <span className=\"text-[10px] mt-1 font-semibold\">Penpals</span>\n        </button>\n\n        <button\n          onClick={() => onSelectView(\'widgets\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n            currentView === \'widgets\'\n              ? \'text-zinc-950 dark:text-white font-bold\'\n              : \'text-zinc-500 dark:text-zinc-400\'\n          }`}\n        >\n          <Sparkles className=\"w-5 h-5\" />\n          <span className=\"text-[10px] mt-1 font-semibold\">Studio</span>\n        </button>\n\n        {isDeveloper ? (\n          <button\n            onClick={() => onSelectView(\'dev_academy\')}\n            className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n              currentView === \'dev_academy\'\n                ? \'text-indigo-600 dark:text-indigo-400 font-bold\'\n                : \'text-zinc-500 dark:text-zinc-400\'\n            }`}\n          >\n            <ShieldCheck className=\"w-5 h-5\" />\n            <span className=\"text-[10px] mt-1 font-semibold\">Dev</span>\n          </button>\n        ) : (\n          <button\n            onClick={onOpenProfile}\n            className=\"min-h-[44px] flex flex-col items-center justify-center text-zinc-500 dark:text-zinc-400\"\n          >\n            <User className=\"w-5 h-5\" />\n            <span className=\"text-[10px] mt-1 font-semibold\">Profile</span>\n          </button>\n        )}\n      </nav>\n    </>\n  );\n};\n"
