              text: "- Change \"indigo\" to \"obsidian velvet\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- Add the sound of crickets in the background meadow`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
