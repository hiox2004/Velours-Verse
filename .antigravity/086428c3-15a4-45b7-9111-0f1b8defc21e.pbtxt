    content: "export type WritingType = \'poem\' | \'story\' | \'prose\' | \'journal\';\n\nexport type WritingStatus = \'draft\' | \'published\' | \'penpals\';\n\nexport interface CommentItem {\n  id: string;\n  authorDisplayName: string;\n  authorPenpalId: string;\n  authorAvatar: string;\n  text: string;\n  createdAt: string;\n}\n\nexport interface WritingPiece {\n  id: string;\n  title: string;\n  content: string;\n  type: WritingType;\n  status: WritingStatus;\n  authorId: string;\n  authorDisplayName: string;\n  authorPenpalId: string;\n  authorEmail: string; // Strictly private: never exposed to other writers; visible only to self & Developer God Mode\n  authorAvatar: string;\n  createdAt: string;\n  updatedAt: string;\n  stars: number;\n  starredByMe: boolean;\n  comments: CommentItem[];\n  moodTags: string[];\n  cardTint: string;\n  wordCount: number;\n  readTimeMinutes: number;\n  synced: boolean;\n}\n\nexport interface UserProfile {\n  id: string;\n  email: string; // Private\n  displayName: string;\n  penpalId: string; // Unique, e.g. \"PEN-9X2M4\"\n  avatar: string;\n  bio: string;\n  favoriteDrink: string;\n  favoriteQuote: string;\n  writingGoalWords: number;\n  penpalIds: string[];\n  role: \'developer\' | \'writer\';\n  createdAt: string;\n}\n\nexport type AppView = \'feed\' | \'compose\' | \'penpals\' | \'widgets\' | \'dev_academy\';\n\nexport type FeedFilterStatus = \'all\' | \'published\' | \'drafts\' | \'penpals\' | \'starred\';\n"
    num_lines: 55
