    end_line: 814
    content: "                    Restore Default Welcome Note\n                  </button>\n                </div>\n              </div>\n\n              {/* Documentation Helper Note */}\n              <div className=\"p-4 rounded-2xl bg-indigo-50 dark:bg-indigo-950/30 border-2 border-indigo-200 dark:border-indigo-800 text-xs text-indigo-950 dark:text-indigo-200 font-bold space-y-1\">\n                <strong className=\"block text-indigo-900 dark:text-indigo-100 font-black\">\n                  \342\234\250 Thematic Rendering Architecture:\n                </strong>\n                The popup dynamically adapts its vectors, fonts, wax seals, and borders to whichever aesthetic the user has selected (Coquette bow, Y2K chrome stars, Matcha leaf, Midnight crescent).\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 2: DEVELOPER ROSTER MANAGEMENT */}\n      {activeTab === \'roster\' && (\n        <div className=\"space-y-6\">\n          <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-4 shadow-xs\">\n            <h3 className=\"font-display-chic text-lg font-bold text-zinc-950 dark:text-white flex items-center gap-2\">\n              <Users className=\"w-5 h-5 text-indigo-600\" />\n              <span>Developer Team Access Management</span>\n            </h3>\n\n            <p className=\"text-xs text-zinc-600 dark:text-zinc-400 font-medium leading-relaxed\">\n              Users who sign in with any of the email addresses listed below will automatically receive Developer God Mode access and academy access. The primary architect <code className=\"font-mono text-pink-600 font-bold bg-pink-50 px-1 py-0.5 rounded\">{SUPER_ADMIN_EMAIL}</code> is permanent.\n            </p>\n\n            {/* Add Developer Form */}\n            <form onSubmit={handleAddDev} className=\"flex gap-2\">\n              <input\n                type=\"email\"\n                value={newDevEmailInput}\n                onChange={e => setNewDevEmailInput(e.target.value)}\n                placeholder=\"developer@gmail.com\"\n                className=\"flex-1 px-4 py-2.5 rounded-xl text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-100 border-2 border-zinc-300 dark:border-zinc-700 outline-none focus:border-indigo-600\"\n              />\n              <button\n                type=\"submit\""
    num_lines: 1019
    num_bytes: 53435
  }
}
