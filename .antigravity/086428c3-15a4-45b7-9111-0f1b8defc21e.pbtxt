              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            This module contains God Mode moderation access and core development documentation. Only authorized developers (such as <code className=\"font-mono text-zinc-950 dark:text-zinc-100 font-bold bg-zinc-100 dark:bg-zinc-800 px-1 py-0.5 rounded\">{SUPER_ADMIN_EMAIL}</code>) can enter."
