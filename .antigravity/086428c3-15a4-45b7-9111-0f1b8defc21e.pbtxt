    content: "      return <MidnightMoonIcon className={className} size={size} />;\n    default:\n      return <CoquetteBowIcon className={className} size={size} />;\n  }\n};\n\n/**\n * Rich Thematic Vector Banners with Gen Z Humanlike Art\n */\nexport const ThemeHeroIllustration: React.FC<{ themeId: AestheticThemeId }> = ({ themeId }) => {\n  if (themeId === \'coquette\') {\n    return (\n      <div className=\"relative w-full h-32 md:h-36 rounded-2xl overflow-hidden bg-gradient-to-r from-[#FFE0EC] via-[#FFF0F6] to-[#FFE0EC] dark:from-rose-950/60 dark:via-pink-900/30 dark:to-rose-950/60 border-3 border-[#BE185D] dark:border-rose-500 p-4 md:p-6 flex items-center justify-between shadow-[4px_4px_0px_0px_#BE185D] dark:shadow-none\">\n        <div className=\"z-10 max-w-md\">\n          <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#BE185D] text-white text-[11px] font-black tracking-wide uppercase shadow-2xs\">\n            <CoquetteBowIcon className=\"w-3.5 h-3.5 text-white\" />\n            <span>Coquette Atelier Edition</span>\n          </div>\n          <h2 className=\"font-display-chic text-xl md:text-2xl font-black text-black dark:text-white mt-1.5 leading-tight\">\n            Poetry of Silk, Ribbons & Melancholy\n          </h2>\n          <p className=\"font-serif-literary text-xs md:text-sm text-zinc-950 dark:text-rose-100 font-bold mt-1 line-clamp-1\">\n            Handwritten letters sealed with vintage wax and pressed rose petals.\n          </p>\n        </div>\n\n        {/* Hand-Drawn Bow Artwork */}\n        <div className=\"hidden sm:flex items-center gap-2 text-[#BE185D] dark:text-rose-400 shrink-0\">\n          <svg viewBox=\"0 0 140 100\" className=\"w-28 md:w-36 h-auto\" fill=\"none\">\n            <path\n              d=\"M70 45 C50 15 15 20 15 45 C15 70 50 65 70 52 C90 65 125 70 125 45 C125 20 90 15 70 45 Z\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.28\"\n              stroke=\"currentColor\"\n              strokeWidth=\"3\"\n            />\n            <ellipse cx=\"70\" cy=\"48\" rx=\"8\" ry=\"10\" fill=\"currentColor\" fillOpacity=\"0.9\" />\n            <path\n              d=\"M66 55 C55 75 40 92 25 98 C35 92 45 92 58 98 C65 80 67 65 68 55\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.4\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.5\"\n            />\n            <path\n              d=\"M74 55 C85 75 100 92 115 98 C105 92 95 92 82 98 C75 80 73 65 72 55\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.4\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.5\"\n            />\n            <circle cx=\"20\" cy=\"20\" r=\"3\" fill=\"currentColor\" />\n            <circle cx=\"120\" cy=\"22\" r=\"2.5\" fill=\"currentColor\" />\n          </svg>\n        </div>\n      </div>\n    );\n  }\n\n  if (themeId === \'y2k\') {\n    return (\n      <div className=\"relative w-full h-32 md:h-36 rounded-2xl overflow-hidden bg-gradient-to-r from-[#E0E7FF] via-[#EEF2FF] to-[#E0E7FF] dark:from-indigo-950/60 dark:via-slate-900/40 dark:to-indigo-950/60 border-3 border-[#4338CA] dark:border-indigo-400 p-4 md:p-6 flex items-center justify-between shadow-[4px_4px_0px_0px_#4338CA] dark:shadow-none\">\n        <div className=\"z-10 max-w-md\">\n          <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#4338CA] text-white text-[11px] font-black tracking-wide uppercase shadow-2xs\">\n            <Y2kStarIcon className=\"w-3.5 h-3.5 text-white\" />\n            <span>Cyber Twilight Edition</span>\n          </div>\n          <h2 className=\"font-display-chic text-xl md:text-2xl font-black text-black dark:text-white mt-1.5 leading-tight\">\n            Chrome Starlight & Neon Digital Verse\n          </h2>\n          <p className=\"font-serif-literary text-xs md:text-sm text-zinc-950 dark:text-indigo-100 font-bold mt-1 line-clamp-1\">\n            Cassette tapes, holographic dreams, and 2 AM subway signals.\n          </p>\n        </div>\n\n        {/* Hand-Drawn Cyber Starlight Grid Artwork */}\n        <div className=\"hidden sm:flex items-center gap-2 text-[#4338CA] dark:text-indigo-300 shrink-0\">\n          <svg viewBox=\"0 0 130 90\" className=\"w-28 md:w-36 h-auto\" fill=\"none\">\n            <path d=\"M65 5 L65 85 M10 45 L120 45\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeDasharray=\"3 3\" opacity=\"0.6\" />\n            <path\n              d=\"M65 15 C68 35 75 42 95 45 C75 48 68 55 65 75 C62 55 55 48 35 45 C55 42 62 35 65 15 Z\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.35\"\n              stroke=\"currentColor\"\n              strokeWidth=\"3\"\n            />\n            <circle cx=\"65\" cy=\"45\" r=\"4.5\" fill=\"currentColor\" />\n            <circle cx=\"105\" cy=\"25\" r=\"3.5\" fill=\"currentColor\" />\n            <circle cx=\"25\" cy=\"65\" r=\"3\" fill=\"currentColor\" />\n            <circle cx=\"95\" cy=\"70\" r=\"2.2\" fill=\"currentColor\" />\n          </svg>\n        </div>\n      </div>\n    );\n  }\n\n  if (themeId === \'matcha\') {\n    return (\n      <div className=\"relative w-full h-32 md:h-36 rounded-2xl overflow-hidden bg-gradient-to-r from-[#DCFCE7] via-[#F0FDF4] to-[#DCFCE7] dark:from-emerald-950/60 dark:via-stone-900/30 dark:to-emerald-950/60 border-3 border-[#15803D] dark:border-emerald-400 p-4 md:p-6 flex items-center justify-between shadow-[4px_4px_0px_0px_#15803D] dark:shadow-none\">\n        <div className=\"z-10 max-w-md\">\n          <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#15803D] text-white text-[11px] font-black tracking-wide uppercase shadow-2xs\">\n            <MatchaLeafIcon className=\"w-3.5 h-3.5 text-white\" />\n            <span>Caf\303\251 Botanica Edition</span>\n          </div>\n          <h2 className=\"font-display-chic text-xl md:text-2xl font-black text-black dark:text-white mt-1.5 leading-tight\">\n            Earthy Whisk, Morning Foam & Mindful Journal\n          </h2>\n          <p className=\"font-serif-literary text-xs md:text-sm text-zinc-950 dark:text-emerald-100 font-bold mt-1 line-clamp-1\">\n            Ceramic cups, steaming oat milk, and quiet botanical reflections.\n          </p>\n        </div>\n\n        {/* Hand-Drawn Ceramic Tea Cup & Leaf Artwork */}\n        <div className=\"hidden sm:flex items-center gap-2 text-[#15803D] dark:text-emerald-300 shrink-0\">\n          <svg viewBox=\"0 0 130 90\" className=\"w-28 md:w-36 h-auto\" fill=\"none\">\n            <path d=\"M50 25 Q53 15 50 5\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" opacity=\"0.8\" />\n            <path d=\"M62 23 Q66 12 62 3\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" opacity=\"0.8\" />\n            <path d=\"M74 25 Q71 14 75 5\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" opacity=\"0.8\" />\n            <path\n              d=\"M38 32 L86 32 C86 58 76 68 62 68 C48 68 38 58 38 32 Z\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.3\"\n              stroke=\"currentColor\"\n              strokeWidth=\"3\"\n            />\n            <path\n              d=\"M86 38 C96 38 98 52 86 54\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.5\"\n              strokeLinecap=\"round\"\n            />\n            <path\n              d=\"M30 70 Q62 76 94 70\"\n              stroke=\"currentColor\"\n              strokeWidth=\"3\"\n              strokeLinecap=\"round\"\n            />\n            <path\n              d=\"M102 42 C115 35 125 40 125 48 C120 54 110 52 102 42 Z\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.5\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2\"\n            />\n          </svg>\n        </div>\n      </div>\n    );\n  }\n\n  // Midnight\n  return (\n    <div className=\"relative w-full h-32 md:h-36 rounded-2xl overflow-hidden bg-gradient-to-r from-[#EDE9FE] via-[#F5F0FF] to-[#EDE9FE] dark:from-purple-950/60 dark:via-zinc-900/40 dark:to-purple-950/60 border-3 border-[#6B21A8] dark:border-purple-400 p-4 md:p-6 flex items-center justify-between shadow-[4px_4px_0px_0px_#6B21A8] dark:shadow-none\">\n      <div className=\"z-10 max-w-md\">\n        <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#6B21A8] text-white text-[11px] font-black tracking-wide uppercase shadow-2xs\">\n          <MidnightMoonIcon className=\"w-3.5 h-3.5 text-white\" />\n          <span>Nocturnal Sanctuary Edition</span>\n        </div>\n        <h2 className=\"font-display-chic text-xl md:text-2xl font-black text-black dark:text-white mt-1.5 leading-tight\">\n          Velvet Shadows, Ink Wells & Starlight\n        </h2>\n        <p className=\"font-serif-literary text-xs md:text-sm text-zinc-950 dark:text-purple-100 font-bold mt-1 line-clamp-1\">\n          The deepest verses are poured when the rest of the world is asleep.\n        </p>\n      </div>\n\n      {/* Hand-Drawn Moon & Constellation Artwork */}\n      <div className=\"hidden sm:flex items-center gap-2 text-[#6B21A8] dark:text-purple-300 shrink-0\">\n        <svg viewBox=\"0 0 130 90\" className=\"w-28 md:w-36 h-auto\" fill=\"none\">\n          <path\n            d=\"M60 12 C40 12 25 27 25 47 C25 67 40 82 60 82 C72 82 82 76 88 66 C80 69 72 68 64 63 C51 54 49 37 59 25 C64 19 72 16 80 16 C74 13 67 12 60 12 Z\"\n            fill=\"currentColor\"\n            fillOpacity=\"0.35\"\n            stroke=\"currentColor\"\n            strokeWidth=\"3\"\n          />\n          <line x1=\"88\" y1=\"28\" x2=\"108\" y2=\"20\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeDasharray=\"2 2\" opacity=\"0.8\" />\n          <line x1=\"108\" y1=\"20\" x2=\"118\" y2=\"42\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeDasharray=\"2 2\" opacity=\"0.8\" />\n          <circle cx=\"88\" cy=\"28\" r=\"3.5\" fill=\"currentColor\" />\n          <circle cx=\"108\" cy=\"20\" r=\"3\" fill=\"currentColor\" />\n          <circle cx=\"118\" cy=\"42\" r=\"3.8\" fill=\"currentColor\" />\n          <circle cx=\"102\" cy=\"68\" r=\"2.5\" fill=\"currentColor\" />\n        </svg>\n      </div>\n    </div>\n  );\n};\n"
