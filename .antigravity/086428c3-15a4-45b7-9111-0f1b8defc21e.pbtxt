            lines {
              text: "    id: \'piece-3\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    title: \'Letters I Kept in the Book of Ferns\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    content: `Dearest Penpal,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "I pressed the silver fern we found by the canal between pages 144 and 145 of the botany compendium. It has turned the faint hue of sun-bleached parchment."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Sometimes I wonder whether words gain weight or lose it as years pass. When we write by hand, ink sinks into the wood pulp. In pixels, words remain suspended like dust motes in sunbeams."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "If you read this, make yourself a cup of genmaicha. The steam smells like toasted rice and good news.`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
