  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { useTheme } from \'../context/ThemeContext\';\nimport { StorageService, SUPER_ADMIN_EMAIL } from \'../services/storage\';\nimport { WritingPiece } from \'../types/writing\';\nimport { ThemeMotifIcon } from \'./ThemeIllustrations\';\nimport {\n  ShieldCheck,\n  Lock,\n  Code2,\n  Database,\n  Users,\n  Eye,\n  Trash2,\n  UserPlus,\n  BookOpen,\n  Copy,\n  Check,\n  Server,\n  Cloud,\n  FileCode,\n  ShieldAlert\n} from \'lucide-react\';\n\ninterface DevAcademyProps {\n  pieces: WritingPiece[];\n  onDeletePiece: (id: string) => void;\n  onOpenPiece: (piece: WritingPiece) => void;\n}\n\nexport const DevAcademy: React.FC<DevAcademyProps> = ({\n  pieces,\n  onDeletePiece,\n  onOpenPiece\n}) => {\n  const { currentUser, isDeveloper, devRoster, addDevEmail, removeDevEmail, loginWithGoogle } = useAuth();\n  const { theme, themeId } = useTheme();\n\n  const [activeTab, setActiveTab] = useState<\'godmode\' | \'roster\' | \'academy\' | \'database\'>(\'godmode\');\n  const [newDevEmailInput, setNewDevEmailInput] = useState(\'\');\n  const [copiedCodeSnippet, setCopiedCodeSnippet] = useState<string | null>(null);\n  const [dbJson, setDbJson] = useState<string>(() => StorageService.exportDataJson());\n  const [importStatus, setImportStatus] = useState<string | null>(null);\n\n  const allUsers = StorageService.getAllUsers();\n\n  const handleCopyCode = (id: string, code: string) => {\n    navigator.clipboard.writeText(code);\n    setCopiedCodeSnippet(id);\n    setTimeout(() => setCopiedCodeSnippet(null), 2000);\n  };\n\n  const handleAddDev = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newDevEmailInput.trim()) return;\n    addDevEmail(newDevEmailInput.trim());\n    setNewDevEmailInput(\'\');\n  };\n\n  // If user is not an authorized developer\n  if (!isDeveloper) {\n    return (\n      <div className=\"max-w-2xl mx-auto px-4 py-16 text-center space-y-6\">\n        <div className=\"w-16 h-16 rounded-full bg-rose-100 dark:bg-rose-950/60 text-rose-700 flex items-center justify-center mx-auto border-2 border-rose-300 dark:border-rose-700\">\n          <Lock className=\"w-8 h-8\" />\n        </div>\n\n        <div className=\"space-y-2\">\n          <h2 className=\"font-display-chic text-2xl font-bold text-zinc-950 dark:text-white\">\n            Developer Console Restricted\n          </h2>\n          <p className=\"text-sm text-zinc-600 dark:text-zinc-400 max-w-md mx-auto font-medium\">\n            This module contains God Mode moderation access and core development documentation. Only authorized developers (such as <code className=\"font-mono text-zinc-950 dark:text-zinc-100 font-bold bg-zinc-100 dark:bg-zinc-800 px-1 py-0.5 rounded\">{SUPER_ADMIN_EMAIL}</code>) can enter.\n          </p>\n        </div>\n\n        <button\n          onClick={() => loginWithGoogle(SUPER_ADMIN_EMAIL, \'Lead Developer\')}\n          className=\"px-5 py-2.5 rounded-xl text-xs font-bold text-white bg-zinc-950 dark:bg-white dark:text-zinc-950 shadow-md hover:opacity-90 active:scale-95 transition-all border border-zinc-800 dark:border-white\"\n        >\n          Authenticate as {SUPER_ADMIN_EMAIL}\n        </button>\n      </div>\n    );\n  }\n\n  // Count metrics for God Mode\n  const totalPieces = pieces.length;\n  const draftPieces = pieces.filter(p => p.status === \'draft\');\n  const publishedPieces = pieces.filter(p => p.status === \'published\');\n\n  const SUPABASE_SCHEMA_SQL = `-- Velours & Verse Production Supabase Schema\n-- 1. Create Profiles table\nCREATE TABLE public.profiles (\n  id UUID REFERENCES auth.users ON DELETE CASCADE PRIMARY KEY,\n  display_name TEXT NOT NULL,\n  penpal_id TEXT UNIQUE NOT NULL,\n  avatar_url TEXT,\n  bio TEXT,\n  favorite_drink TEXT,\n  favorite_quote TEXT,\n  writing_goal_words INTEGER DEFAULT 500,\n  role TEXT DEFAULT \'writer\',\n  created_at TIMESTAMPTZ DEFAULT NOW()\n);\n\n-- 2. Create Writings table\nCREATE TABLE public.writings (\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\n  author_id UUID REFERENCES public.profiles(id) ON DELETE CASCADE,\n  title TEXT NOT NULL,\n  content TEXT NOT NULL,\n  type TEXT CHECK (type IN (\'poem\', \'story\', \'prose\', \'journal\')),\n  status TEXT CHECK (status IN (\'draft\', \'published\', \'penpals\')) DEFAULT \'draft\',\n  mood_tags TEXT[] DEFAULT \'{}\',\n  card_tint TEXT DEFAULT \'default\',\n  stars_count INTEGER DEFAULT 0,\n  word_count INTEGER DEFAULT 0,\n  read_time_minutes INTEGER DEFAULT 1,\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  updated_at TIMESTAMPTZ DEFAULT NOW()\n);\n\n-- 3. Row Level Security (RLS)\nALTER TABLE public.writings ENABLE ROW LEVEL SECURITY;\n\n-- Public can view published writings\nCREATE POLICY \"Public can view published writings\"\n  ON public.writings FOR SELECT\n  USING (status = \'published\' OR auth.uid() = author_id);\n\n-- Authors have complete access to their own writings\nCREATE POLICY \"Authors full access to own writings\"\n  ON public.writings FOR ALL\n  USING (auth.uid() = author_id);`;\n\n  const VERCEL_CONFIG_JSON = `{\n  \"buildCommand\": \"npm run build\",\n  \"outputDirectory\": \"dist\",\n  \"framework\": \"vite\",\n  \"rewrites\": [\n    { \"source\": \"/(.*)\", \"destination\": \"/index.html\" }\n  ],\n  \"headers\": [\n    {\n      \"source\": \"/(.*)\",\n      \"headers\": [\n        { \"key\": \"X-Content-Type-Options\", \"value\": \"nosniff\" },\n        { \"key\": \"X-Frame-Options\", \"value\": \"DENY\" }\n      ]\n    }\n  ]\n}`;\n\n  return (\n    <div className=\"max-w-5xl mx-auto px-4 py-8 space-y-8 animate-in fade-in duration-200\">\n      {/* Dev Header Banner */}\n      <div className=\"p-6 md:p-8 rounded-3xl bg-white dark:bg-zinc-900 border-2 border-indigo-300 dark:border-indigo-800/80 relative overflow-hidden shadow-xs\">\n        <div className=\"relative z-10 space-y-3\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"px-3 py-1 rounded-full bg-indigo-600 text-white text-[11px] font-bold uppercase tracking-wider flex items-center gap-1.5 shadow-2xs\">\n              <ShieldCheck className=\"w-3.5 h-3.5\" />\n              <span>Developer God Mode</span>\n            </span>\n            <span className=\"text-xs text-indigo-900 dark:text-indigo-300 font-mono font-bold\">\n              Authenticated: {currentUser.email}\n            </span>\n          </div>\n\n          <h2 className=\"font-display-chic text-2xl md:text-3xl font-black text-zinc-950 dark:text-white\">\n            Engineering Console & Academy\n          </h2>\n\n          <p className=\"font-serif-literary text-zinc-700 dark:text-zinc-300 text-base max-w-2xl font-normal leading-relaxed\">\n            Complete platform observability, ethical moderation oversight (including user drafts review), developer roster management, and architectural learning guides.\n          </p>\n        </div>\n\n        <div className=\"absolute right-4 bottom-2 text-indigo-100 dark:text-indigo-950 opacity-60 pointer-events-none\" aria-hidden=\"true\">\n          <ThemeMotifIcon themeId={themeId} className=\"w-24 h-24\" />\n        </div>\n      </div>\n\n      {/* Navigation Tabs (God Mode, Dev Roster, Academy, Database) */}\n      <div className=\"flex items-center gap-1 p-1 bg-zinc-200/70 dark:bg-zinc-800/80 rounded-2xl overflow-x-auto text-xs font-bold border border-zinc-300 dark:border-zinc-700\">\n        <button\n          onClick={() => setActiveTab(\'godmode\')}\n          className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'godmode\'\n              ? \'bg-white dark:bg-zinc-700 text-zinc-950 dark:text-white shadow-xs\'\n              : \'text-zinc-700 dark:text-zinc-300 hover:text-zinc-950\'\n          }`}\n        >\n          <Eye className=\"w-3.5 h-3.5 text-pink-600\" />\n          <span>God Mode Moderation ({totalPieces})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'roster\')}\n          className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'roster\'\n              ? \'bg-white dark:bg-zinc-700 text-zinc-950 dark:text-white shadow-xs\'\n              : \'text-zinc-700 dark:text-zinc-300 hover:text-zinc-950\'\n          }`}\n        >\n          <Users className=\"w-3.5 h-3.5 text-indigo-600\" />\n          <span>Developer Roster ({devRoster.length})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'academy\')}\n          className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'academy\'\n              ? \'bg-white dark:bg-zinc-700 text-zinc-950 dark:text-white shadow-xs\'\n              : \'text-zinc-700 dark:text-zinc-300 hover:text-zinc-950\'\n          }`}\n        >\n          <BookOpen className=\"w-3.5 h-3.5 text-emerald-600\" />\n          <span>App Dev Academy & Blueprints</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'database\')}\n          className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'database\'\n              ? \'bg-white dark:bg-zinc-700 text-zinc-950 dark:text-white shadow-xs\'\n              : \'text-zinc-700 dark:text-zinc-300 hover:text-zinc-950\'\n          }`}\n        >\n          <Database className=\"w-3.5 h-3.5 text-amber-600\" />\n          <span>Raw Database Inspector</span>\n        </button>\n      </div>\n\n      {/* TAB 1: GOD MODE & ETHICAL MODERATION */}\n      {activeTab === \'godmode\' && (\n        <div className=\"space-y-6\">\n          {/* Ethical Moderation Policy Banner */}\n          <div className=\"p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border-2 border-amber-300 dark:border-amber-700 text-xs text-amber-950 dark:text-amber-200 flex items-start gap-3\">\n            <ShieldAlert className=\"w-5 h-5 text-amber-600 shrink-0 mt-0.5\" />\n            <div>\n              <strong className=\"block font-bold\">Ethical Moderation Disclosure:</strong>\n              As lead developer, you have God Mode access to all writings across the system\342\200\224including private drafts and penpal-shared pieces. This allows ensuring platform safety, community guidelines compliance, and preventing harmful content. Draft access is strictly confidential for moderation and will be explicitly disclosed in the public Privacy Policy upon commercial launch.\n            </div>\n          </div>\n\n          {/* Quick Metrics Cards */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 text-center\">\n            <div className=\"p-4 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 shadow-2xs\">\n              <span className=\"font-mono text-2xl font-black text-zinc-950 dark:text-white\">{totalPieces}</span>\n              <div className=\"text-[11px] text-zinc-500 font-bold mt-1\">Total Pieces</div>\n            </div>\n            <div className=\"p-4 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 shadow-2xs\">\n              <span className=\"font-mono text-2xl font-black text-amber-600\">{draftPieces.length}</span>\n              <div className=\"text-[11px] text-zinc-500 font-bold mt-1\">Private Drafts</div>\n            </div>\n            <div className=\"p-4 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 shadow-2xs\">\n              <span className=\"font-mono text-2xl font-black text-emerald-600\">{publishedPieces.length}</span>\n              <div className=\"text-[11px] text-zinc-500 font-bold mt-1\">Published Pieces</div>\n            </div>\n            <div className=\"p-4 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 shadow-2xs\">\n              <span className=\"font-mono text-2xl font-black text-pink-600\">{allUsers.length}</span>\n              <div className=\"text-[11px] text-zinc-500 font-bold mt-1\">User Profiles</div>\n            </div>\n          </div>\n\n          {/* All Pieces Stream (Including Drafts) */}\n          <div className=\"space-y-3\">\n            <h3 className=\"font-display-chic text-lg font-bold text-zinc-950 dark:text-white\">\n              System-Wide Writings Stream (Including Drafts)\n            </h3>\n\n            <div className=\"space-y-3\">\n              {pieces.map(p => (\n                <div\n                  key={p.id}\n                  className=\"p-4 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-2xs hover:border-zinc-400 transition-all\"\n                >\n                  <div className=\"space-y-1 min-w-0\">\n                    <div className=\"flex items-center gap-2 flex-wrap text-xs\">\n                      <span className=\"font-bold text-zinc-950 dark:text-white truncate\">\n                        {p.title}\n                      </span>\n                      <span className={`text-[10px] px-2 py-0.5 rounded-full capitalize font-bold ${\n                        p.status === \'draft\' ? \'bg-amber-100 text-amber-800\' : p.status === \'penpals\' ? \'bg-pink-100 text-pink-800\' : \'bg-emerald-100 text-emerald-800\'\n                      }`}>\n                        {p.status}\n                      </span>\n                      <span className=\"text-zinc-400\">\302\267</span>\n                      <span className=\"text-zinc-600 dark:text-zinc-300 font-semibold capitalize\">{p.type}</span>\n                    </div>\n\n                    <div className=\"text-xs text-zinc-600 dark:text-zinc-400 flex items-center gap-2 font-medium\">\n                      <span>Author: <strong className=\"text-zinc-950 dark:text-white font-bold\">{p.authorDisplayName}</strong></span>\n                      <span className=\"text-zinc-500 font-mono font-bold\">({p.authorPenpalId})</span>\n                      <span className=\"text-zinc-400\">\302\267</span>\n                      <span className=\"text-indigo-600 dark:text-indigo-400 font-mono text-[11px] font-bold\">\n                        Gmail: {p.authorEmail}\n                      </span>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-2 shrink-0\">\n                    <button\n                      onClick={() => onOpenPiece(p)}\n                      className=\"px-3 py-1.5 rounded-lg text-xs font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-200\"\n                    >\n                      Read & Inspect\n                    </button>\n                    <button\n                      onClick={() => onDeletePiece(p.id)}\n                      className=\"p-1.5 rounded-lg text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40\"\n                      title=\"Moderate / Delete piece\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* User Accounts Directory Table */}\n          <div className=\"space-y-3 pt-4\">\n            <h3 className=\"font-display-chic text-lg font-bold text-zinc-950 dark:text-white\">\n              User Accounts Directory (God Mode Display)\n            </h3>\n\n            <div className=\"overflow-x-auto rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-2xs\">\n              <table className=\"w-full text-left text-xs\">\n                <thead className=\"bg-zinc-50 dark:bg-zinc-800/80 border-b-2 border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-bold\">\n                  <tr>\n                    <th className=\"p-3\">User</th>\n                    <th className=\"p-3\">Private Gmail (Dev View)</th>\n                    <th className=\"p-3\">Penpal ID</th>\n                    <th className=\"p-3\">Role</th>\n                    <th className=\"p-3\">Pieces Authored</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-zinc-200 dark:divide-zinc-800\">\n                  {allUsers.map(user => {\n                    const count = pieces.filter(p => p.authorId === user.id || p.authorEmail === user.email).length;\n                    return (\n                      <tr key={user.id} className=\"hover:bg-zinc-50 dark:hover:bg-zinc-800/40\">\n                        <td className=\"p-3 flex items-center gap-2\">\n                          <img src={user.avatar} alt=\"\" className=\"w-6 h-6 rounded-full object-cover ring-1 ring-zinc-300\" />\n                          <span className=\"font-bold text-zinc-950 dark:text-white\">{user.displayName}</span>\n                        </td>\n                        <td className=\"p-3 font-mono text-indigo-600 dark:text-indigo-400 font-bold\">{user.email}</td>\n                        <td className=\"p-3 font-mono text-pink-600 font-bold\">{user.penpalId}</td>\n                        <td className=\"p-3\">\n                          <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold ${\n                            user.role === \'developer\' ? \'bg-indigo-100 text-indigo-800\' : \'bg-zinc-100 text-zinc-700\'\n                          }`}>\n                            {user.role}\n                          </span>\n                        </td>\n                        <td className=\"p-3 font-mono font-bold text-zinc-900 dark:text-white\">{count}</td>\n                      </tr>\n                    );\n                  })}\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 2: DEVELOPER ROSTER MANAGEMENT */}\n      {activeTab === \'roster\' && (\n        <div className=\"space-y-6\">\n          <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-4 shadow-xs\">\n            <h3 className=\"font-display-chic text-lg font-bold text-zinc-950 dark:text-white flex items-center gap-2\">\n              <Users className=\"w-5 h-5 text-indigo-600\" />\n              <span>Developer Team Access Management</span>\n            </h3>\n\n            <p className=\"text-xs text-zinc-600 dark:text-zinc-400 font-medium leading-relaxed\">\n              Users who sign in with any of the email addresses listed below will automatically receive Developer God Mode access and academy access. The primary architect <code className=\"font-mono text-pink-600 font-bold bg-pink-50 px-1 py-0.5 rounded\">{SUPER_ADMIN_EMAIL}</code> is permanent.\n            </p>\n\n            {/* Add Developer Form */}\n            <form onSubmit={handleAddDev} className=\"flex gap-2\">\n              <input\n                type=\"email\"\n                value={newDevEmailInput}\n                onChange={e => setNewDevEmailInput(e.target.value)}\n                placeholder=\"developer@gmail.com\"\n                className=\"flex-1 px-4 py-2.5 rounded-xl text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-100 border-2 border-zinc-300 dark:border-zinc-700 outline-none focus:border-indigo-600\"\n              />\n              <button\n                type=\"submit\"\n                disabled={!newDevEmailInput.trim()}\n                className=\"px-4 py-2.5 rounded-xl text-xs font-bold bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 hover:opacity-90 disabled:opacity-40 flex items-center gap-1.5 transition-all\"\n              >\n                <UserPlus className=\"w-3.5 h-3.5\" />\n                <span>Grant Developer Access</span>\n              </button>\n            </form>\n\n            {/* Dev Email List */}\n            <div className=\"space-y-2 pt-2\">\n              {devRoster.map(email => {\n                const isSuper = email.toLowerCase() === SUPER_ADMIN_EMAIL.toLowerCase();\n                return (\n                  <div\n                    key={email}\n                    className=\"p-3.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/80 border-2 border-zinc-200 dark:border-zinc-700 flex items-center justify-between text-xs\"\n                  >\n                    <div className=\"flex items-center gap-2\">\n                      <ShieldCheck className={`w-4 h-4 ${isSuper ? \'text-pink-600\' : \'text-indigo-600\'}`} />\n                      <span className=\"font-mono font-bold text-zinc-950 dark:text-white\">{email}</span>\n                      {isSuper && (\n                        <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-pink-100 text-pink-800 font-bold\">\n                          Super Admin\n                        </span>\n                      )}\n                    </div>\n\n                    {!isSuper && (\n                      <button\n                        onClick={() => removeDevEmail(email)}\n                        className=\"text-xs text-rose-600 hover:text-rose-800 font-bold\"\n                      >\n                        Revoke Access\n                      </button>\n                    )}\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 3: APP DEV ACADEMY & BLUEPRINTS */}\n      {activeTab === \'academy\' && (\n        <div className=\"space-y-6\">\n          {/* Chapter 1: Architecture */}\n          <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-3 shadow-xs\">\n            <div className=\"flex items-center gap-2 text-indigo-600 dark:text-indigo-400 font-bold text-xs\">\n              <Server className=\"w-4 h-4\" />\n              <span>Chapter 1: Single Page App (SPA) Reactive Architecture</span>\n            </div>\n            <h3 className=\"font-display-chic text-xl font-bold text-zinc-950 dark:text-white\">\n              How Velours & Verse Delivers Instant Feel-Good UX\n            </h3>\n            <p className=\"text-xs text-zinc-700 dark:text-zinc-300 font-medium leading-relaxed\">\n              Modern creative writing apps must never make the writer wait for network requests while composing. The app uses an <strong>Optimistic Client-Authoritative State Engine</strong>:\n            </p>\n            <ul className=\"text-xs text-zinc-700 dark:text-zinc-300 font-medium list-disc pl-5 space-y-1\">\n              <li><strong>Zero-Latency Typing:</strong> Words and keystrokes are processed locally in memory with instant live word counting and reading time calculations.</li>\n              <li><strong>Reactive Stores:</strong> React context hooks (<code className=\"font-mono text-pink-600 font-bold\">useTheme</code>, <code className=\"font-mono text-pink-600 font-bold\">useAuth</code>) broadcast changes across cards, modals, and bottom navigation bars without page reloads.</li>\n              <li><strong>Sub-Millisecond Search:</strong> Filtered client-side indexing matches titles, body excerpts, and mood tags with 0ms delay.</li>\n            </ul>\n          </div>\n\n          {/* Chapter 2: Offline-First & Sync */}\n          <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-3 shadow-xs\">\n            <div className=\"flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold text-xs\">\n              <Cloud className=\"w-4 h-4\" />\n              <span>Chapter 2: Offline-First Data Strategy & Sync Queues</span>\n            </div>\n            <h3 className=\"font-display-chic text-xl font-bold text-zinc-950 dark:text-white\">\n              Keeping Writings Safe Anywhere, Without Internet\n            </h3>\n            <p className=\"text-xs text-zinc-700 dark:text-zinc-300 font-medium leading-relaxed\">\n              When a writer is writing on an airplane or subway train with no cellular data, the app uses dual-tier persistence:\n            </p>\n            <div className=\"p-4 rounded-xl bg-zinc-950 text-emerald-400 font-mono text-xs space-y-1\">\n              <div>1. [User Edits Piece] --&gt; Written instantly to LocalStorage + Memory Cache</div>\n              <div>2. [Browser Network Event] --&gt; window.addEventListener(\'online\', ...)</div>\n              <div>3. [Sync Engine] --&gt; Flushes pending changes to cloud database (Supabase/Firebase)</div>\n              <div>4. [Sync Status Pill] --&gt; Reflects \'Offline\', \'Syncing...\', or \'Synced\'</div>\n            </div>\n          </div>\n\n          {/* Chapter 3: Supabase Free Tier Blueprint */}\n          <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-4 shadow-xs\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2 text-amber-600 dark:text-amber-400 font-bold text-xs\">\n                <Database className=\"w-4 h-4\" />\n                <span>Chapter 3: Free Supabase PostgreSQL Blueprint & RLS</span>\n              </div>\n              <button\n                onClick={() => handleCopyCode(\'supabase\', SUPABASE_SCHEMA_SQL)}\n                className=\"px-3 py-1.5 rounded-lg text-xs font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-300 dark:border-zinc-700 flex items-center gap-1.5 hover:bg-zinc-200\"\n              >\n                {copiedCodeSnippet === \'supabase\' ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                <span>{copiedCodeSnippet === \'supabase\' ? \'Copied SQL\' : \'Copy SQL Script\'}</span>\n              </button>\n            </div>\n\n            <p className=\"text-xs text-zinc-700 dark:text-zinc-300 font-medium leading-relaxed\">\n              When launching on Supabase\'s free tier, open the SQL Editor in Supabase and run this script to set up tables and Row Level Security:\n            </p>\n\n            <pre className=\"p-4 rounded-xl bg-zinc-950 text-zinc-100 text-xs font-mono overflow-x-auto max-h-60 leading-relaxed border border-zinc-800\">\n              {SUPABASE_SCHEMA_SQL}\n            </pre>\n          </div>\n\n          {/* Chapter 4: Vercel Free Tier Deployment */}\n          <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-4 shadow-xs\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2 text-purple-600 dark:text-purple-400 font-bold text-xs\">\n                <FileCode className=\"w-4 h-4\" />\n                <span>Chapter 4: Free Vercel Deployment Configuration</span>\n              </div>\n              <button\n                onClick={() => handleCopyCode(\'vercel\', VERCEL_CONFIG_JSON)}\n                className=\"px-3 py-1.5 rounded-lg text-xs font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-300 dark:border-zinc-700 flex items-center gap-1.5 hover:bg-zinc-200\"\n              >\n                {copiedCodeSnippet === \'vercel\' ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                <span>{copiedCodeSnippet === \'vercel\' ? \'Copied Config\' : \'Copy vercel.json\'}</span>\n              </button>\n            </div>\n\n            <p className=\"text-xs text-zinc-700 dark:text-zinc-300 font-medium leading-relaxed\">\n              To deploy on Vercel\'s free tier, connect your repository and add a <code className=\"font-mono text-pink-600 font-bold\">vercel.json</code> file at the root:\n            </p>\n\n            <pre className=\"p-4 rounded-xl bg-zinc-950 text-zinc-100 text-xs font-mono overflow-x-auto max-h-40 leading-relaxed border border-zinc-800\">\n              {VERCEL_CONFIG_JSON}\n            </pre>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 4: RAW DATABASE INSPECTOR */}\n      {activeTab === \'database\' && (\n        <div className=\"space-y-4\">\n          <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-4 shadow-xs\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <h3 className=\"font-display-chic text-lg font-bold text-zinc-950 dark:text-white\">\n                  Local Database Payload & State Backup\n                </h3>\n                <p className=\"text-xs text-zinc-500 font-medium\">\n                  Direct raw JSON representation stored in your browser\'s persistence engine.\n                </p>\n              </div>\n\n              <button\n                onClick={() => handleCopyCode(\'dbJson\', dbJson)}\n                className=\"px-3 py-1.5 rounded-lg text-xs font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-300 dark:border-zinc-700 flex items-center gap-1.5 hover:bg-zinc-200\"\n              >\n                {copiedCodeSnippet === \'dbJson\' ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                <span>Copy JSON</span>\n              </button>\n            </div>\n\n            <textarea\n              value={dbJson}\n              onChange={e => setDbJson(e.target.value)}\n              rows={14}\n              className=\"w-full p-4 rounded-xl bg-zinc-950 text-emerald-400 font-mono text-xs border border-zinc-800 focus:outline-none resize-none leading-relaxed\"\n            />\n\n            <div className=\"flex items-center justify-between\">\n              <button\n                onClick={() => {\n                  const success = StorageService.importDataJson(dbJson);\n                  if (success) {\n                    setImportStatus(\'Successfully restored database state!\');\n                    setTimeout(() => window.location.reload(), 1000);\n                  } else {\n                    setImportStatus(\'Error: Invalid JSON structure.\');\n                  }\n                }}\n                className=\"px-4 py-2 rounded-xl text-xs font-bold bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 hover:opacity-90\"\n              >\n                Apply & Restore Database from JSON\n              </button>\n\n              {importStatus && (\n                <span className=\"text-xs font-bold text-emerald-600 dark:text-emerald-400\">\n                  {importStatus}\n                </span>\n              )}\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/DevAcademy.tsx"
        }
        overwrite: true
      }
    }
