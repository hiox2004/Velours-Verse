 key={t.id}\n                onClick={() => {\n                  setThemeId(t.id);\n                  setShowThemePicker(false);\n                }}\n                className={`w-full px-3.5 py-2.5 text-left text-xs flex items-center justify-between ${\n                  themeId === t.id\n                    ? \'bg-zinc-100 dark:bg-zinc-800 font-bold text-zinc-950 dark:text-white\'\n                    : \'text-zinc-700 dark:text-zinc-300\'\n                }`}\n              >\n                <span className=\"flex items-center gap-2.5\">\n                  <ThemeMotifIcon themeId={t.id} className=\"w-3.5 h-3.5\" />\n                  <span>{t.name}</span>\n                </span>\n                {themeId === t.id && <Check className=\"w-4 h-4 text-zinc-900 dark:text-white\" />}\n              </button>\n            ))}\n          </div>\n        )}\n      </header>\n\n      {/* MOBILE FLOATING COMPOSE ACTION BUTTON (Pinned above bottom bar) */}\n      <div className=\"md:hidden fixed bottom-20 right-4 z-40 no-print\">\n        <button\n          onClick={onOpenNewPiece}\n          className=\"w-14 h-14 rounded-full flex items-center justify-center bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 shadow-2xl border-2 border-white/20 active:scale-95 transition-transform\"\n          aria-label=\"Compose new piece\"\n        >\n          <Plus className=\"w-6 h-6\" />\n        </button>\n      </div>\n\n      {/* MOBILE FIXED BOTTOM TAB BAR (Navigation Anchor, Touch targets >= 44px, High Contrast) */}"
