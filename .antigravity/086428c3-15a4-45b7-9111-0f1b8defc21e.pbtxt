    content: "\n  return (\n    <div className=\"max-w-5xl mx-auto px-4 py-8 space-y-8 animate-in fade-in duration-200\">\n      {/* Dev Header Banner */}\n      <div className=\"p-6 md:p-8 rounded-3xl bg-white dark:bg-zinc-900 border-2 border-indigo-300 dark:border-indigo-800/80 relative overflow-hidden shadow-xs\">\n        <div className=\"relative z-10 space-y-3\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"px-3 py-1 rounded-full bg-indigo-600 text-white text-[11px] font-bold uppercase tracking-wider flex items-center gap-1.5 shadow-2xs\">\n              <ShieldCheck className=\"w-3.5 h-3.5\" />\n              <span>Developer God Mode</span>\n            </span>\n            <span className=\"text-xs text-indigo-900 dark:text-indigo-300 font-mono font-bold\">\n              Authenticated: {currentUser.email}\n            </span>\n          </div>\n\n          <h2 className=\"font-display-chic text-2xl md:text-3xl font-black text-black dark:text-white\">\n            Engineering Console & Academy\n          </h2>\n\n          <p className=\"font-serif-literary text-black dark:text-zinc-200 text-base max-w-2xl font-bold leading-relaxed\">\n            Complete platform observability, ethical moderation oversight (including user drafts review), developer roster management, and architectural learning guides.\n          </p>\n        </div>\n\n        <div className=\"absolute right-4 bottom-2 text-indigo-200 dark:text-indigo-950 opacity-60 pointer-events-none\" aria-hidden=\"true\">\n          <ThemeMotifIcon themeId={themeId} className=\"w-24 h-24\" />\n        </div>\n      </div>\n\n      {/* Navigation Tabs (God Mode, Dev Roster, Academy, Database) */}\n      <div className=\"flex items-center gap-1 p-1 bg-zinc-200 dark:bg-zinc-800 rounded-2xl overflow-x-auto text-xs font-black border-2 border-black/20 dark:border-zinc-700\">\n        <button\n          onClick={() => setActiveTab(\'godmode\')}\n          className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'godmode\'\n              ? \'bg-black text-white dark:bg-zinc-700 dark:text-white shadow-xs\'\n              : \'text-black dark:text-zinc-300 hover:text-black font-bold\'\n          }`}\n        >\n          <Eye className=\"w-3.5 h-3.5 text-pink-500 stroke-[2.5]\" />\n          <span>God Mode Moderation ({totalPieces})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'author_note\')}\n          className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'author_note\'\n              ? \'bg-black text-white dark:bg-zinc-700 dark:text-white shadow-xs\'\n              : \'text-black dark:text-zinc-300 hover:text-black font-bold\'\n          }`}\n        >\n          <Mail className=\"w-3.5 h-3.5 text-pink-500 stroke-[2.5]\" />\n          <span>Note from Author (Dispatcher) \360\237\222\214</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'roster\')}\n          className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'roster\'\n              ? \'bg-black text-white dark:bg-zinc-700 dark:text-white shadow-xs\'\n              : \'text-black dark:text-zinc-300 hover:text-black font-bold\'\n          }`}\n        >\n          <Users className=\"w-3.5 h-3.5 text-indigo-500 stroke-[2.5]\" />\n          <span>Developer Roster ({devRoster.length})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'academy\')}\n          className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'academy\'\n              ? \'bg-black text-white dark:bg-zinc-700 dark:text-white shadow-xs\'\n              : \'text-black dark:text-zinc-300 hover:text-black font-bold\'\n          }`}\n        >\n          <BookOpen className=\"w-3.5 h-3.5 text-emerald-500 stroke-[2.5]\" />\n          <span>App Dev Academy & Blueprints</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'database\')}\n          className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'database\'\n              ? \'bg-black text-white dark:bg-zinc-700 dark:text-white shadow-xs\'\n              : \'text-black dark:text-zinc-300 hover:text-black font-bold\'\n          }`}\n        >\n          <Database className=\"w-3.5 h-3.5 text-amber-500 stroke-[2.5]\" />\n          <span>Raw Database Inspector</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'diagnostics\')}\n          className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'diagnostics\'\n              ? \'bg-black text-white dark:bg-zinc-700 dark:text-white shadow-xs\'\n              : \'text-black dark:text-zinc-300 hover:text-black font-bold\'\n          }`}\n        >\n          <Activity className=\"w-3.5 h-3.5 text-cyan-500 stroke-[2.5]\" />\n          <span>Telemetry & Chaos Sandbox \342\232\241</span>\n        </button>\n      </div>\n\n      {/* TAB 1: GOD MODE & ETHICAL MODERATION */}\n      {activeTab === \'godmode\' && (\n        <div className=\"space-y-6\">\n          {/* Ethical Moderation Policy Banner */}\n          <div className=\"p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border-2 border-amber-400 dark:border-amber-700 text-xs text-amber-950 dark:text-amber-200 flex items-start gap-3 font-bold\">\n            <ShieldAlert className=\"w-5 h-5 text-amber-700 shrink-0 mt-0.5 stroke-[2.5]\" />\n            <div>\n              <strong className=\"block font-black\">Ethical Moderation Disclosure:</strong>\n              As lead developer, you have God Mode access to all writings across the system\342\200\224including private drafts and penpal-shared pieces. This allows ensuring platform safety, community guidelines compliance, and preventing harmful content. Draft access is strictly confidential for moderation and will be explicitly disclosed in the public Privacy Policy upon commercial launch.\n            </div>\n          </div>\n\n          {/* Quick Metrics Cards */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 text-center\">\n            <div className=\"p-4 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-black/20 dark:border-zinc-800 shadow-2xs\">\n              <span className=\"font-mono text-2xl font-black text-black dark:text-white\">{totalPieces}</span>\n              <div className=\"text-[11px] text-black dark:text-zinc-400 font-bold mt-1\">Total Pieces</div>\n            </div>\n            <div className=\"p-4 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-black/20 dark:border-zinc-800 shadow-2xs\">\n              <span className=\"font-mono text-2xl font-black text-amber-700 dark:text-amber-400\">{draftPieces.length}</span>\n              <div className=\"text-[11px] text-black dark:text-zinc-400 font-bold mt-1\">Private Drafts</div>\n            </div>\n            <div className=\"p-4 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-black/20 dark:border-zinc-800 shadow-2xs\">\n              <span className=\"font-mono text-2xl font-black text-emerald-700 dark:text-emerald-400\">{publishedPieces.length}</span>\n              <div className=\"text-[11px] text-black dark:text-zinc-400 font-bold mt-1\">Published Pieces</div>\n            </div>\n            <div className=\"p-4 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 shadow-2xs\">\n              <span className=\"font-mono text-2xl font-black text-pink-600\">{allUsers.length}</span>\n              <div className=\"text-[11px] text-zinc-500 font-bold mt-1\">User Profiles</div>\n            </div>\n          </div>\n\n          {/* All Pieces Stream (Including Drafts) */}\n          <div className=\"space-y-3\">\n            <h3 className=\"font-display-chic text-lg font-bold text-zinc-950 dark:text-white\">\n              System-Wide Writings Stream (Including Drafts)\n            </h3>\n\n            <div className=\"space-y-3\">\n              {pieces.map(p => (\n                <div\n                  key={p.id}\n                  className=\"p-4 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-2xs hover:border-zinc-400 transition-all\"\n                >\n                  <div className=\"space-y-1 min-w-0\">\n                    <div className=\"flex items-center gap-2 flex-wrap text-xs\">\n                      <span className=\"font-bold text-zinc-950 dark:text-white truncate\">\n                        {p.title}\n                      </span>\n                      <span className={`text-[10px] px-2 py-0.5 rounded-full capitalize font-bold ${\n                        p.status === \'draft\' ? \'bg-amber-100 text-amber-800\' : p.status === \'penpals\' ? \'bg-pink-100 text-pink-800\' : \'bg-emerald-100 text-emerald-800\'\n                      }`}>\n                        {p.status}\n                      </span>\n                      <span className=\"text-zinc-400\">\302\267</span>\n                      <span className=\"text-zinc-600 dark:text-zinc-300 font-semibold capitalize\">{p.type}</span>\n                    </div>\n\n                    <div className=\"text-xs text-zinc-600 dark:text-zinc-400 flex items-center gap-2 font-medium\">\n                      <span>Author: <strong className=\"text-zinc-950 dark:text-white font-bold\">{p.authorDisplayName}</strong></span>\n                      <span className=\"text-zinc-500 font-mono font-bold\">({p.authorPenpalId})</span>\n                      <span className=\"text-zinc-400\">\302\267</span>\n                      <span className=\"text-indigo-600 dark:text-indigo-400 font-mono text-[11px] font-bold\">\n                        Gmail: {p.authorEmail}\n                      </span>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-2 shrink-0\">\n                    <button\n                      onClick={() => onOpenPiece(p)}\n                      className=\"px-3 py-1.5 rounded-lg text-xs font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-200\"\n                    >\n                      Read & Inspect\n                    </button>\n                    <button\n                      onClick={() => onDeletePiece(p.id)}\n                      className=\"p-1.5 rounded-lg text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40\"\n                      title=\"Moderate / Delete piece\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* User Accounts Directory Table */}\n          <div className=\"space-y-3 pt-4\">\n            <h3 className=\"font-display-chic text-lg font-bold text-zinc-950 dark:text-white\">\n              User Accounts Directory (God Mode Display)\n            </h3>\n\n            <div className=\"overflow-x-auto rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-2xs\">\n              <table className=\"w-full text-left text-xs\">"
