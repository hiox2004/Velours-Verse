              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        authorDisplayName: \'Julian K.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        authorPenpalId: \'PEN-4B8W2\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        authorAvatar: \'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        text: \'The rhythm in the second stanza is so evocative. I felt the autumn chill immediately.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        createdAt: \'2026-10-12T14:10:00Z\'"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
