\n      style={{\\n        backgroundImage: dynamicBg,\\n        backgroundClip: \'padding-box\',\\n        WebkitBackgroundClip: \'padding-box\',\\n        backdropFilter: \'blur(12px)\',\\n        WebkitBackdropFilter: \'blur(12px)\'\\n      }}\\n      className={`group relative rounded-2xl border-3 p-5 transition-all duration-200 cursor-pointer hover:-translate-y-1 ${cardStyle.border} ${cardStyle.shadow} flex flex-col justify-between overflow-hidden backdrop-blur-md`}\\n    >\\n      {/* Frosted Glass Sheen Overlay */}\\n      <div\\n        className=\\\"absolute inset-0 bg-gradient-to-b from-white/35 dark:from-white/10 to-transparent pointer-events-none rounded-2xl\\\"\\n        style={{ backgroundClip: \'padding-box\', WebkitBackgroundClip: \'padding-box\' }}\\n      />\\n\\n      {/* Top Accent Strip Bar matching active theme */}\\n      <div className={`absolute top-0 left-0 right-0 h-1.5 ${cardStyle.accentBar}`} />\",\"StartLine\":55,\"TargetContent\":\"  return (\\n    <article\\n      onClick={onClick}\\n      className={`group relative rounded-2xl border-3 p-5 transition-all duration-200 cursor-pointer hover:-translate-y-1 ${cardStyle.bg} ${cardStyle.border} ${cardStyle.shadow} flex flex-col justify-between overflow-hidden`}\\n    >\\n      {/* Top Accent Strip Bar matching active theme */}\\n      <div className={`absolute top-0 left-0 right-0 h-1.5 ${cardStyle.accentBar}`} />\",\"TargetFile\":\"/src/components/WritingCard.tsx\",\"toolAction\":\"Updating WritingCard glassmorphism styling\",\"toolSummary\":\"Add dynamic theme gradient with background-clip to WritingCard\"}"
