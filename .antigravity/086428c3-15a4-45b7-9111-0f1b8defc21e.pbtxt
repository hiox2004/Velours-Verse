    content: "              <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n                {filteredPieces.map(piece => (\n                  <WritingCard\n                    key={piece.id}\n                    piece={piece}\n                    onClick={() => setSelectedPieceForReader(piece)}\n                    onToggleStar={e => {\n                      e.stopPropagation();\n                      handleToggleStar(piece.id);\n                    }}\n                    onPrint={e => {\n                      e.stopPropagation();\n                      setPieceToPrint(piece);\n                    }}\n                    onDownload={e => handleDownloadQuick(e, piece)}\n                    onDelete={e => {\n                      e.stopPropagation();\n                      if (window.confirm(`Delete \"${piece.title}\"?`)) {\n                        handleDeletePiece(piece.id);\n                      }\n                    }}\n                  />\n                ))}\n              </div>\n            ) : (\n              /* Empty Search State */\n              <div className=\"p-12 rounded-3xl bg-white dark:bg-zinc-900 border-2 border-zinc-300 dark:border-zinc-700 text-center space-y-4 max-w-lg mx-auto my-8 shadow-sm\">\n                <div className=\"w-12 h-12 rounded-2xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mx-auto border border-zinc-200 dark:border-zinc-700 text-zinc-900 dark:text-white\">\n                  <ThemeMotifIcon themeId={themeId} className=\"w-6 h-6\" />\n                </div>\n                <h3 className=\"font-display-chic text-xl font-bold text-zinc-950 dark:text-white\">\n                  No writings found\n                </h3>\n                <p className=\"font-serif-literary text-xs text-zinc-600 dark:text-zinc-300 max-w-sm mx-auto\">\n                  {searchQuery\n                    ? `No pieces match \"${searchQuery}\". Try different keywords or clear your search.`\n                    : \'There are no pieces in this category yet. Begin your creative log today!\'}\n                </p>\n                <button\n                  onClick={() => {\n                    setPieceToEdit(null);\n                    setIsEditorOpen(true);\n                  }}\n                  className=\"px-4 py-2 rounded-xl text-xs font-bold text-white bg-zinc-950 dark:bg-white dark:text-zinc-950 shadow-sm\"\n                >\n                  Write Your First Piece\n                </button>\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* View: Penpals Circle */}\n        {currentView === \'penpals\' && (\n          <PenpalHub\n            onOpenFeedForPenpals={() => {\n              setStatusFilter(\'penpals\');\n              setCurrentView(\'feed\');\n            }}\n            onOpenProfile={() => setIsProfileModalOpen(true)}\n          />\n        )}\n\n        {/* View: Atmospheric Sound & Daily Habits */}\n        {currentView === \'widgets\' && (\n          <SoundWidget\n            pieces={pieces}\n            onSelectPrompt={promptText => {\n              setPieceToEdit({\n                id: `piece_${Date.now()}`,\n                title: \'Untitled Reflection\',\n                content: `Prompt: ${promptText}\\n\\n`,\n                type: \'prose\',\n                status: \'draft\',\n                authorId: currentUser.id,\n                authorDisplayName: currentUser.displayName,\n                authorPenpalId: currentUser.penpalId,\n                authorEmail: currentUser.email,\n                authorAvatar: currentUser.avatar,\n                createdAt: new Date().toISOString(),\n                updatedAt: new Date().toISOString(),\n                stars: 0,\n                starredByMe: false,\n                comments: [],\n                moodTags: [\'Inspiration\'],\n                cardTint: \'default\',\n                wordCount: 0,\n                readTimeMinutes: 1,\n                synced: true\n              });\n              setIsEditorOpen(true);\n            }}\n          />\n        )}\n\n        {/* View: Developer God Mode & Academy */}\n        {currentView === \'dev_academy\' && (\n          <DevAcademy\n            pieces={pieces}\n            onDeletePiece={handleDeletePiece}\n            onOpenPiece={p => setSelectedPieceForReader(p)}"
    num_lines: 478
    num_bytes: 19332
  }
