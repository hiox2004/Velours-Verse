    start_line: 999
    end_line: 1079
    content: "                    key={email}\n                    className=\"p-3.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/80 border-2 border-zinc-200 dark:border-zinc-700 flex items-center justify-between text-xs\"\n                  >\n                    <div className=\"flex items-center gap-2\">\n                      <ShieldCheck className={`w-4 h-4 ${isSuper ? \'text-pink-600\' : \'text-indigo-600\'}`} />\n                      <span className=\"font-mono font-bold text-zinc-950 dark:text-white\">{email}</span>\n                      {isSuper && (\n                        <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-pink-100 text-pink-800 font-bold\">\n                          Super Admin\n                        </span>\n                      )}\n                    </div>\n\n                    {!isSuper && (\n                      <button\n                        onClick={() => removeDevEmail(email)}\n                        className=\"text-xs text-rose-600 hover:text-rose-800 font-bold\"\n                      >\n                        Revoke Access\n                      </button>\n                    )}\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB 3: APP DEV ACADEMY & BLUEPRINTS */}\n      {activeTab === \'academy\' && (\n        <div className=\"space-y-6\">\n          {/* Chapter 1: Architecture */}\n          <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-3 shadow-xs\">\n            <div className=\"flex items-center gap-2 text-indigo-600 dark:text-indigo-400 font-bold text-xs\">\n              <Server className=\"w-4 h-4\" />\n              <span>Chapter 1: Single Page App (SPA) Reactive Architecture</span>\n            </div>\n            <h3 className=\"font-display-chic text-xl font-bold text-zinc-950 dark:text-white\">\n              How Velours & Verse Delivers Instant Feel-Good UX\n            </h3>\n            <p className=\"text-xs text-zinc-700 dark:text-zinc-300 font-medium leading-relaxed\">\n              Modern creative writing apps must never make the writer wait for network requests while composing. The app uses an <strong>Optimistic Client-Authoritative State Engine</strong>:\n            </p>\n            <ul className=\"text-xs text-zinc-700 dark:text-zinc-300 font-medium list-disc pl-5 space-y-1\">\n              <li><strong>Zero-Latency Typing:</strong> Words and keystrokes are processed locally in memory with instant live word counting and reading time calculations.</li>\n              <li><strong>Reactive Stores:</strong> React context hooks (<code className=\"font-mono text-pink-600 font-bold\">useTheme</code>, <code className=\"font-mono text-pink-600 font-bold\">useAuth</code>) broadcast changes across cards, modals, and bottom navigation bars without page reloads.</li>\n              <li><strong>Sub-Millisecond Search:</strong> Filtered client-side indexing matches titles, body excerpts, and mood tags with 0ms delay.</li>\n            </ul>\n          </div>\n\n          {/* Chapter 2: Offline-First & Sync */}\n          <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-3 shadow-xs\">\n            <div className=\"flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold text-xs\">\n              <Cloud className=\"w-4 h-4\" />\n              <span>Chapter 2: Offline-First Data Strategy & Sync Queues</span>\n            </div>\n            <h3 className=\"font-display-chic text-xl font-bold text-zinc-950 dark:text-white\">\n              Keeping Writings Safe Anywhere, Without Internet\n            </h3>\n            <p className=\"text-xs text-zinc-700 dark:text-zinc-300 font-medium leading-relaxed\">\n              When a writer is writing on an airplane or subway train with no cellular data, the app uses dual-tier persistence:\n            </p>\n            <div className=\"p-4 rounded-xl bg-zinc-950 text-emerald-400 font-mono text-xs space-y-1\">\n              <div>1. [User Edits Piece] --&gt; Written instantly to LocalStorage + Memory Cache</div>\n              <div>2. [Browser Network Event] --&gt; window.addEventListener(\'online\', ...)</div>\n              <div>3. [Sync Engine] --&gt; Flushes pending changes to cloud database (Supabase/Firebase)</div>\n              <div>4. [Sync Status Pill] --&gt; Reflects \'Offline\', \'Syncing...\', or \'Synced\'</div>\n            </div>\n          </div>\n\n          {/* Chapter 3: Supabase Free Tier Blueprint */}\n          <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-4 shadow-xs\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2 text-amber-600 dark:text-amber-400 font-bold text-xs\">\n                <Database className=\"w-4 h-4\" />\n                <span>Chapter 3: Free Supabase PostgreSQL Blueprint & RLS</span>\n              </div>\n              <button\n                onClick={() => handleCopyCode(\'supabase\', SUPABASE_SCHEMA_SQL)}\n                className=\"px-3 py-1.5 rounded-lg text-xs font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-300 dark:border-zinc-700 flex items-center gap-1.5 hover:bg-zinc-200\""
    num_lines: 1399
