            lines {
              text: "  public static savePiece(piece: WritingPiece): WritingPiece[] {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const pieces = this.getPieces();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const existingIndex = pieces.findIndex(p => p.id === piece.id);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    let updated: WritingPiece[];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (existingIndex >= 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      updated = [...pieces];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
