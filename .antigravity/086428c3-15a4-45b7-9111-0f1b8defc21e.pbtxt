      command {
        instruction: "Update Tab 3 (roster), Tab 4 (academy), and Tab 5 (database) card wrappers with writing log glassStyle, border-3, shadow, and accent bars"
        is_edit: true
        file {
          absolute_uri: "file:///src/components/DevAcademy.tsx"
