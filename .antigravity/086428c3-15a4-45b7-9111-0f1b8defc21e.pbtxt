  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useTheme } from \'../context/ThemeContext\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { AppView } from \'../types/writing\';\nimport { AestheticThemeId } from \'../types/theme\';\nimport {\n  Compass,\n  BookOpen,\n  Mail,\n  Sparkles,\n  Code2,\n  Sun,\n  Moon,\n  Plus,\n  Wifi,\n  WifiOff,\n  User,\n  ShieldCheck,\n  Palette\n} from \'lucide-react\';\n\ninterface NavigationProps {\n  currentView: AppView;\n  onSelectView: (view: AppView) => void;\n  onOpenNewPiece: () => void;\n  onOpenProfile: () => void;\n  isOnline: boolean;\n  syncState: \'synced\' | \'syncing\' | \'offline\';\n}\n\nexport const Navigation: React.FC<NavigationProps> = ({\n  currentView,\n  onSelectView,\n  onOpenNewPiece,\n  onOpenProfile,\n  isOnline,\n  syncState\n}) => {\n  const { themeId, setThemeId, mode, toggleMode, theme } = useTheme();\n  const { currentUser, isDeveloper } = useAuth();\n  const [showThemePicker, setShowThemePicker] = useState(false);\n\n  const themeOptions: { id: AestheticThemeId; name: string; symbol: string }[] = [\n    { id: \'coquette\', name: \'Coquette Blush\', symbol: \'\360\237\216\200\' },\n    { id: \'y2k\', name: \'Cyber Y2K\', symbol: \'\342\234\247\' },\n    { id: \'matcha\', name: \'Matcha Latte\', symbol: \'\360\237\214\277\' },\n    { id: \'midnight\', name: \'Midnight Muse\', symbol: \'\360\237\214\231\' }\n  ];\n\n  return (\n    <>\n      {/* DESKTOP / TABLET TOP APP BAR (Conforms to Top Bar Contract) */}\n      <header className=\"hidden md:block sticky top-0 z-40 backdrop-blur-md bg-white/80 dark:bg-zinc-950/80 border-b border-black/5 dark:border-white/10 no-print transition-colors duration-200\">\n        <div className=\"max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-8\">\n          {/* Zone 1: Brand Wordmark */}\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <button\n              onClick={() => onSelectView(\'feed\')}\n              className=\"flex items-center gap-2 text-left group\"\n            >\n              <span className=\"text-xl select-none\" aria-hidden=\"true\">\n                {theme.motifSymbol}\n              </span>\n              <span className=\"font-display-chic text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:opacity-85 transition-opacity whitespace-nowrap\">\n                Velours & Verse\n              </span>\n            </button>\n\n            {/* Offline / Synced Indicator */}\n            <div className=\"hidden lg:flex items-center gap-1.5 px-2.5 py-1 text-xs rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400\">\n              {isOnline ? (\n                <Wifi className=\"w-3 h-3 text-emerald-500\" />\n              ) : (\n                <WifiOff className=\"w-3 h-3 text-amber-500\" />\n              )}\n              <span className=\"font-medium text-[11px]\">\n                {syncState === \'synced\' ? \'Synced\' : syncState === \'syncing\' ? \'Syncing...\' : \'Offline (Cached)\'}\n              </span>\n            </div>\n          </div>\n\n          {/* Zone 2: Navigation Links (Single-Line, 4-5 Items) */}\n          <nav className=\"flex items-center gap-6 text-sm font-medium text-zinc-600 dark:text-zinc-400\">\n            <button\n              onClick={() => onSelectView(\'feed\')}\n              className={`hover:text-zinc-900 dark:hover:text-white transition-colors whitespace-nowrap shrink-0 pb-1 ${\n                currentView === \'feed\'\n                  ? \'text-zinc-900 dark:text-white font-semibold border-b-2 border-current\'\n                  : \'\'\n              }`}\n            >\n              Writing Log\n            </button>\n            <button\n              onClick={() => onSelectView(\'penpals\')}\n              className={`hover:text-zinc-900 dark:hover:text-white transition-colors whitespace-nowrap shrink-0 pb-1 ${\n                currentView === \'penpals\'\n                  ? \'text-zinc-900 dark:text-white font-semibold border-b-2 border-current\'\n                  : \'\'\n              }`}\n            >\n              Penpals Circle\n            </button>\n            <button\n              onClick={() => onSelectView(\'widgets\')}\n              className={`hover:text-zinc-900 dark:hover:text-white transition-colors whitespace-nowrap shrink-0 pb-1 ${\n                currentView === \'widgets\'\n                  ? \'text-zinc-900 dark:text-white font-semibold border-b-2 border-current\'\n                  : \'\'\n              }`}\n            >\n              Sound & Widgets\n            </button>\n            {isDeveloper && (\n              <button\n                onClick={() => onSelectView(\'dev_academy\')}\n                className={`flex items-center gap-1.5 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors whitespace-nowrap shrink-0 pb-1 ${\n                  currentView === \'dev_academy\'\n                    ? \'text-indigo-600 dark:text-indigo-400 font-semibold border-b-2 border-current\'\n                    : \'text-indigo-500/80 dark:text-indigo-400/80\'\n                }`}\n              >\n                <ShieldCheck className=\"w-4 h-4\" />\n                <span>Dev Academy</span>\n              </button>\n            )}\n          </nav>\n\n          {/* Zone 3: Actions (Theme Picker, Dark Toggle, Profile, New Piece) */}\n          <div className=\"flex items-center gap-2.5 shrink-0\">\n            {/* Theme Picker Dropdown */}\n            <div className=\"relative\">\n              <button\n                onClick={() => setShowThemePicker(!showThemePicker)}\n                className=\"w-9 h-9 rounded-xl flex items-center justify-center text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors\"\n                title=\"Change aesthetic theme\"\n                aria-label=\"Change aesthetic theme\"\n              >\n                <Palette className=\"w-4 h-4\" />\n              </button>\n\n              {showThemePicker && (\n                <div className=\"absolute right-0 mt-2 w-48 py-2 bg-white dark:bg-zinc-900 rounded-2xl shadow-xl border border-black/10 dark:border-white/10 z-50 animate-in fade-in zoom-in-95 duration-100\">\n                  <div className=\"px-3 py-1.5 text-[11px] font-semibold text-zinc-400 uppercase tracking-wider\">\n                    Aesthetics\n                  </div>\n                  {themeOptions.map(t => (\n                    <button\n                      key={t.id}\n                      onClick={() => {\n                        setThemeId(t.id);\n                        setShowThemePicker(false);\n                      }}\n                      className={`w-full px-3 py-2 text-left text-xs flex items-center justify-between transition-colors ${\n                        themeId === t.id\n                          ? \'bg-zinc-100 dark:bg-zinc-800 font-semibold text-zinc-900 dark:text-white\'\n                          : \'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-800/50\'\n                      }`}\n                    >\n                      <span className=\"flex items-center gap-2\">\n                        <span>{t.symbol}</span>\n                        <span>{t.name}</span>\n                      </span>\n                      {themeId === t.id && <span className=\"text-[10px] text-pink-500\">Active</span>}\n                    </button>\n                  ))}\n                </div>\n              )}\n            </div>\n\n            {/* Dark / Light Toggle */}\n            <button\n              onClick={toggleMode}\n              className=\"w-9 h-9 rounded-xl flex items-center justify-center text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors\"\n              title={`Switch to ${mode === \'light\' ? \'Dark\' : \'Light\'} Mode`}\n              aria-label=\"Toggle theme mode\"\n            >\n              {mode === \'light\' ? <Moon className=\"w-4 h-4\" /> : <Sun className=\"w-4 h-4\" />}\n            </button>\n\n            {/* Profile Avatar / Login */}\n            <button\n              onClick={onOpenProfile}\n              className=\"flex items-center gap-2 pl-2 pr-2.5 py-1 rounded-xl hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors\"\n              title=\"Open profile & penpal info\"\n            >\n              <img\n                src={currentUser.avatar}\n                alt={currentUser.displayName}\n                className=\"w-7 h-7 rounded-full object-cover ring-1 ring-black/10 dark:ring-white/15\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <span className=\"text-xs font-medium text-zinc-800 dark:text-zinc-200 max-w-[100px] truncate\">\n                {currentUser.displayName}\n              </span>\n            </button>\n\n            {/* Primary Action Button */}\n            <button\n              onClick={onOpenNewPiece}\n              className=\"flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold text-white bg-zinc-900 dark:bg-white dark:text-zinc-900 hover:opacity-90 active:scale-[0.98] transition-all shadow-sm\"\n            >\n              <Plus className=\"w-3.5 h-3.5\" />\n              <span>Write Piece</span>\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* MOBILE TOP BAR (Sticky compact header) */}\n      <header className=\"md:hidden sticky top-0 z-40 backdrop-blur-md bg-white/85 dark:bg-zinc-950/85 border-b border-black/5 dark:border-white/10 px-4 h-14 flex items-center justify-between no-print\">\n        <button\n          onClick={() => onSelectView(\'feed\')}\n          className=\"flex items-center gap-1.5 text-left\"\n        >\n          <span className=\"text-lg\" aria-hidden=\"true\">{theme.motifSymbol}</span>\n          <span className=\"font-display-chic text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100 truncate max-w-[150px]\">\n            Velours & Verse\n          </span>\n        </button>\n\n        <div className=\"flex items-center gap-1\">\n          <button\n            onClick={() => setShowThemePicker(!showThemePicker)}\n            className=\"w-9 h-9 rounded-xl flex items-center justify-center text-zinc-700 dark:text-zinc-300\"\n            aria-label=\"Theme\"\n          >\n            <Palette className=\"w-4 h-4\" />\n          </button>\n\n          <button\n            onClick={toggleMode}\n            className=\"w-9 h-9 rounded-xl flex items-center justify-center text-zinc-700 dark:text-zinc-300\"\n            aria-label=\"Toggle dark mode\"\n          >\n            {mode === \'light\' ? <Moon className=\"w-4 h-4\" /> : <Sun className=\"w-4 h-4\" />}\n          </button>\n\n          <button\n            onClick={onOpenProfile}\n            className=\"w-9 h-9 rounded-xl flex items-center justify-center ml-1\"\n            aria-label=\"Profile\"\n          >\n            <img\n              src={currentUser.avatar}\n              alt={currentUser.displayName}\n              className=\"w-7 h-7 rounded-full object-cover ring-1 ring-black/10 dark:ring-white/15\"\n              referrerPolicy=\"no-referrer\"\n            />\n          </button>\n        </div>\n\n        {/* Mobile Theme Popover */}\n        {showThemePicker && (\n          <div className=\"absolute top-14 right-4 w-48 py-2 bg-white dark:bg-zinc-900 rounded-2xl shadow-2xl border border-black/10 dark:border-white/10 z-50\">\n            <div className=\"px-3 py-1 text-[10px] font-semibold text-zinc-400 uppercase tracking-wider\">\n              Select Aesthetic\n            </div>\n            {themeOptions.map(t => (\n              <button\n                key={t.id}\n                onClick={() => {\n                  setThemeId(t.id);\n                  setShowThemePicker(false);\n                }}\n                className={`w-full px-3 py-2 text-left text-xs flex items-center justify-between ${\n                  themeId === t.id\n                    ? \'bg-zinc-100 dark:bg-zinc-800 font-semibold text-zinc-900 dark:text-white\'\n                    : \'text-zinc-700 dark:text-zinc-300\'\n                }`}\n              >\n                <span className=\"flex items-center gap-2\">\n                  <span>{t.symbol}</span>\n                  <span>{t.name}</span>\n                </span>\n                {themeId === t.id && <span className=\"text-pink-500\">\342\234\223</span>}\n              </button>\n            ))}\n          </div>\n        )}\n      </header>\n\n      {/* MOBILE FLOATING COMPOSE ACTION BUTTON (Pinned above bottom bar) */}\n      <div className=\"md:hidden fixed bottom-20 right-4 z-40 no-print\">\n        <button\n          onClick={onOpenNewPiece}\n          className=\"w-13 h-13 rounded-full flex items-center justify-center bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 shadow-xl active:scale-95 transition-transform\"\n          aria-label=\"Compose new piece\"\n        >\n          <Plus className=\"w-6 h-6\" />\n        </button>\n      </div>\n\n      {/* MOBILE FIXED BOTTOM TAB BAR (Navigation Anchor, Touch targets >= 44px) */}\n      <nav className=\"md:hidden fixed bottom-0 left-0 right-0 z-40 backdrop-blur-md bg-white/95 dark:bg-zinc-950/95 border-t border-black/5 dark:border-white/10 h-16 grid grid-cols-4 items-center pb-safe no-print\">\n        <button\n          onClick={() => onSelectView(\'feed\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n            currentView === \'feed\'\n              ? \'text-zinc-900 dark:text-white font-semibold\'\n              : \'text-zinc-400 dark:text-zinc-500\'\n          }`}\n        >\n          <BookOpen className=\"w-5 h-5\" />\n          <span className=\"text-[10px] mt-1\">Logs</span>\n        </button>\n\n        <button\n          onClick={() => onSelectView(\'penpals\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n            currentView === \'penpals\'\n              ? \'text-zinc-900 dark:text-white font-semibold\'\n              : \'text-zinc-400 dark:text-zinc-500\'\n          }`}\n        >\n          <Mail className=\"w-5 h-5\" />\n          <span className=\"text-[10px] mt-1\">Penpals</span>\n        </button>\n\n        <button\n          onClick={() => onSelectView(\'widgets\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n            currentView === \'widgets\'\n              ? \'text-zinc-900 dark:text-white font-semibold\'\n              : \'text-zinc-400 dark:text-zinc-500\'\n          }`}\n        >\n          <Sparkles className=\"w-5 h-5\" />\n          <span className=\"text-[10px] mt-1\">Studio</span>\n        </button>\n\n        {isDeveloper ? (\n          <button\n            onClick={() => onSelectView(\'dev_academy\')}\n            className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n              currentView === \'dev_academy\'\n                ? \'text-indigo-600 dark:text-indigo-400 font-semibold\'\n                : \'text-zinc-400 dark:text-zinc-500\'\n            }`}\n          >\n            <ShieldCheck className=\"w-5 h-5\" />\n            <span className=\"text-[10px] mt-1\">Dev</span>\n          </button>\n        ) : (\n          <button\n            onClick={onOpenProfile}\n            className=\"min-h-[44px] flex flex-col items-center justify-center text-zinc-400 dark:text-zinc-500\"\n          >\n            <User className=\"w-5 h-5\" />\n            <span className=\"text-[10px] mt-1\">Profile</span>\n          </button>\n        )}\n      </nav>\n    </>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/Navigation.tsx"
        }
        overwrite: true
      }
    }
