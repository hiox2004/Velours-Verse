        instruction: "import React, { useState, useEffect } from \'react\';\nimport { WritingPiece, WritingType, WritingStatus } from \'../types/writing\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { useTheme } from \'../context/ThemeContext\';\nimport { CARD_TINT_OPTIONS } from \'../types/theme\';\nimport { ThemeMotifIcon } from \'./ThemeIllustrations\';\nimport {\n  X,\n  Check,\n  Lock,\n  Globe,\n  Mail,\n  Printer,\n  Sparkles,\n  Tag,\n  Palette\n} from \'lucide-react\';\n\ninterface WritingEditorProps {\n  initialPiece?: WritingPiece | null;\n  isOpen: boolean;\n  onClose: () => void;\n  onSave: (piece: WritingPiece) => void;\n  onPrintPreview?: (piece: WritingPiece) => void;\n}\n\nconst PRESET_MOOD_TAGS = [\n  \'Ethereal\',\n  \'Melancholy\',\n  \'Nostalgic\',\n  \'Midnight Thoughts\',\n  \'Autumn Rain\',\n  \'Matcha Calm\',\n  \'Cyber Dream\',\n  \'Romantic\',\n  \'Hopeful\'\n];\n\nexport const WritingEditor: React.FC<WritingEditorProps> = ({\n  initialPiece,\n  isOpen,\n  onClose,\n  onSave,\n  onPrintPreview\n}) => {\n  const { currentUser } = useAuth();\n  const { themeId } = useTheme();\n\n  const [title, setTitle] = useState(\'\');\n  const [content, setContent] = useState(\'\');\n  const [type, setType] = useState<WritingType>(\'poem\');\n  const [status, setStatus] = useState<WritingStatus>(\'published\');\n  const [cardTint, setCardTint] = useState(\'default\');\n  const [moodTags, setMoodTags] = useState<string[]>([]);\n  const [newTagInput, setNewTagInput] = useState(\'\');\n\n  useEffect(() => {\n    if (initialPiece) {\n      setTitle(initialPiece.title);\n      setContent(initialPiece.content);\n      setType(initialPiece.type);\n      setStatus(initialPiece.status);\n      setCardTint(initialPiece.cardTint || \'default\');\n      setMoodTags(initialPiece.moodTags || []);\n    } else {\n      setTitle(\'\');\n      setContent(\'\');\n      setType(\'poem\');\n      setStatus(\'published\');\n      setCardTint(\'default\');\n      setMoodTags([\'Ethereal\']);\n    }\n  }, [initialPiece, isOpen]);\n\n  if (!isOpen) return null;\n\n  // Live writing metrics\n  const cleanContent = content.trim();\n  const wordCount = cleanContent ? cleanContent.split(/\\s+/).length : 0;\n  const charCount = content.length;\n  const readTimeMinutes = Math.max(1, Math.ceil(wordCount / 180));\n\n  const handleToggleTag = (tag: string) => {\n    if (moodTags.includes(tag)) {\n      setMoodTags(moodTags.filter(t => t !== tag));\n    } else {\n      setMoodTags([...moodTags, tag]);\n    }\n  };\n\n  const handleAddCustomTag = (e: React.FormEvent) => {\n    e.preventDefault();\n    const tag = newTagInput.trim().replace(/^#/, \'\');\n    if (tag && !moodTags.includes(tag)) {\n      setMoodTags([...moodTags, tag]);\n      setNewTagInput(\'\');\n    }\n  };\n\n  const handleSave = () => {\n    if (!title.trim() && !content.trim()) return;\n\n    const piece: WritingPiece = {\n      id: initialPiece ? initialPiece.id : `piece_${Date.now()}`,\n      title: title.trim() || \'Untitled Piece\',\n      content: content,\n      type,\n      status,\n      authorId: initialPiece ? initialPiece.authorId : currentUser.id,\n      authorDisplayName: initialPiece ? initialPiece.authorDisplayName : currentUser.displayName,\n      authorPenpalId: initialPiece ? initialPiece.authorPenpalId : currentUser.penpalId,\n      authorEmail: initialPiece ? initialPiece.authorEmail : currentUser.email,\n      authorAvatar: initialPiece ? initialPiece.authorAvatar : currentUser.avatar,\n      createdAt: initialPiece ? initialPiece.createdAt : new Date().toISOString(),\n      updatedAt: new Date().toISOString(),\n      stars: initialPiece ? initialPiece.stars : 0,\n      starredByMe: initialPiece ? initialPiece.starredByMe : false,\n      comments: initialPiece ? initialPiece.comments : [],\n      moodTags,\n      cardTint,\n      wordCount,\n      readTimeMinutes,\n      synced: true\n    };\n\n    onSave(piece);\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-0 md:p-4 bg-black/70 backdrop-blur-sm animate-in fade-in duration-150 no-print\">\n      <div className=\"w-full h-full md:h-auto md:max-h-[92vh] md:max-w-3xl bg-white dark:bg-zinc-900 md:rounded-3xl shadow-2xl border-2 border-zinc-300 dark:border-zinc-700 flex flex-col overflow-hidden\">\n        {/* Top Header Bar */}\n        <div className=\"px-5 py-4 border-b-2 border-zinc-200 dark:border-zinc-800 flex items-center justify-between gap-4 shrink-0 bg-zinc-50 dark:bg-zinc-900\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-7 h-7 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center border border-zinc-300 dark:border-zinc-700\">\n              <ThemeMotifIcon themeId={themeId} className=\"w-3.5 h-3.5 text-zinc-900 dark:text-white\" />\n            </div>\n            <h2 className=\"font-display-chic text-lg font-bold text-zinc-950 dark:text-white\">\n              {initialPiece ? \'Edit Creative Piece\' : \'Compose New Piece\'}\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            {onPrintPreview && (\n              <button\n                type=\"button\"\n                onClick={() => {\n                  const piece: WritingPiece = {\n                    id: initialPiece ? initialPiece.id : \'preview\',\n                    title: title || \'Untitled Piece\',\n                    content,\n                    type,\n                    status,\n                    authorId: currentUser.id,\n                    authorDisplayName: currentUser.displayName,\n                    authorPenpalId: currentUser.penpalId,\n                    authorEmail: currentUser.email,\n                    authorAvatar: currentUser.avatar,\n                    createdAt: new Date().toISOString(),\n                    updatedAt: new Date().toISOString(),\n                    stars: 0,\n                    starredByMe: false,\n                    comments: [],\n                    moodTags,\n                    cardTint,\n                    wordCount,\n                    readTimeMinutes,\n                    synced: true\n                  };\n                  onPrintPreview(piece);\n                }}\n                className=\"px-3 py-1.5 rounded-xl text-xs font-semibold text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 border border-zinc-300 dark:border-zinc-700 flex items-center gap-1.5 transition-colors\"\n                title=\"Print preview\"\n              >\n                <Printer className=\"w-3.5 h-3.5\" />\n                <span className=\"hidden sm:inline\">Print</span>\n              </button>\n            )}\n\n            <button\n              type=\"button\"\n              onClick={handleSave}\n              className=\"px-4 py-1.5 rounded-xl text-xs font-bold text-white bg-zinc-950 dark:bg-white dark:text-zinc-950 hover:opacity-90 active:scale-[0.98] transition-all flex items-center gap-1.5 shadow-sm border border-zinc-800 dark:border-white\"\n            >\n              <Check className=\"w-3.5 h-3.5 stroke-[3]\" />\n              <span>Save Piece</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"w-8 h-8 rounded-xl flex items-center justify-center text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors\"\n              aria-label=\"Close\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Scrollable Content Area */}\n        <div className=\"flex-1 overflow-y-auto p-5 md:p-8 space-y-6\">\n          {/* Format & Visibility Controls */}\n          <div className=\"flex flex-wrap items-center justify-between gap-3 pb-4 border-b-2 border-zinc-200 dark:border-zinc-800 text-xs\">\n            {/* Format Selector */}\n            <div className=\"flex items-center gap-1 p-1 bg-zinc-100 dark:bg-zinc-800 rounded-xl border border-zinc-300 dark:border-zinc-700\">\n              {([\'poem\', \'story\', \'prose\', \'journal\'] as WritingType[]).map(t => (\n                <button\n                  key={t}\n                  type=\"button\"\n                  onClick={() => setType(t)}\n                  className={`px-3 py-1.5 rounded-lg font-bold transition-all capitalize ${\n                    type === t\n                      ? \'bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 shadow-xs\'\n                      : \'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white\'\n                  }`}\n                >\n                  {t === \'story\' ? \'Short Story\' : t}\n                </button>\n              ))}\n            </div>\n\n            {/* Visibility Selector: Draft, Penpals, Published */}\n            <div className=\"flex items-center gap-1 p-1 bg-zinc-100 dark:bg-zinc-800 rounded-xl border border-zinc-300 dark:border-zinc-700\">\n              <button\n                type=\"button\"\n                onClick={() => setStatus(\'draft\')}\n                className={`px-3 py-1.5 rounded-lg font-bold flex items-center gap-1.5 transition-all ${\n                  status === \'draft\'\n                    ? \'bg-amber-600 text-white shadow-xs\'\n                    : \'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white\'\n                }`}\n              >\n                <Lock className=\"w-3.5 h-3.5\" />\n                <span>Draft</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setStatus(\'penpals\')}\n                className={`px-3 py-1.5 rounded-lg font-bold flex items-center gap-1.5 transition-all ${\n                  status === \'penpals\'\n                    ? \'bg-pink-600 text-white shadow-xs\'\n                    : \'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white\'\n                }`}\n              >\n                <Mail className=\"w-3.5 h-3.5\" />\n                <span>Penpals</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setStatus(\'published\')}\n                className={`px-3 py-1.5 rounded-lg font-bold flex items-center gap-1.5 transition-all ${\n                  status === \'published\'\n                    ? \'bg-emerald-700 text-white shadow-xs\'\n                    : \'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white\'\n                }`}\n              >\n                <Globe className=\"w-3.5 h-3.5\" />\n                <span>Published</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Title Input (High Contrast, Bold) */}\n          <div>\n            <input\n              type=\"text\"\n              value={title}\n              onChange={e => setTitle(e.target.value)}\n              placeholder=\"Title of your poem, story or verse...\"\n              className=\"w-full text-2xl md:text-3xl font-display-chic font-black text-zinc-950 dark:text-white placeholder:text-zinc-400 dark:placeholder:text-zinc-600 bg-transparent border-none outline-none focus:ring-0 px-0\"\n            />\n          </div>\n\n          {/* Main Textarea (High Contrast, Deep Readable Color) */}\n          <div>\n            <textarea\n              value={content}\n              onChange={e => setContent(e.target.value)}\n              placeholder={\n                type === \'poem\'\n                  ? \'Pour your verses here...\\n\\nEvery line break a breath,\\nEvery word a quiet sanctuary.\'\n                  : \'Start writing your narrative or journal reflection...\'\n              }\n              rows={12}\n              className=\"w-full font-serif-literary text-lg md:text-xl text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-600 bg-transparent border-none outline-none focus:ring-0 p-0 resize-none leading-relaxed font-normal\"\n            />\n          </div>\n\n          {/* Aesthetic Customization Controls */}\n          <div className=\"pt-4 border-t-2 border-zinc-200 dark:border-zinc-800 space-y-4\">\n            {/* Card Tint Selection */}\n            <div>\n              <div className=\"flex items-center gap-1.5 text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-2\">\n                <Palette className=\"w-3.5 h-3.5\" />\n                <span>Card Accent Tint</span>\n              </div>\n              <div className=\"flex items-center gap-2 flex-wrap\">\n                {CARD_TINT_OPTIONS.map(opt => (\n                  <button\n                    key={opt.id}\n                    type=\"button\"\n                    onClick={() => setCardTint(opt.id)}\n                    className={`px-3 py-1.5 rounded-xl text-xs flex items-center gap-2 border-2 transition-all font-semibold ${\n                      cardTint === opt.id\n                        ? \'border-zinc-950 dark:border-white shadow-xs scale-105 bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-white\'\n                        : \'border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-zinc-400\'\n                    }`}\n                  >\n                    <span\n                      className=\"w-3 h-3 rounded-full shrink-0 ring-1 ring-black/20\"\n                      style={{ backgroundColor: opt.colorDot }}\n                    />\n                    <span>{opt.name}</span>\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Mood Tags Selection */}\n            <div>\n              <div className=\"flex items-center gap-1.5 text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-2\">\n                <Tag className=\"w-3.5 h-3.5\" />\n                <span>Mood Tags</span>\n              </div>\n              <div className=\"flex items-center gap-1.5 flex-wrap\">\n                {PRESET_MOOD_TAGS.map(t => (\n                  <button\n                    key={t}\n                    type=\"button\"\n                    onClick={() => handleToggleTag(t)}\n                    className={`px-2.5 py-1 rounded-lg text-xs font-bold border transition-colors ${\n                      moodTags.includes(t)\n                        ? \'bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 border-zinc-950 dark:border-white\'\n                        : \'bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border-zinc-300 dark:border-zinc-700 hover:bg-zinc-200\'\n                    }`}\n                  >\n                    #{t}\n                  </button>\n                ))}\n              </div>\n\n              {/* Add Custom Tag */}\n              <form onSubmit={handleAddCustomTag} className=\"flex items-center gap-2 mt-2\">\n                <input\n                  type=\"text\"\n                  value={newTagInput}\n                  onChange={e => setNewTagInput(e.target.value)}\n                  placeholder=\"Add custom tag (e.g. Moonlight)...\"\n                  className=\"px-3 py-1.5 text-xs font-medium rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border border-zinc-300 dark:border-zinc-700 outline-none focus:border-zinc-900\"\n                />\n                <button\n                  type=\"submit\"\n                  disabled={!newTagInput.trim()}\n                  className=\"px-3 py-1.5 rounded-xl text-xs font-bold bg-zinc-200 dark:bg-zinc-700 text-zinc-900 dark:text-zinc-100 hover:bg-zinc-300 disabled:opacity-40\"\n                >\n                  Add Tag\n                </button>\n              </form>\n            </div>\n          </div>\n        </div>\n\n        {/* Bottom Metrics Bar (Live Word Count, Characters, Read Time) */}\n        <div className=\"px-6 py-3 border-t-2 border-zinc-200 dark:border-zinc-800 bg-zinc-100/90 dark:bg-zinc-900/90 flex items-center justify-between text-xs text-zinc-700 dark:text-zinc-300 font-semibold shrink-0\">\n          <div className=\"flex items-center gap-3\">\n            <span className=\"font-mono tabular-nums font-bold text-zinc-950 dark:text-white\">{wordCount}</span> words\n            <span aria-hidden=\"true\" className=\"text-zinc-400\">\302\267</span>\n            <span className=\"font-mono tabular-nums font-bold text-zinc-950 dark:text-white\">{charCount}</span> chars\n            <span aria-hidden=\"true\" className=\"text-zinc-400\">\302\267</span>\n            <span>~{readTimeMinutes} min read</span>\n          </div>\n\n          <div className=\"flex items-center gap-1.5 text-[11px] text-zinc-500 dark:text-zinc-400 font-medium\">\n            <Sparkles className=\"w-3.5 h-3.5 text-pink-600 dark:text-pink-400\" />\n            <span>Auto-saving to offline cache</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/WritingEditor.tsx"
        }
        overwrite: true
      }
    }
