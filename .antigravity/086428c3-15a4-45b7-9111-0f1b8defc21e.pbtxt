  view_file {
    absolute_path_uri: "file:///src/types/theme.ts"
    end_line: 230
    content: "export type AestheticThemeId = \'coquette\' | \'y2k\' | \'matcha\' | \'midnight\';\n\nexport type ThemeMode = \'light\' | \'dark\';\n\nexport interface ThemeCardStyle {\n  bg: string;\n  border: string;\n  accentBar: string;\n  badgeBg: string;\n  badgeText: string;\n  starActiveBg: string;\n  starActiveText: string;\n  shadow: string;\n}\n\nexport interface AestheticTheme {\n  id: AestheticThemeId;\n  name: string;\n  tagline: string;\n  motifName: string;\n  light: {\n    bg: string;\n    surface: string;\n    border: string;\n    borderStrong: string;\n    textPrimary: string;\n    textSecondary: string;\n    accent: string;\n    accentHover: string;\n    card: ThemeCardStyle;\n  };\n  dark: {\n    bg: string;\n    surface: string;\n    border: string;\n    borderStrong: string;\n    textPrimary: string;\n    textSecondary: string;\n    accent: string;\n    accentHover: string;\n    card: ThemeCardStyle;\n  };\n}\n\nexport const THEMES: Record<AestheticThemeId, AestheticTheme> = {\n  coquette: {\n    id: \'coquette\',\n    name: \'Coquette Blush\',\n    tagline: \'Silk ribbons, delicate prose & sweet melancholia\',\n    motifName: \'Silk Bow\',\n    light: {\n      bg: \'#FFF5F8\',\n      surface: \'#FFE4EE\',\n      border: \'#F472B6\',\n      borderStrong: \'#BE185D\',\n      textPrimary: \'#000000\', // Pure Solid Black\n      textSecondary: \'#18181B\', // Deep Black\n      accent: \'#BE185D\', // Deep Rose Berry\n      accentHover: \'#9D174D\',\n      card: {\n        bg: \'bg-[#FFF0F6]\', // Coquette pastel blush shade\n        border: \'border-[#BE185D]\', // Bold rich berry ribbon border\n        accentBar: \'bg-[#BE185D]\',\n        badgeBg: \'bg-[#FCE7F3]\',\n        badgeText: \'text-[#9D174D]\',\n        starActiveBg: \'bg-[#BE185D]\',\n        starActiveText: \'text-white\',\n        shadow: \'shadow-[4px_4px_0px_0px_#BE185D]\'\n      }\n    },\n    dark: {\n      bg: \'#140A0F\',\n      surface: \'#24101B\',\n      border: \'#831843\',\n      borderStrong: \'#FB7185\',\n      textPrimary: \'#FFFFFF\',\n      textSecondary: \'#FCE7F3\',\n      accent: \'#FB7185\',\n      accentHover: \'#F43F5E\',\n      card: {\n        bg: \'bg-[#24101B]\',\n        border: \'border-[#FB7185]\',\n        accentBar: \'bg-[#FB7185]\',\n        badgeBg: \'bg-[#4A1531]\',\n        badgeText: \'text-[#FCE7F3]\',\n        starActiveBg: \'bg-[#FB7185]\',\n        starActiveText: \'text-[#140A0F]\',\n        shadow: \'shadow-[4px_4px_0px_0px_rgba(251,113,133,0.3)]\'\n      }\n    }\n  },\n  y2k: {\n    id: \'y2k\',\n    name: \'Cyber Y2K Stars\',\n    tagline: \'Holographic starlight, chrome vibes & twilight verse\',\n    motifName: \'Chrome Star\',\n    light: {\n      bg: \'#F5F7FF\',\n      surface: \'#EEF2FF\',\n      border: \'#818CF8\',\n      borderStrong: \'#4338CA\',\n      textPrimary: \'#000000\', // Pure Solid Black\n      textSecondary: \'#0F172A\',\n      accent: \'#4338CA\', // Electric Deep Indigo\n      accentHover: \'#3730A3\',\n      card: {\n        bg: \'bg-[#EEF2FF]\', // Cyber icy lilac shade\n        border: \'border-[#4338CA]\', // Bold electric indigo border\n        accentBar: \'bg-[#4338CA]\',\n        badgeBg: \'bg-[#E0E7FF]\',\n        badgeText: \'text-[#3730A3]\',\n        starActiveBg: \'bg-[#4338CA]\',\n        starActiveText: \'text-white\',\n        shadow: \'shadow-[4px_4px_0px_0px_#4338CA]\'\n      }\n    },\n    dark: {\n      bg: \'#080A14\',\n      surface: \'#11172E\',\n      border: \'#314073\',\n      borderStrong: \'#818CF8\',\n      textPrimary: \'#FFFFFF\',\n      textSecondary: \'#E2E8F0\',\n      accent: \'#818CF8\',\n      accentHover: \'#A5B4FC\',\n      card: {\n        bg: \'bg-[#11172E]\',\n        border: \'border-[#818CF8]\',\n        accentBar: \'bg-[#818CF8]\',\n        badgeBg: \'bg-[#1E2958]\',\n        badgeText: \'text-[#E0E7FF]\',\n        starActiveBg: \'bg-[#818CF8]\',\n        starActiveText: \'text-[#080A14]\',\n        shadow: \'shadow-[4px_4px_0px_0px_rgba(129,140,248,0.3)]\'\n      }\n    }\n  },\n  matcha: {\n    id: \'matcha\',\n    name: \'Matcha Latte\',\n    tagline: \'Cozy steam, botanical serenity & mindful journal\',\n    motifName: \'Tea Leaf\',\n    light: {\n      bg: \'#F6FAF4\',\n      surface: \'#EDF7EB\',\n      border: \'#86EFAC\',\n      borderStrong: \'#15803D\',\n      textPrimary: \'#000000\', // Pure Solid Black\n      textSecondary: \'#142614\',\n      accent: \'#15803D\', // Ceremonial Matcha Green\n      accentHover: \'#166534\',\n      card: {\n        bg: \'bg-[#F0FDF4]\', // Creamy matcha foam shade\n        border: \'border-[#15803D]\', // Bold deep matcha green border\n        accentBar: \'bg-[#15803D]\',\n        badgeBg: \'bg-[#DCFCE7]\',\n        badgeText: \'text-[#166534]\',\n        starActiveBg: \'bg-[#15803D]\',\n        starActiveText: \'text-white\',\n        shadow: \'shadow-[4px_4px_0px_0px_#15803D]\'\n      }\n    },\n    dark: {\n      bg: \'#0A120B\',\n      surface: \'#142416\',\n      border: \'#2C4A2F\',\n      borderStrong: \'#4ADE80\',\n      textPrimary: \'#FFFFFF\',\n      textSecondary: \'#F1F9F1\',\n      accent: \'#4ADE80\',\n      accentHover: \'#86EFAC\',\n      card: {\n        bg: \'bg-[#142416]\',\n        border: \'border-[#4ADE80]\',\n        accentBar: \'bg-[#4ADE80]\',\n        badgeBg: \'bg-[#1B3B1F]\',\n        badgeText: \'text-[#DCFCE7]\',\n        starActiveBg: \'bg-[#4ADE80]\',\n        starActiveText: \'text-[#0A120B]\',\n        shadow: \'shadow-[4px_4px_0px_0px_rgba(74,222,128,0.3)]\'\n      }\n    }\n  },\n  midnight: {\n    id: \'midnight\',\n    name: \'Midnight Muse\',\n    tagline: \'Nocturnal thoughts, ink shadows & celestial poetry\',\n    motifName: \'Crescent Moon\',\n    light: {\n      bg: \'#F8F6FC\',\n      surface: \'#F1ECFA\',\n      border: \'#C084FC\',\n      borderStrong: \'#6B21A8\',\n      textPrimary: \'#000000\', // Pure Solid Black\n      textSecondary: \'#101828\',\n      accent: \'#6B21A8\', // Deep Midnight Violet\n      accentHover: \'#581C87\',\n      card: {\n        bg: \'bg-[#F5F0FF]\', // Soft twilight lilac mist\n        border: \'border-[#6B21A8]\', // Bold midnight purple border\n        accentBar: \'bg-[#6B21A8]\',\n        badgeBg: \'bg-[#EDE9FE]\',\n        badgeText: \'text-[#581C87]\',\n        starActiveBg: \'bg-[#6B21A8]\',\n        starActiveText: \'text-white\',\n        shadow: \'shadow-[4px_4px_0px_0px_#6B21A8]\'\n      }\n    },\n    dark: {\n      bg: \'#080910\',\n      surface: \'#121424\',\n      border: \'#2A2E4E\',\n      borderStrong: \'#A78BFA\',\n      textPrimary: \'#FFFFFF\',\n      textSecondary: \'#F8FAFC\',\n      accent: \'#A78BFA\',\n      accentHover: \'#C4B5FD\',\n      card: {\n        bg: \'bg-[#121424]\',\n        border: \'border-[#A78BFA]\',\n        accentBar: \'bg-[#A78BFA]\',\n        badgeBg: \'bg-[#25204D]\',\n        badgeText: \'text-[#ECE9FE]\',\n        starActiveBg: \'bg-[#A78BFA]\',\n        starActiveText: \'text-[#080910]\',\n        shadow: \'shadow-[4px_4px_0px_0px_rgba(167,139,250,0.3)]\'\n      }\n    }\n  }\n};\n"
