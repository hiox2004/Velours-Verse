              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            <p className=\"text-xs text-zinc-700 dark:text-zinc-300 font-medium leading-relaxed\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              Modern creative writing apps must never make the writer wait for network requests while composing. The app uses an <strong>Optimistic Client-Authoritative State Engine</strong>:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            </p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            <ul className=\"text-xs text-zinc-700 dark:text-zinc-300 font-medium list-disc pl-5 space-y-1\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <li><strong>Zero-Latency Typing:</strong> Words and keystrokes are processed locally in memory with instant live word counting and reading time calculations.</li>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <li><strong>Reactive Stores:</strong> React context hooks (<code className=\"font-mono text-pink-600 font-bold\">useTheme</code>, <code className=\"font-mono text-pink-600 font-bold\">useAuth</code>) broadcast changes across cards, modals, and bottom navigation bars without page reloads.</li>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <li><strong>Sub-Millisecond Search:</strong> Filtered client-side indexing matches titles, body excerpts, and mood tags with 0ms delay.</li>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            </ul>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
