    content: "            </span>\n          </div>\n\n          {/* Comments / Reflections Section */}\n          <div className=\"pt-6 space-y-4\">\n            <h3 className=\"font-display-chic text-lg font-black text-black dark:text-white flex items-center gap-2\">\n              <MessageCircle className=\"w-4 h-4\" />\n              <span>Comments & Reflections</span>\n            </h3>\n\n            {/* Comment Input */}\n            <form onSubmit={handleSubmitComment} className=\"flex gap-2\">\n              <input\n                type=\"text\"\n                value={commentText}\n                onChange={e => setCommentText(e.target.value)}\n                placeholder=\"Leave an encouraging reflection or poetic note...\"\n                className=\"flex-1 px-4 py-2.5 rounded-xl text-xs font-bold bg-white dark:bg-zinc-800 text-black dark:text-white border-2 border-black/40 dark:border-zinc-700 outline-none focus:border-black dark:focus:border-white shadow-2xs\"\n              />\n              <button\n                type=\"submit\"\n                disabled={!commentText.trim()}\n                className=\"px-4 py-2.5 rounded-xl text-xs font-black bg-black dark:bg-white text-white dark:text-black disabled:opacity-40 hover:opacity-90 flex items-center gap-1.5 transition-all shadow-xs\"\n              >\n                <Send className=\"w-3.5 h-3.5\" />\n                <span>Post</span>\n              </button>\n            </form>\n\n            {/* Comment List */}\n            <div className=\"space-y-3 pt-2\">\n              {piece.comments && piece.comments.length > 0 ? (\n                piece.comments.map(c => (\n                  <div\n                    key={c.id}\n                    className=\"p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border-2 border-black/20 dark:border-zinc-700/80 space-y-1.5 shadow-2xs\"\n                  >\n                    <div className=\"flex items-center justify-between text-xs\">\n                      <span className=\"font-black text-black dark:text-white\">\n                        {c.authorDisplayName}\n                      </span>\n                      <span className=\"text-[11px] text-black/70 dark:text-zinc-400 font-bold\">\n                        {new Date(c.createdAt).toLocaleDateString()}\n                      </span>\n                    </div>\n                    <p className=\"text-xs text-black dark:text-zinc-200 leading-relaxed font-bold\">\n                      {c.text}\n                    </p>\n                  </div>\n                ))\n              ) : (\n                <p className=\"text-xs text-black/70 dark:text-zinc-400 italic py-2 font-bold\">\n                  No comments yet. Be the first penpal to share a thought!\n                </p>\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 343
    num_bytes: 15677
  }
}
