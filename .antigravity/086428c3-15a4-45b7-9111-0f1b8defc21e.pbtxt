        instruction: "import React, { useState, useEffect } from \'react\';\nimport { WritingPiece } from \'../types/writing\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { useTheme } from \'../context/ThemeContext\';\nimport { soundStudio, AmbientSoundMode } from \'../services/soundStudio\';\nimport { ThemeMotifIcon } from \'./ThemeIllustrations\';\nimport {\n  CloudRain,\n  Coffee,\n  Disc,\n  Volume2,\n  VolumeX,\n  Target,\n  Flame,\n  Sparkles,\n  Shuffle\n} from \'lucide-react\';\n\ninterface SoundWidgetProps {\n  pieces: WritingPiece[];\n  onSelectPrompt: (promptText: string) => void;\n}\n\nconst CREATIVE_PROMPTS = [\n  \"Write about the light filtering through dusty blinds at 5:30 AM.\",\n  \"Describe the exact scent of old paper and rain before a storm arrives.\",\n  \"What if stars only whispered secrets to poets who wrote past midnight?\",\n  \"A letter you penned three years ago that was never dropped into the mail slot.\",\n  \"The quiet rhythm of two teacups touching in an otherwise silent room.\",\n  \"A confession buried beneath four layers of metaphor and velvet ribbons.\"\n];\n\nexport const SoundWidget: React.FC<SoundWidgetProps> = ({\n  pieces,\n  onSelectPrompt\n}) => {\n  const { currentUser, updateProfile } = useAuth();\n  const { themeId } = useTheme();\n\n  const [activeSound, setActiveSound] = useState<AmbientSoundMode>(\'off\');\n  const [volume, setVolume] = useState<number>(0.5);\n  const [promptIdx, setPromptIdx] = useState(0);\n\n  useEffect(() => {\n    setActiveSound(soundStudio.getCurrentMode());\n    setVolume(soundStudio.getVolume());\n\n    return () => {\n      // Keep playing across navigation if desired, or let user control\n    };\n  }, []);\n\n  const handleToggleSound = (mode: AmbientSoundMode) => {\n    if (activeSound === mode) {\n      soundStudio.stop();\n      setActiveSound(\'off\');\n    } else {\n      soundStudio.play(mode);\n      setActiveSound(mode);\n    }\n  };\n\n  const handleVolumeChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const val = parseFloat(e.target.value);\n    setVolume(val);\n    soundStudio.setVolume(val);\n  };\n\n  // Calculate today\'s word count by active user\n  const todayStart = new Date();\n  todayStart.setHours(0, 0, 0, 0);\n\n  const wordsWrittenToday = pieces\n    .filter(p => {\n      const isMe = p.authorId === currentUser.id || p.authorEmail === currentUser.email;\n      const pieceDate = new Date(p.updatedAt || p.createdAt);\n      return isMe && pieceDate >= todayStart;\n    })\n    .reduce((sum, p) => sum + (p.wordCount || 0), 0);\n\n  const goalWords = currentUser.writingGoalWords || 500;\n  const progressPercent = Math.min(100, Math.round((wordsWrittenToday / goalWords) * 100));\n\n  // Writing streak estimation\n  const uniqueDates = new Set(\n    pieces\n      .filter(p => p.authorId === currentUser.id || p.authorEmail === currentUser.email)\n      .map(p => new Date(p.createdAt).toDateString())\n  );\n  const streakCount = Math.max(1, uniqueDates.size);\n\n  const handleNextPrompt = () => {\n    setPromptIdx(prev => (prev + 1) % CREATIVE_PROMPTS.length);\n  };\n\n  return (\n    <div className=\"max-w-4xl mx-auto px-4 py-8 space-y-8 animate-in fade-in duration-200\">\n      {/* Studio Banner */}\n      <div className=\"p-6 md:p-8 rounded-3xl bg-white dark:bg-zinc-900 border-3 border-black/20 dark:border-zinc-800 relative overflow-hidden shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-none\">\n        <div className=\"relative z-10 max-w-xl space-y-2\">\n          <div className=\"flex items-center gap-2 text-xs font-black text-pink-700 dark:text-pink-400\">\n            <Sparkles className=\"w-4 h-4 stroke-[2.5]\" />\n            <span>Atmospheric Studio & Daily Habits</span>\n          </div>\n\n          <h2 className=\"font-display-chic text-2xl md:text-3xl font-black text-black dark:text-white\">\n            Writing Ambiance & Mindfulness\n          </h2>\n\n          <p className=\"font-serif-literary text-black dark:text-zinc-200 text-base leading-relaxed font-bold\">\n            Procedural sound synthesis directly in your browser. Fully offline with zero audio downloads.\n          </p>\n        </div>\n\n        <div className=\"absolute right-4 bottom-2 text-black/10 dark:text-zinc-800 opacity-60 pointer-events-none\" aria-hidden=\"true\">\n          <ThemeMotifIcon themeId={themeId} className=\"w-24 h-24\" />\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        {/* Card 1: Ambient Sound Synthesizer */}\n        <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-3 border-black/20 dark:border-zinc-800 space-y-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-none\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2\">\n              <Disc className=\"w-5 h-5 text-indigo-700 dark:text-indigo-400 stroke-[2.5]\" />\n              <h3 className=\"font-display-chic text-lg font-black text-black dark:text-white\">\n                Ambient Sound Studio\n              </h3>\n            </div>\n\n            <span className=\"text-[11px] px-2.5 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border-2 border-black/20 dark:border-zinc-700 text-black dark:text-zinc-300 font-black\">\n              Web Audio Synth\n            </span>\n          </div>\n\n          {/* Sound Presets */}\n          <div className=\"grid grid-cols-3 gap-3\">\n            {/* Rain */}\n            <button\n              onClick={() => handleToggleSound(\'rain\')}\n              className={`p-4 rounded-xl flex flex-col items-center justify-center gap-2 border-2 transition-all font-black ${\n                activeSound === \'rain\'\n                  ? \'border-black bg-indigo-100 dark:bg-indigo-950/60 text-indigo-950 dark:text-indigo-300 shadow-xs\'\n                  : \'border-black/30 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-black dark:text-zinc-300\'\n              }`}\n            >\n              <CloudRain className=\"w-6 h-6 stroke-[2.5]\" />\n              <span className=\"text-xs\">Gentle Rain</span>\n              {activeSound === \'rain\' && <span className=\"text-[10px] text-indigo-800 dark:text-indigo-400 font-black\">Playing</span>}\n            </button>\n\n            {/* Cafe */}\n            <button\n              onClick={() => handleToggleSound(\'cafe\')}\n              className={`p-4 rounded-xl flex flex-col items-center justify-center gap-2 border-2 transition-all font-black ${\n                activeSound === \'cafe\'\n                  ? \'border-black bg-amber-100 dark:bg-amber-950/60 text-amber-950 dark:text-amber-300 shadow-xs\'\n                  : \'border-black/30 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-black dark:text-zinc-300\'\n              }`}\n            >\n              <Coffee className=\"w-6 h-6 stroke-[2.5]\" />\n              <span className=\"text-xs\">Cozy Caf\303\251</span>\n              {activeSound === \'cafe\' && <span className=\"text-[10px] text-amber-800 dark:text-amber-400 font-black\">Playing</span>}\n            </button>\n\n            {/* Vinyl */}\n            <button\n              onClick={() => handleToggleSound(\'vinyl\')}\n              className={`p-4 rounded-xl flex flex-col items-center justify-center gap-2 border-2 transition-all font-black ${\n                activeSound === \'vinyl\'\n                  ? \'border-black bg-purple-100 dark:bg-purple-950/60 text-purple-950 dark:text-purple-300 shadow-xs\'\n                  : \'border-black/30 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-black dark:text-zinc-300\'\n              }`}\n            >\n              <Disc className=\"w-6 h-6 stroke-[2.5]\" />\n              <span className=\"text-xs\">Lo-Fi Vinyl</span>\n              {activeSound === \'vinyl\' && <span className=\"text-[10px] text-purple-800 dark:text-purple-400 font-black\">Playing</span>}\n            </button>\n          </div>\n\n          {/* Volume Control */}\n          <div className=\"space-y-2 pt-2 border-t-2 border-black/10 dark:border-zinc-800\">\n            <div className=\"flex items-center justify-between text-xs text-black dark:text-zinc-300 font-black\">\n              <span className=\"flex items-center gap-1.5\">\n                {volume > 0 ? <Volume2 className=\"w-4 h-4\" /> : <VolumeX className=\"w-4 h-4\" />}\n                <span>Volume</span>\n              </span>\n              <span className=\"font-mono text-black dark:text-white font-black\">{Math.round(volume * 100)}%</span>\n            </div>\n\n            <input\n              type=\"range\"\n              min=\"0\"\n              max=\"1\"\n              step=\"0.05\"\n              value={volume}\n              onChange={handleVolumeChange}\n              className=\"w-full accent-black dark:accent-pink-500 cursor-pointer\"\n            />\n          </div>\n        </div>\n\n        {/* Card 2: Daily Word Goal & Streak */}\n        <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-3 border-black/20 dark:border-zinc-800 space-y-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-none\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2\">\n              <Target className=\"w-5 h-5 text-pink-700 dark:text-pink-400 stroke-[2.5]\" />\n              <h3 className=\"font-display-chic text-lg font-black text-black dark:text-white\">\n                Daily Word Goal & Streak\n              </h3>\n            </div>\n\n            <div className=\"flex items-center gap-1 px-3 py-1 rounded-full bg-amber-100 dark:bg-amber-950/60 border-2 border-amber-400 dark:border-amber-700 text-amber-950 dark:text-amber-300 text-xs font-black\">\n              <Flame className=\"w-3.5 h-3.5 fill-current\" />\n              <span>{streakCount} Day Streak</span>\n            </div>\n          </div>\n\n          {/* Progress Ring / Bar */}\n          <div className=\"space-y-3\">\n            <div className=\"flex items-end justify-between\">\n              <div>\n                <span className=\"font-mono text-3xl font-black text-black dark:text-white\">\n                  {wordsWrittenToday}\n                </span>\n                <span className=\"text-black/80 dark:text-zinc-400 font-black text-sm ml-1.5\">/ {goalWords} words</span>\n              </div>\n              <span className=\"font-mono text-sm font-black text-pink-700 dark:text-pink-400\">\n                {progressPercent}%\n              </span>\n            </div>\n\n            {/* Clean Progress Track */}\n            <div className=\"h-3.5 w-full bg-zinc-200 dark:bg-zinc-800 rounded-full overflow-hidden border-2 border-black/30 dark:border-zinc-700\">\n              <div\n                className=\"h-full bg-black dark:bg-white rounded-full transition-all duration-500\"\n                style={{ width: `${progressPercent}%` }}\n              />\n            </div>\n\n            <p className=\"text-xs text-black dark:text-zinc-200 font-bold\">\n              {progressPercent >= 100\n                ? \'Target reached! Your creative output is shining today.\'\n                : `${goalWords - wordsWrittenToday} more words to complete today\'s milestone.`}\n            </p>\n          </div>\n\n          {/* Quick Target Changer */}\n          <div className=\"flex items-center justify-between pt-4 border-t-2 border-black/10 dark:border-zinc-800 text-xs text-black dark:text-zinc-300 font-black\">\n            <span>Change goal:</span>\n            <div className=\"flex items-center gap-1.5\">\n              {[300, 500, 1000].map(words => (\n                <button\n                  key={words}\n                  onClick={() => updateProfile({ writingGoalWords: words })}\n                  className={`px-3 py-1 rounded-lg border-2 transition-colors font-black ${\n                    goalWords === words\n                      ? \'bg-black dark:bg-white text-white dark:text-black border-black dark:border-white shadow-2xs\'\n                      : \'bg-white dark:bg-zinc-800 text-black dark:text-zinc-300 border-black/30 dark:border-zinc-700 hover:bg-zinc-100\'\n                  }`}\n                >\n                  {words}w\n                </button>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Writing Prompt Generator Card */}\n      <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-3 border-black/20 dark:border-zinc-800 space-y-4 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-none\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Sparkles className=\"w-4 h-4 text-pink-700 dark:text-pink-400 stroke-[2.5]\" />\n            <h4 className=\"font-display-chic text-base font-black text-black dark:text-white\">\n              Spark of Inspiration\n            </h4>\n          </div>\n\n          <button\n            onClick={handleNextPrompt}\n            className=\"text-xs font-black text-black dark:text-zinc-200 hover:underline flex items-center gap-1.5\"\n          >\n            <Shuffle className=\"w-3.5 h-3.5\" />\n            <span>Next Prompt</span>\n          </button>\n        </div>\n\n        <blockquote className=\"font-serif-literary text-lg md:text-xl text-black dark:text-zinc-100 italic p-4 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border-2 border-black/20 dark:border-zinc-700 font-bold\">\n          \342\200\234{CREATIVE_PROMPTS[promptIdx]}\342\200\235\n        </blockquote>\n\n        <div className=\"flex justify-end\">\n          <button\n            onClick={() => onSelectPrompt(CREATIVE_PROMPTS[promptIdx])}\n            className=\"px-4 py-2 rounded-xl text-xs font-black text-white bg-black dark:bg-white dark:text-black hover:opacity-90 active:scale-95 transition-all shadow-xs border-2 border-black dark:border-white\"\n          >\n            Write from this Prompt\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
