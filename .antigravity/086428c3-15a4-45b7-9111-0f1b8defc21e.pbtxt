 <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-7 h-7 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center border border-zinc-300 dark:border-zinc-700\">\n              <ThemeMotifIcon themeId={themeId} className=\"w-3.5 h-3.5 text-zinc-900 dark:text-white\" />"
