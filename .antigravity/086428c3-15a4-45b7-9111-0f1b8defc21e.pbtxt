            lines {
              text: "   - Generates a unique Penpal ID (e.g. `PEN-3M8K1`). Users customize their Display Name, Avatar, and \"Get to Know Me\" card (favorite writing drink, favorite poets, current project)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Strict privacy: Gmail is never exposed to other users; only the display name and Penpal ID are visible."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Writing Log & Discovery Feed**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Filter by status (**All**, **Published**, **My Drafts**, **Penpal Circle**) and literary format (**Poetry**, **Short Stories**, **Prose**, **Journal**)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Fast sub-millisecond search across titles, moods, and content snippets."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Writing Cards display: Title, author display name, date, word count, read time, star count, comment count, status badge (Draft / Published / Penpals), and custom pastel card tint."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Feel-Good Editor & Ambient Studio**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Rich distraction-free writer with real-time statistics (words, characters, read time)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Visibility switcher: Draft \360\237\224\222, Shared with Penpals \360\237\222\214, or Published \360\237\214\237."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Card styling options: Choose from 6 aesthetic tint colors and mood tags (e.g., Ethereal, Melancholy, Nostalgic, Euphoric, Midnight Thoughts)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Ambient Sound Studio: Native Web Audio synthesizer offering calming Rain, Caf\303\251 murmur, and Lo-Fi Vinyl warmth with zero external audio assets."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Print & Aesthetic Download**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - One-click \"Print Piece\": Formatted using a clean, publication-grade print stylesheet suitable for physical paper or PDF export."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - \"Download Story\": Export as styled Markdown, clean plain text, or formatted reading card."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Penpal Connection Hub**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - \"Add Penpal\" modal using unique Penpal IDs."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - View connected penpals, read pieces shared exclusively with friends, and exchange encouraging comments and stars."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "6. **Developer God Mode & Academy (Restricted to `hiox2004@gmail.com`)**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - **God Mode / Ethical Moderation**: Overview of all pieces across the platform, including drafts, with content flagging and moderation controls."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - **User Accounts Inspector**: Displays user display names, Penpal IDs, joined dates, and activity counts."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - **Dev Academy**: Interactive visual lessons on App Architecture, Offline State Sync, Web Audio synthesis, and Supabase/Vercel production setups."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - **Dev Roster**: Admin tool to grant or revoke developer status for secondary email addresses."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "#### Visual Identity & Theme Engine"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **4 Bespoke Aesthetics** with adaptive Light & Dark modes:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  1. **Coquette Blush** \360\237\216\200: Silk blush pinks, rose gold borders, ribbon motifs, literary serif titles."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  2. **Cyber Y2K Stars** \342\234\247: Twilight indigo, holographic silver starlight, starburst accents, modern geometric sans."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  3. **Matcha Latte** \360\237\214\277: Calming sage and cream tones, organic leaf emblems, warm coffeehouse comfort."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  4. **Midnight Muse** \360\237\214\231: Deep obsidian velvet, ethereal lavender nebulae, celestial moon icons."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Tactile Ergonomics**: Mobile-first bottom navigation, $\\ge 44\\text{px}$ touch targets, smooth card springs, unboxed text metadata with typographic separators."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "### 3. Key Product Decisions & Trade-Offs"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- **Zero External Heavy Audio Files**: Ambient audio (Rain, Lo-Fi static, Caf\303\251 chime) generated cleanly via the native Web Audio API synthesis engine. This guarantees immediate zero-latency playback even while completely offline without broken media URLs."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Dual Storage (Offline-First Engine)**: Local writes update client storage immediately and queue background sync events, delivering 0ms UI lag and full offline resilience."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Role-Based Developer Academy**: Developer documentation is gated on the client and server levels based on verified email permissions (`hiox2004@gmail.com`), ensuring normal users experience a clean writing space while the developer retains access to technical lessons."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Penpal ID System vs Public Email**: Users connect via unique 8-character Penpal IDs. This guarantees privacy and prevents email harvesting while keeping friendship sharing effortless."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Client-Side Print Engine**: Native browser print stylesheet (`@media print`) strips app navigation and formats the poem or story into a book-leaf page with elegant margins and author credits."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Developer God Mode Transparency**: God Mode draft access is explicitly documented in the built-in Privacy & Ethical Moderation section so users know drafts are only reviewable for platform safety guidelines."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
