              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-black/5 dark:border-white/10 space-y-3 shadow-xs\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <div className=\"flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-semibold text-xs\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <Cloud className=\"w-4 h-4\" />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <span>Chapter 2: Offline-First Data Strategy & Sync Queues</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
