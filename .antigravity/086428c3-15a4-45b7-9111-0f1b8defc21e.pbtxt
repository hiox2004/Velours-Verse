\n            {/* 1. Storage Quota Meter */}\n            {(() => {\n              const metrics = getStorageMetrics();\n              return (\n                <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-4 shadow-xs\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2\">\n                      <HardDrive className=\"w-5 h-5 text-indigo-600 stroke-[2.5]\" />\n                      <h4 className=\"font-display-chic text-base font-bold text-zinc-950 dark:text-white\">\n                        Browser Storage Quota\n                      </h4>\n                    </div>\n                    <span className=\"text-xs font-mono font-bold text-zinc-500\">\n                      {metrics.totalKb} KB / 5,120 KB\n                    </span>\n                  </div>\n\n                  {/* Progress Bar */}\n                  <div className=\"space-y-1.5\">\n                    <div className=\"w-full h-3 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 overflow-hidden\">\n                      <div\n                        className=\"h-full bg-gradient-to-r from-cyan-500 to-indigo-600 transition-all duration-300 rounded-full\"\n                        style={{ width: `${Math.max(2, metrics.percentUsed)}%` }}\n                      />\n                    </div>\n                    <div className=\"flex justify-between text-[11px] font-bold text-zinc-500\">\n                      <span>{metrics.percentUsed}% utilized</span>\n                      <span className=\"text-emerald-600 dark:text-emerald-400\">Status: Healthy & Fast</span>\n                    </div>\n                  </div>\n\n                  {/* Key Storage Breakdown Table */}\n                  <div className=\"space-y-1.5 pt-2 border-t border-zinc-200 dark:border-zinc-800\">\n                    <span className=\"text-[11px] font-black uppercase text-zinc-500 tracking-wider block\">\n                      Local Keys Memory Allocation:\n                    </span>\n                    <div className=\"max-h-36 overflow-y-auto space-y-1 pr-1 text-xs font-mono\">\n                      {metrics.keyBreakdown.map((item, idx) => (\n                        <div key={idx} className=\"flex items-center justify-between p-1.5 rounded-lg bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60\">\n                          <span className=\"text-zinc-800 dark:text-zinc-200 font-semibold truncate max-w-[190px]\">\n                            {item.key}\n                          </span>\n                          <span className=\"text-indigo-600 dark:text-indigo-400 font-bold shrink-0\">\n                            {item.kb} KB\n                          </span>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                </div>\n              );\n            })()}\n\n            {/* 2. Chaos Network Simulator */}\n            <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-4 shadow-xs flex flex-col justify-between\">\n              <div className=\"space-y-3\">\n                <div className=\"flex items-center gap-2\">\n                  <Zap className=\"w-5 h-5 text-amber-500 stroke-[2.5]\" />\n                  <h4 className=\"font-display-chic text-base font-bold text-zinc-950 dark:text-white\">\n                    Network State & Chaos Simulator\n                  </h4>\n                </div>\n\n                <p className=\"text-xs text-zinc-600 dark:text-zinc-400 font-medium leading-relaxed\">\n                  Test the applet\'s offline detection, sticky offline indicators, and synchronization transitions in real time without disabling your browser\'s Wi-Fi.\n                </p>\n\n                <div className=\"grid grid-cols-2 gap-3 pt-2\">\n                  <button\n                    onClick={() => handleSimulateNetwork(true)}\n                    className=\"p-3 rounded-xl border-2 border-rose-300 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 text-rose-950 dark:text-rose-200 text-xs font-black flex items-center justify-center gap-2 hover:bg-rose-100 active:scale-95 transition-all shadow-2xs\"\n                  >\n                    <WifiOff className=\"w-4 h-4 stroke-[2.5]\" />\n                    <span>Simulate Offline</span>\n                  </button>\n\n                  <button\n                    onClick={() => handleSimulateNetwork(false)}\n                    className=\"p-3 rounded-xl border-2 border-emerald-300 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-950 dark:text-emerald-200 text-xs font-black flex items-center justify-center gap-2 hover:bg-emerald-100 active:scale-95 transition-all shadow-2xs\"\n                  >\n                    <Wifi className=\"w-4 h-4 stroke-[2.5]\" />\n                    <span>Simulate Online</span>\n                  </button>\n                </div>\n              </div>\n\n              {/* Synthetic Data Generator Action */}\n              <div className=\"pt-4 border-t border-zinc-200 dark:border-zinc-800 space-y-2\">\n                <span className=\"text-[11px] font-black uppercase text-zinc-500 tracking-wider block\">\n                  Batch Creative Seeder:\n                </span>\n                <div className=\"flex gap-2\">\n                  <button\n                    onClick={handleSeedBatchPieces}\n                    className=\"flex-1 px-3 py-2 rounded-xl bg-zinc-950 dark:bg-zinc-100 text-white dark:text-zinc-950 text-xs font-black flex items-center justify-center gap-1.5 hover:opacity-90 active:scale-95 transition-all shadow-2xs\"\n                  >\n                    <Sparkles className=\"w-3.5 h-3.5 text-pink-400\" />\n                    <span>Seed 2 Masterpiece Pieces</span>\n                  </button>\n\n                  <button\n                    onClick={() => {\n                      if (window.confirm(\'Reset all localStorage data to default? This will clear custom pieces.\')) {\n                        StorageService.resetToDefaultData();\n                        window.location.reload();\n                      }\n                    }}\n                    className=\"px-3 py-2 rounded-xl bg-zinc-200 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-200 text-xs font-bold hover:bg-zinc-300 active:scale-95 transition-all\"\n                  >\n                    Reset Factory\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* 3. Theme Accessibility & Contrast Swatch Matrix */}\n          <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-4 shadow-xs\">\n            <h4 className=\"font-display-chic text-base font-bold text-zinc-950 dark:text-white flex items-center gap-2\">\n              <CheckCircle2 className=\"w-4 h-4 text-emerald-600 stroke-[2.5]\" />\n              <span>Theme Token Architecture & WCAG AAA Accessibility Verification</span>\n            </h4>\n\n            <p className=\"text-xs text-zinc-600 dark:text-zinc-400 font-medium\">\n              Every aesthetic theme enforces Solid Jet Black typography (#000000) on light surfaces for maximum legible contrast (ratio \342\211\245 11:1), and clean white (#FFFFFF) in dark modes.\n            </p>\n\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs\">\n              <div className=\"p-3.5 rounded-xl border-2 border-[#BE185D] bg-[#FFF0F5] dark:bg-[#140A0F] text-black dark:text-white space-y-1\">\n                <span className=\"font-black block text-sm\">Coquette Blush</span>\n                <span className=\"text-[11px] font-mono text-[#BE185D] font-black\">#BE185D \302\267 Rose Bow</span>\n                <span className=\"inline-block text-[10px] font-black px-1.5 py-0.5 rounded bg-[#BE185D] text-white\">AAA 13.8:1</span>\n              </div>\n\n              <div className=\"p-3.5 rounded-xl border-2 border-[#4338CA] bg-[#EEF2FF] dark:bg-[#080A14] text-black dark:text-white space-y-1\">\n                <span className=\"font-black block text-sm\">Cyber Y2K</span>\n                <span className=\"text-[11px] font-mono text-[#4338CA] font-black\">#4338CA \302\267 Star</span>\n                <span className=\"inline-block text-[10px] font-black px-1.5 py-0.5 rounded bg-[#4338CA] text-white\">AAA 14.1:1</span>\n              </div>\n\n              <div className=\"p-3.5 rounded-xl border-2 border-[#15803D] bg-[#F0FDF4] dark:bg-[#0A120B] text-black dark:text-white space-y-1\">\n                <span className=\"font-black block text-sm\">Matcha Latte</span>\n                <span className=\"text-[11px] font-mono text-[#15803D] font-black\">#15803D \302\267 Leaf</span>\n                <span className=\"inline-block text-[10px] font-black px-1.5 py-0.5 rounded bg-[#15803D] text-white\">AAA 12.9:1</span>\n              </div>\n\n              <div className=\"p-3.5 rounded-xl border-2 border-[#6B21A8] bg-[#FAF5FF] dark:bg-[#080910] text-black dark:text-white space-y-1\">\n                <span className=\"font-black block text-sm\">Midnight Muse</span>\n                <span className=\"text-[11px] font-mono text-[#6B21A8] font-black\">#6B21A8 \302\267 Moon</span>\n                <span className=\"inline-block text-[10px] font-black px-1.5 py-0.5 rounded bg-[#6B21A8] text-white\">AAA 15.2:1</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}"
