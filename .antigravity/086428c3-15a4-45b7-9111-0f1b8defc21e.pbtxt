  view_file {
    absolute_path_uri: "file:///src/types/writing.ts"
    end_line: 68
    content: "export type WritingType = \'poem\' | \'story\' | \'prose\' | \'journal\';\n\nexport type WritingStatus = \'draft\' | \'published\' | \'penpals\';\n\nexport interface CommentItem {\n  id: string;\n  authorDisplayName: string;\n  authorPenpalId: string;\n  authorAvatar: string;\n  text: string;\n  createdAt: string;\n}\n\nexport interface WritingPiece {\n  id: string;\n  title: string;\n  content: string;\n  type: WritingType;\n  status: WritingStatus;\n  authorId: string;\n  authorDisplayName: string;\n  authorPenpalId: string;\n  authorEmail: string; // Strictly private: never exposed to other writers; visible only to self & Developer God Mode\n  authorAvatar: string;\n  createdAt: string;\n  updatedAt: string;\n  stars: number;\n  starredByMe: boolean;\n  comments: CommentItem[];\n  moodTags: string[];\n  cardTint: string;\n  wordCount: number;\n  readTimeMinutes: number;\n  synced: boolean;\n}\n\nexport interface UserProfile {\n  id: string;\n  email: string; // Private\n  displayName: string;\n  penpalId: string; // Unique, e.g. \"PEN-9X2M4\"\n  avatar: string;\n  bio: string;\n  favoriteDrink: string;\n  favoriteQuote: string;\n  writingGoalWords: number;\n  penpalIds: string[];\n  role: \'developer\' | \'writer\';\n  createdAt: string;\n}\n\nexport interface AuthorNote {\n  id: string;\n  title: string;\n  content: string;\n  authorName: string;\n  authorRole: string;\n  authorAvatar?: string;\n  targetAudience: \'all\' | \'penpals\' | string; // \'all\' or specific penpal ID / user email\n  targetUserName?: string; // Optional custom recipient name e.g. \"Clara Delacroix\" or \"All Writers\"\n  tag?: string; // e.g. \"Creator Dispatch\", \"Behind The Scenes\", \"Midnight Whisper\", \"Platform Note\"\n  createdAt: string;\n  active: boolean;\n}\n\nexport type AppView = \'feed\' | \'compose\' | \'penpals\' | \'widgets\' | \'dev_academy\';\n\nexport type FeedFilterStatus = \'all\' | \'published\' | \'drafts\' | \'penpals\' | \'starred\';\n"
    num_lines: 69
    num_bytes: 1850
  }
}
