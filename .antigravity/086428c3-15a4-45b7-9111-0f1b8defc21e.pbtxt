  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { AestheticThemeId } from \'../types/theme\';\n\ninterface IconProps {\n  className?: string;\n  size?: number;\n}\n\n/**\n * Handcrafted Coquette Silk Bow Vector Icon (Replaces \360\237\216\200 emoji)\n */\nexport const CoquetteBowIcon: React.FC<IconProps> = ({ className = \'w-5 h-5\', size }) => (\n  <svg\n    viewBox=\"0 0 24 24\"\n    fill=\"currentColor\"\n    className={className}\n    width={size}\n    height={size}\n    aria-hidden=\"true\"\n  >\n    {/* Central Knot */}\n    <ellipse cx=\"12\" cy=\"10\" rx=\"2\" ry=\"2.2\" />\n    {/* Left Loop */}\n    <path\n      d=\"M10.2 9.2 C7 5.5 3 6 3 9 C3 12 7.5 12.5 10.2 10.8 Z\"\n      fillOpacity=\"0.88\"\n    />\n    <path\n      d=\"M10 9.8 C7.5 7.8 5 8 5 9.5 C5 11 7.8 11.2 10 10.2\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      strokeWidth=\"0.8\"\n      strokeOpacity=\"0.4\"\n    />\n    {/* Right Loop */}\n    <path\n      d=\"M13.8 9.2 C17 5.5 21 6 21 9 C21 12 16.5 12.5 13.8 10.8 Z\"\n      fillOpacity=\"0.88\"\n    />\n    <path\n      d=\"M14 9.8 C16.5 7.8 19 8 19 9.5 C19 11 16.2 11.2 14 10.2\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      strokeWidth=\"0.8\"\n      strokeOpacity=\"0.4\"\n    />\n    {/* Left Trailing Ribbon */}\n    <path\n      d=\"M11 12 C9.5 15 7.5 18 5.5 21 C7 20 8.5 20.2 10.5 21.5 C11.5 18 12 15 12.2 12.5 Z\"\n      fillOpacity=\"0.75\"\n    />\n    {/* Right Trailing Ribbon */}\n    <path\n      d=\"M13 12 C14.5 15 16.5 18 18.5 21 C17 20 15.5 20.2 13.5 21.5 C12.5 18 12 15 11.8 12.5 Z\"\n      fillOpacity=\"0.75\"\n    />\n  </svg>\n);\n\n/**\n * Handcrafted Cyber Y2K Chrome Starburst Icon (Replaces \342\234\247 emoji)\n */\nexport const Y2kStarIcon: React.FC<IconProps> = ({ className = \'w-5 h-5\', size }) => (\n  <svg\n    viewBox=\"0 0 24 24\"\n    fill=\"currentColor\"\n    className={className}\n    width={size}\n    height={size}\n    aria-hidden=\"true\"\n  >\n    {/* 4-Point Deep Starburst */}\n    <path d=\"M12 1 C12.8 7.5 16.5 11.2 23 12 C16.5 12.8 12.8 16.5 12 23 C11.2 16.5 7.5 12.8 1 12 C7.5 11.2 11.2 7.5 12 1 Z\" />\n    {/* Subtle Diagonal Spark Mini-Point */}\n    <circle cx=\"17.5\" cy=\"6.5\" r=\"1.2\" fillOpacity=\"0.7\" />\n    <circle cx=\"6.5\" cy=\"17.5\" r=\"1\" fillOpacity=\"0.7\" />\n  </svg>\n);\n\n/**\n * Handcrafted Botanical Matcha Tea Leaf Icon (Replaces \360\237\214\277 emoji)\n */\nexport const MatchaLeafIcon: React.FC<IconProps> = ({ className = \'w-5 h-5\', size }) => (\n  <svg\n    viewBox=\"0 0 24 24\"\n    fill=\"currentColor\"\n    className={className}\n    width={size}\n    height={size}\n    aria-hidden=\"true\"\n  >\n    {/* Primary Tea Leaf */}\n    <path\n      d=\"M20.5 3.5 C14.5 4 8.5 8 6 13.5 C4.5 17 5 20 5 20.5 C5.5 20.5 8.5 21 12 19.5 C17.5 17 21.5 11 22 5 C22 4 21.5 3.5 20.5 3.5 Z\"\n      fillOpacity=\"0.9\"\n    />\n    {/* Leaf Stem & Vein */}\n    <path\n      d=\"M4 22 C5.5 19 9 14.5 15 10.5\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      strokeWidth=\"1.5\"\n      strokeLinecap=\"round\"\n      strokeOpacity=\"0.4\"\n    />\n    {/* Secondary Sprout Leaf */}\n    <path\n      d=\"M3 13 C4 10 7 8 10 9 C9 12 6.5 14 3 13 Z\"\n      fillOpacity=\"0.6\"\n    />\n  </svg>\n);\n\n/**\n * Handcrafted Celestial Crescent Moon Icon (Replaces \360\237\214\231 emoji)\n */\nexport const MidnightMoonIcon: React.FC<IconProps> = ({ className = \'w-5 h-5\', size }) => (\n  <svg\n    viewBox=\"0 0 24 24\"\n    fill=\"currentColor\"\n    className={className}\n    width={size}\n    height={size}\n    aria-hidden=\"true\"\n  >\n    {/* Crescent with Smooth Silhouette */}\n    <path d=\"M12.3 2 C6.8 2 2.3 6.5 2.3 12 C2.3 17.5 6.8 22 12.3 22 C16.5 22 20.1 19.4 21.5 15.6 C19.2 16.5 16.7 16.5 14.3 15.7 C9.8 14.1 7.2 9.3 8.8 4.8 C9.4 3.2 10.5 2 12.3 2 Z\" />\n    {/* Orbiting Starlight Speck */}\n    <circle cx=\"18\" cy=\"7\" r=\"1.3\" />\n    <circle cx=\"21\" cy=\"10\" r=\"0.9\" fillOpacity=\"0.7\" />\n  </svg>\n);\n\n/**\n * Dynamic Motif Icon Resolver\n */\nexport const ThemeMotifIcon: React.FC<{ themeId: AestheticThemeId; className?: string; size?: number }> = ({\n  themeId,\n  className = \'w-5 h-5\',\n  size\n}) => {\n  switch (themeId) {\n    case \'coquette\':\n      return <CoquetteBowIcon className={className} size={size} />;\n    case \'y2k\':\n      return <Y2kStarIcon className={className} size={size} />;\n    case \'matcha\':\n      return <MatchaLeafIcon className={className} size={size} />;\n    case \'midnight\':\n      return <MidnightMoonIcon className={className} size={size} />;\n    default:\n      return <CoquetteBowIcon className={className} size={size} />;\n  }\n};\n\n/**\n * Rich Thematic Vector Banners with Gen Z Humanlike Art\n */\nexport const ThemeHeroIllustration: React.FC<{ themeId: AestheticThemeId }> = ({ themeId }) => {\n  if (themeId === \'coquette\') {\n    return (\n      <div className=\"relative w-full h-32 md:h-36 rounded-2xl overflow-hidden bg-gradient-to-r from-rose-100 via-pink-50 to-rose-100 dark:from-rose-950/40 dark:via-pink-900/20 dark:to-rose-950/40 border-2 border-rose-200/80 dark:border-rose-800/60 p-4 md:p-6 flex items-center justify-between\">\n        <div className=\"z-10 max-w-md\">\n          <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-rose-200/80 dark:bg-rose-900/60 text-rose-900 dark:text-rose-200 text-[11px] font-bold tracking-wide uppercase\">\n            <CoquetteBowIcon className=\"w-3.5 h-3.5 text-rose-600 dark:text-rose-300\" />\n            <span>Coquette Atelier Edition</span>\n          </div>\n          <h2 className=\"font-display-chic text-xl md:text-2xl font-black text-rose-950 dark:text-white mt-1.5 leading-tight\">\n            Poetry of Silk, Ribbons & Melancholy\n          </h2>\n          <p className=\"font-serif-literary text-xs md:text-sm text-rose-800 dark:text-rose-200/80 mt-1 line-clamp-1\">\n            Handwritten letters sealed with vintage wax and pressed rose petals.\n          </p>\n        </div>\n\n        {/* Hand-Drawn Bow Artwork */}\n        <div className=\"hidden sm:flex items-center gap-2 opacity-90 text-rose-400 dark:text-rose-500 shrink-0\">\n          <svg viewBox=\"0 0 140 100\" className=\"w-28 md:w-36 h-auto\" fill=\"none\">\n            <path\n              d=\"M70 45 C50 15 15 20 15 45 C15 70 50 65 70 52 C90 65 125 70 125 45 C125 20 90 15 70 45 Z\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.25\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.5\"\n            />\n            <ellipse cx=\"70\" cy=\"48\" rx=\"8\" ry=\"10\" fill=\"currentColor\" fillOpacity=\"0.7\" />\n            <path\n              d=\"M66 55 C55 75 40 92 25 98 C35 92 45 92 58 98 C65 80 67 65 68 55\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.35\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2\"\n            />\n            <path\n              d=\"M74 55 C85 75 100 92 115 98 C105 92 95 92 82 98 C75 80 73 65 72 55\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.35\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2\"\n            />\n            <circle cx=\"20\" cy=\"20\" r=\"3\" fill=\"currentColor\" fillOpacity=\"0.5\" />\n            <circle cx=\"120\" cy=\"22\" r=\"2.5\" fill=\"currentColor\" fillOpacity=\"0.5\" />\n          </svg>\n        </div>\n      </div>\n    );\n  }\n\n  if (themeId === \'y2k\') {\n    return (\n      <div className=\"relative w-full h-32 md:h-36 rounded-2xl overflow-hidden bg-gradient-to-r from-indigo-100 via-sky-50 to-indigo-100 dark:from-indigo-950/50 dark:via-slate-900/40 dark:to-indigo-950/50 border-2 border-indigo-200/80 dark:border-indigo-800/60 p-4 md:p-6 flex items-center justify-between\">\n        <div className=\"z-10 max-w-md\">\n          <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-indigo-200/80 dark:bg-indigo-900/60 text-indigo-950 dark:text-indigo-200 text-[11px] font-bold tracking-wide uppercase\">\n            <Y2kStarIcon className=\"w-3.5 h-3.5 text-indigo-600 dark:text-indigo-300\" />\n            <span>Cyber Twilight Edition</span>\n          </div>\n          <h2 className=\"font-display-chic text-xl md:text-2xl font-black text-indigo-950 dark:text-white mt-1.5 leading-tight\">\n            Chrome Starlight & Neon Digital Verse\n          </h2>\n          <p className=\"font-serif-literary text-xs md:text-sm text-indigo-800 dark:text-indigo-200/80 mt-1 line-clamp-1\">\n            Cassette tapes, holographic dreams, and 2 AM subway signals.\n          </p>\n        </div>\n\n        {/* Hand-Drawn Cyber Starlight Grid Artwork */}\n        <div className=\"hidden sm:flex items-center gap-2 opacity-90 text-indigo-500 dark:text-indigo-400 shrink-0\">\n          <svg viewBox=\"0 0 130 90\" className=\"w-28 md:w-36 h-auto\" fill=\"none\">\n            {/* Wireframe Cross */}\n            <path d=\"M65 5 L65 85 M10 45 L120 45\" stroke=\"currentColor\" strokeWidth=\"1\" strokeDasharray=\"3 3\" opacity=\"0.4\" />\n            {/* 4-point Starburst */}\n            <path\n              d=\"M65 15 C68 35 75 42 95 45 C75 48 68 55 65 75 C62 55 55 48 35 45 C55 42 62 35 65 15 Z\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.3\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.5\"\n            />\n            <circle cx=\"65\" cy=\"45\" r=\"4\" fill=\"currentColor\" />\n            <circle cx=\"105\" cy=\"25\" r=\"3\" fill=\"currentColor\" fillOpacity=\"0.8\" />\n            <circle cx=\"25\" cy=\"65\" r=\"2.5\" fill=\"currentColor\" fillOpacity=\"0.8\" />\n            <circle cx=\"95\" cy=\"70\" r=\"1.8\" fill=\"currentColor\" fillOpacity=\"0.6\" />\n          </svg>\n        </div>\n      </div>\n    );\n  }\n\n  if (themeId === \'matcha\') {\n    return (\n      <div className=\"relative w-full h-32 md:h-36 rounded-2xl overflow-hidden bg-gradient-to-r from-emerald-100 via-stone-50 to-emerald-100 dark:from-emerald-950/40 dark:via-stone-900/30 dark:to-emerald-950/40 border-2 border-emerald-200/80 dark:border-emerald-800/60 p-4 md:p-6 flex items-center justify-between\">\n        <div className=\"z-10 max-w-md\">\n          <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-200/80 dark:bg-emerald-900/60 text-emerald-950 dark:text-emerald-200 text-[11px] font-bold tracking-wide uppercase\">\n            <MatchaLeafIcon className=\"w-3.5 h-3.5 text-emerald-700 dark:text-emerald-300\" />\n            <span>Caf\303\251 Botanica Edition</span>\n          </div>\n          <h2 className=\"font-display-chic text-xl md:text-2xl font-black text-emerald-950 dark:text-white mt-1.5 leading-tight\">\n            Earthy Whisk, Morning Foam & Mindful Journal\n          </h2>\n          <p className=\"font-serif-literary text-xs md:text-sm text-emerald-800 dark:text-emerald-200/80 mt-1 line-clamp-1\">\n            Ceramic cups, steaming oat milk, and quiet botanical reflections.\n          </p>\n        </div>\n\n        {/* Hand-Drawn Ceramic Tea Cup & Leaf Artwork */}\n        <div className=\"hidden sm:flex items-center gap-2 opacity-90 text-emerald-600 dark:text-emerald-400 shrink-0\">\n          <svg viewBox=\"0 0 130 90\" className=\"w-28 md:w-36 h-auto\" fill=\"none\">\n            {/* Steam trails */}\n            <path d=\"M50 25 Q53 15 50 5\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" opacity=\"0.6\" />\n            <path d=\"M62 23 Q66 12 62 3\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" opacity=\"0.6\" />\n            <path d=\"M74 25 Q71 14 75 5\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" opacity=\"0.6\" />\n            {/* Cup Bowl */}\n            <path\n              d=\"M38 32 L86 32 C86 58 76 68 62 68 C48 68 38 58 38 32 Z\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.25\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.5\"\n            />\n            {/* Cup Handle */}\n            <path\n              d=\"M86 38 C96 38 98 52 86 54\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.2\"\n              strokeLinecap=\"round\"\n            />\n            {/* Saucer */}\n            <path\n              d=\"M30 70 Q62 76 94 70\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.5\"\n              strokeLinecap=\"round\"\n            />\n            {/* Leaf sprout on side */}\n            <path\n              d=\"M102 42 C115 35 125 40 125 48 C120 54 110 52 102 42 Z\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.4\"\n              stroke=\"currentColor\"\n              strokeWidth=\"1.5\"\n            />\n          </svg>\n        </div>\n      </div>\n    );\n  }\n\n  // Midnight\n  return (\n    <div className=\"relative w-full h-32 md:h-36 rounded-2xl overflow-hidden bg-gradient-to-r from-purple-100 via-slate-50 to-purple-100 dark:from-purple-950/40 dark:via-zinc-900/40 dark:to-purple-950/40 border-2 border-purple-200/80 dark:border-purple-800/60 p-4 md:p-6 flex items-center justify-between\">\n      <div className=\"z-10 max-w-md\">\n        <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-purple-200/80 dark:bg-purple-900/60 text-purple-950 dark:text-purple-200 text-[11px] font-bold tracking-wide uppercase\">\n          <MidnightMoonIcon className=\"w-3.5 h-3.5 text-purple-700 dark:text-purple-300\" />\n          <span>Nocturnal Sanctuary Edition</span>\n        </div>\n        <h2 className=\"font-display-chic text-xl md:text-2xl font-black text-purple-950 dark:text-white mt-1.5 leading-tight\">\n          Velvet Shadows, Ink Wells & Starlight\n        </h2>\n        <p className=\"font-serif-literary text-xs md:text-sm text-purple-800 dark:text-purple-200/80 mt-1 line-clamp-1\">\n          The deepest verses are poured when the rest of the world is asleep.\n        </p>\n      </div>\n\n      {/* Hand-Drawn Moon & Constellation Artwork */}\n      <div className=\"hidden sm:flex items-center gap-2 opacity-90 text-purple-500 dark:text-purple-400 shrink-0\">\n        <svg viewBox=\"0 0 130 90\" className=\"w-28 md:w-36 h-auto\" fill=\"none\">\n          {/* Crescent Moon */}\n          <path\n            d=\"M60 12 C40 12 25 27 25 47 C25 67 40 82 60 82 C72 82 82 76 88 66 C80 69 72 68 64 63 C51 54 49 37 59 25 C64 19 72 16 80 16 C74 13 67 12 60 12 Z\"\n            fill=\"currentColor\"\n            fillOpacity=\"0.3\"\n            stroke=\"currentColor\"\n            strokeWidth=\"2.5\"\n          />\n          {/* Constellation dots and connector lines */}\n          <line x1=\"88\" y1=\"28\" x2=\"108\" y2=\"20\" stroke=\"currentColor\" strokeWidth=\"1\" strokeDasharray=\"2 2\" opacity=\"0.6\" />\n          <line x1=\"108\" y1=\"20\" x2=\"118\" y2=\"42\" stroke=\"currentColor\" strokeWidth=\"1\" strokeDasharray=\"2 2\" opacity=\"0.6\" />\n          <circle cx=\"88\" cy=\"28\" r=\"3\" fill=\"currentColor\" />\n          <circle cx=\"108\" cy=\"20\" r=\"2.5\" fill=\"currentColor\" />\n          <circle cx=\"118\" cy=\"42\" r=\"3.2\" fill=\"currentColor\" />\n          <circle cx=\"102\" cy=\"68\" r=\"2\" fill=\"currentColor\" fillOpacity=\"0.7\" />\n        </svg>\n      </div>\n    </div>\n  );\n};\n"
