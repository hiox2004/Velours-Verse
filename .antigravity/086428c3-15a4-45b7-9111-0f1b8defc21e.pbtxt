    content: "                        </div>\n                      </span>\n                      {themeId === t.id && <Check className=\"w-4 h-4 text-zinc-900 dark:text-white\" />}\n                    </button>\n                  ))}\n                </div>\n              )}\n            </div>\n\n            {/* Dark / Light Toggle */}\n            <button\n              onClick={toggleMode}\n              className=\"w-9 h-9 rounded-xl flex items-center justify-center text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 border border-zinc-300 dark:border-zinc-700 transition-colors\"\n              title={`Switch to ${mode === \'light\' ? \'Dark\' : \'Light\'} Mode`}\n              aria-label=\"Toggle theme mode\"\n            >\n              {mode === \'light\' ? <Moon className=\"w-4 h-4 text-zinc-800\" /> : <Sun className=\"w-4 h-4 text-amber-300\" />}\n            </button>\n\n            {/* Profile Avatar / Login */}\n            <button\n              onClick={onOpenProfile}\n              className=\"flex items-center gap-2 pl-1.5 pr-3 py-1 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 border border-zinc-300 dark:border-zinc-700 transition-colors\"\n              title=\"Open profile & penpal info\"\n            >\n              <img\n                src={currentUser.avatar}\n                alt={currentUser.displayName}\n                className=\"w-6 h-6 rounded-full object-cover ring-1 ring-zinc-400\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <span className=\"text-xs font-bold text-zinc-900 dark:text-zinc-100 max-w-[90px] truncate\">\n                {currentUser.displayName}\n              </span>\n            </button>\n\n            {/* Primary Action Button */}\n            <button\n              onClick={onOpenNewPiece}\n              className=\"flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-white bg-zinc-950 dark:bg-white dark:text-zinc-950 hover:opacity-90 active:scale-[0.98] transition-all shadow-sm border border-zinc-800 dark:border-white\"\n            >\n              <Plus className=\"w-4 h-4\" />\n              <span>Write Piece</span>\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* MOBILE TOP BAR (High contrast header) */}\n      <header className=\"md:hidden sticky top-0 z-40 backdrop-blur-md bg-white/95 dark:bg-zinc-950/95 border-b-2 border-zinc-200 dark:border-zinc-800 px-4 h-14 flex items-center justify-between no-print\">\n        <button\n          onClick={() => onSelectView(\'feed\')}\n          className=\"flex items-center gap-2 text-left\"\n        >\n          <div className=\"w-7 h-7 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center border border-zinc-300 dark:border-zinc-700\">\n            <ThemeMotifIcon themeId={themeId} className=\"w-3.5 h-3.5 text-zinc-900 dark:text-white\" />\n          </div>\n          <span className=\"font-display-chic text-lg font-black tracking-tight text-zinc-950 dark:text-white truncate max-w-[150px]\">\n            Velours & Verse\n          </span>\n        </button>\n\n        <div className=\"flex items-center gap-1.5\">\n          <button\n            onClick={() => setShowThemePicker(!showThemePicker)}\n            className=\"w-9 h-9 rounded-xl flex items-center justify-center text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700\"\n            aria-label=\"Theme\"\n          >\n            <ThemeMotifIcon themeId={themeId} className=\"w-4 h-4\" />\n          </button>\n\n          <button\n            onClick={toggleMode}\n            className=\"w-9 h-9 rounded-xl flex items-center justify-center text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700\"\n            aria-label=\"Toggle dark mode\"\n          >\n            {mode === \'light\' ? <Moon className=\"w-4 h-4\" /> : <Sun className=\"w-4 h-4\" />}\n          </button>\n\n          <button\n            onClick={onOpenProfile}"
