    content: "          >\n            <Star className={`w-3.5 h-3.5 ${piece.starredByMe ? \'fill-current\' : \'\'}`} />\n            <span className=\"font-mono tabular-nums\">{piece.stars}</span>\n          </button>\n\n          {/* Comment Count Button */}\n          <button\n            onClick={onClick}\n            className=\"min-h-[32px] px-2.5 py-1 rounded-xl text-xs font-black text-black dark:text-white bg-white/80 dark:bg-zinc-800/80 border-2 border-black/30 dark:border-white/30 hover:border-black flex items-center gap-1.5 transition-colors\"\n            title=\"View comments\"\n          >\n            <MessageCircle className=\"w-3.5 h-3.5\" />\n            <span className=\"font-mono tabular-nums\">{piece.comments?.length || 0}</span>\n          </button>\n\n          {/* Quick Print */}\n          <button\n            onClick={onPrint}\n            className=\"w-8 h-8 rounded-xl text-black dark:text-white bg-white/80 dark:bg-zinc-800/80 border-2 border-black/30 dark:border-white/30 hover:border-black flex items-center justify-center transition-colors\"\n            title=\"Print piece cleanly\"\n          >\n            <Printer className=\"w-3.5 h-3.5\" />\n          </button>\n\n          {/* Quick Download */}\n          <button\n            onClick={onDownload}\n            className=\"w-8 h-8 rounded-xl text-black dark:text-white bg-white/80 dark:bg-zinc-800/80 border-2 border-black/30 dark:border-white/30 hover:border-black flex items-center justify-center transition-colors\"\n            title=\"Download text / markdown\"\n          >\n            <Download className=\"w-3.5 h-3.5\" />\n          </button>\n\n          {/* Delete Action (Owner or Dev God Mode) */}\n          {canDelete && onDelete && (\n            <button\n              onClick={onDelete}\n              className=\"w-8 h-8 rounded-xl text-rose-700 dark:text-rose-400 bg-white/80 dark:bg-zinc-800/80 border-2 border-rose-300 hover:bg-rose-100 flex items-center justify-center transition-colors\"\n              title=\"Delete piece\"\n            >\n              <Trash2 className=\"w-3.5 h-3.5\" />\n            </button>\n          )}\n        </div>\n      </div>\n    </article>\n  );\n};\n"
