              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          totalChars += k.length + val.length;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
