      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Add telemetry and synthetic generator logic to DevAcademy.tsx\",\"EndLine\":75,\"Instruction\":\"Add getStorageMetrics and network/seed helpers in DevAcademy.tsx\",\"ReplacementContent\":\"  const [diagnosticsMessage, setDiagnosticsMessage] = useState<string | null>(null);\\n\\n  const getStorageMetrics = () => {\\n    let totalChars = 0;\\n    const keyBreakdown: { key: string; kb: string }[] = [];\\n    try {\\n      for (let i = 0; i < localStorage.length; i++) {\\n        const k = localStorage.key(i);\\n        if (k) {\\n          const val = localStorage.getItem(k) || \'\';\\n          const bytes = (k.length + val.length) * 2;\\n          totalChars += k.length + val.length;\\n          keyBreakdown.push({ key: k, kb: (bytes / 1024).toFixed(2) });\\n        }\\n      }\\n    } catch {\\n      // Ignore\\n    }\\n    const totalBytes = totalChars * 2;\\n    const totalKb = (totalBytes / 1024).toFixed(2);\\n    const quotaKb = 5120;\\n    const percentUsed = Math.min(100, Math.max(0.1, Number(((Number(totalKb) / quotaKb) * 100).toFixed(2))));\\n    return { totalKb, percentUsed, keyBreakdown };\\n  };\\n\\n  const handleSimulateNetwork = (isOffline: boolean) => {\\n    window.dispatchEvent(new Event(isOffline ? \'offline\' : \'online\'));\\n    setDiagnosticsMessage(`Simulated window.${isOffline ? \'offline\' : \'online\'} event dispatched successfully.`);\\n    setTimeout(() => setDiagnosticsMessage(null), 3000);\\n  };\\n\\n  const handleSeedBatchPieces = () => {\\n    const samples: WritingPiece[] = [\\n      {\\n        id: `piece_seed_${Date.now()}_1`,\\n        title: \'Lilac Stems in Saltwater\',\\n        content: `We brought the blossoms home wrapped in newspaper that smelled of rain and yesterday\'s finance section.\\\\n\\\\nCut them on an angle, she said. As if angles could convince dying things to drink. By midnight, the water in the cut-crystal vase had turned cloudy and fragrant, like gin infused with regret.`,\\n        type: \'poem\',\\n        status: \'published\',\\n        authorId: \'user_clara\',\\n        authorDisplayName: \'Clara Delacroix\',\\n        authorPenpalId: \'PEN-7K3N1\',\\n        authorEmail: \'clara.verse@penpal.org\',\\n        authorAvatar: \'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=150&auto=format&fit=crop&q=80\',\\n        createdAt: new Date().toISOString(),\\n        updatedAt: new Date().toISOString(),\\n        stars: 28,\\n        starredByMe: false,\\n        comments: [],\\n        moodTags: [\'Botanical\', \'Melancholy\', \'Poem\'],\\n        cardTint: \'rose\',\\n        wordCount: 52,\\n        readTimeMinutes: 1,\\n        synced: true\\n      },\\n      {\\n        id: `piece_seed_${Date.now()}_2`,\\n        title: \'The Sound of a 35mm Shutter in Venice\',\\n        content: `Every photograph is an admission of failure. You press the copper button because your memory is a sieve that leaks light.\\\\n\\\\nOutside the caf\303\251 on the Zattere, the vaporetto engines churned the lagoon into jade foam. Julian loaded a fresh roll of Ilford HP5. The clicks of the spool were the only punctual things in Italy.`,\\n        type: \'story\',\\n        status: \'published\',\\n        authorId: \'user_julian\',\\n        authorDisplayName: \'Julian K.\',\\n        authorPenpalId: \'PEN-4B8W2\',\\n        authorEmail: \'julian.prose@penpal.org\',\\n        authorAvatar: \'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80\',\\n        createdAt: new Date().toISOString(),\\n        updatedAt: new Date().toISOString(),\\n        stars: 35,\\n        starredByMe: true,\\n        comments: [],\\n        moodTags: [\'Cinematic\', \'Venice\', \'Analogue\'],\\n        cardTint: \'starlight\',\\n        wordCount: 63,\\n        readTimeMinutes: 1,\\n        synced: true\\n      }\\n    ];\\n\\n    samples.forEach(s => StorageService.savePiece(s));\\n    setDiagnosticsMessage(\'Injected 2 new synthesized literary pieces into database!\');\\n    setTimeout(() => window.location.reload(), 1200);\\n  };\\n\\n  const allUsers = StorageService.getAllUsers();\",\"StartLine\":73,\"TargetContent\":\"  const allUsers = StorageService.getAllUsers();\",\"TargetFile\":\"/src/components/DevAcademy.tsx\",\"toolAction\":\"Adding helpers to DevAcademy\",\"toolSummary\":\"Add diagnostics helpers in DevAcademy.tsx\"}"
