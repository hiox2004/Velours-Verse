  view_file {
    absolute_path_uri: "file:///src/components/WritingCard.tsx"
    start_line: 129
    end_line: 204
    content: "      {/* Bottom Footer: Author credit, Stars, Comments, and Quick Actions */}\n      <div className=\"pt-3 border-t-2 border-black/20 dark:border-white/15 flex items-center justify-between gap-2 mt-auto\">\n        {/* Author display name & Penpal ID (Privacy Guaranteed: never show email) */}\n        <div className=\"flex items-center gap-2.5 min-w-0\">\n          <img\n            src={piece.authorAvatar}\n            alt={piece.authorDisplayName}\n            className=\"w-7 h-7 rounded-full object-cover shrink-0 ring-2 ring-black dark:ring-white\"\n            referrerPolicy=\"no-referrer\"\n          />\n          <div className=\"truncate text-xs\">\n            <span className=\"font-black text-black dark:text-white block truncate\">\n              {piece.authorDisplayName}\n            </span>\n            <span className=\"text-black dark:text-zinc-300 text-[11px] font-black\">\n              {formattedDate}\n            </span>\n          </div>\n        </div>\n\n        {/* Interactive Actions (Stars, Comments, Print, Download, Delete) */}\n        <div className=\"flex items-center gap-1 shrink-0\" onClick={e => e.stopPropagation()}>\n          {/* Star Button */}\n          <button\n            onClick={onToggleStar}\n            className={`min-h-[32px] px-2.5 py-1 rounded-xl text-xs flex items-center gap-1.5 border-2 transition-all font-black ${\n              piece.starredByMe\n                ? `${cardStyle.starActiveBg} ${cardStyle.starActiveText} border-black shadow-xs`\n                : \'text-black dark:text-white bg-white/80 dark:bg-zinc-800/80 border-black/30 dark:border-white/30 hover:border-black\'\n            }`}\n            title=\"Star piece\"\n          >\n            <Star className={`w-3.5 h-3.5 ${piece.starredByMe ? \'fill-current\' : \'\'}`} />\n            <span className=\"font-mono tabular-nums\">{piece.stars}</span>\n          </button>\n\n          {/* Comment Count Button */}\n          <button\n            onClick={onClick}\n            className=\"min-h-[32px] px-2.5 py-1 rounded-xl text-xs font-black text-black dark:text-white bg-white/80 dark:bg-zinc-800/80 border-2 border-black/30 dark:border-white/30 hover:border-black flex items-center gap-1.5 transition-colors\"\n            title=\"View comments\"\n          >\n            <MessageCircle className=\"w-3.5 h-3.5\" />\n            <span className=\"font-mono tabular-nums\">{piece.comments?.length || 0}</span>\n          </button>\n\n          {/* Quick Print */}\n          <button\n            onClick={onPrint}\n            className=\"w-8 h-8 rounded-xl text-black dark:text-white bg-white/80 dark:bg-zinc-800/80 border-2 border-black/30 dark:border-white/30 hover:border-black flex items-center justify-center transition-colors\"\n            title=\"Print piece cleanly\"\n          >\n            <Printer className=\"w-3.5 h-3.5\" />\n          </button>\n\n          {/* Quick Download */}\n          <button\n            onClick={onDownload}\n            className=\"w-8 h-8 rounded-xl text-black dark:text-white bg-white/80 dark:bg-zinc-800/80 border-2 border-black/30 dark:border-white/30 hover:border-black flex items-center justify-center transition-colors\"\n            title=\"Download text / markdown\"\n          >\n            <Download className=\"w-3.5 h-3.5\" />\n          </button>\n\n          {/* Delete Action (Owner or Dev God Mode) */}\n          {canDelete && onDelete && (\n            <button\n              onClick={onDelete}\n              className=\"w-8 h-8 rounded-xl text-rose-700 dark:text-rose-400 bg-white/80 dark:bg-zinc-800/80 border-2 border-rose-300 hover:bg-rose-100 flex items-center justify-center transition-colors\"\n              title=\"Delete piece\"\n            >\n              <Trash2 className=\"w-3.5 h-3.5\" />\n            </button>\n          )}\n        </div>\n      </div>"
    num_lines: 209
    num_bytes: 9363
  }
}
