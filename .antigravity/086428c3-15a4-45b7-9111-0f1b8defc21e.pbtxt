            lines {
              text: "export class StorageService {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  public static getPieces(): WritingPiece[] {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    try {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
