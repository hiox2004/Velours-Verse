            lines {
              text: "#### Core Data Models"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "- `WritingEntry`: id, title, content, type (`poem` | `story` | `prose` | `journal`), authorName, authorEmail, date, starsCount, starredByMe, comments (array of `{id, author, text, timestamp}`), moodTags, colorTheme, wordCount, readTimeMinutes, updatedAt, syncStatus."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- `UserProfile`: email, name, avatarUrl, role (`developer` | `writer`), createdAt."
