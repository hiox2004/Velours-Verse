            }
            lines {
              text: "          className=\"px-5 py-2.5 rounded-xl text-xs font-bold text-white bg-zinc-950 dark:bg-white dark:text-zinc-950 shadow-md hover:opacity-90 active:scale-95 transition-all border border-zinc-800 dark:border-white\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        >"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
