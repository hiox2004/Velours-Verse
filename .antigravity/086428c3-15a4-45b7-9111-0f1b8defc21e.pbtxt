      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Update ThemeHeroIllustration with bold borders, deep black readable text, and saturated badges\",\"EndLine\":345,\"Instruction\":\"Make hero banner text pure black and contrast-rich\",\"ReplacementContent\":\"export const ThemeHeroIllustration: React.FC<{ themeId: AestheticThemeId }> = ({ themeId }) => {\\n  if (themeId === \'coquette\') {\\n    return (\\n      <div className=\\\"relative w-full h-32 md:h-36 rounded-2xl overflow-hidden bg-gradient-to-r from-[#FFE0EC] via-[#FFF0F6] to-[#FFE0EC] dark:from-rose-950/60 dark:via-pink-900/30 dark:to-rose-950/60 border-3 border-[#BE185D] dark:border-rose-500 p-4 md:p-6 flex items-center justify-between shadow-[4px_4px_0px_0px_#BE185D] dark:shadow-none\\\">\\n        <div className=\\\"z-10 max-w-md\\\">\\n          <div className=\\\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#BE185D] text-white text-[11px] font-black tracking-wide uppercase shadow-2xs\\\">\\n            <CoquetteBowIcon className=\\\"w-3.5 h-3.5 text-white\\\" />\\n            <span>Coquette Atelier Edition</span>\\n          </div>\\n          <h2 className=\\\"font-display-chic text-xl md:text-2xl font-black text-black dark:text-white mt-1.5 leading-tight\\\">\\n            Poetry of Silk, Ribbons & Melancholy\\n          </h2>\\n          <p className=\\\"font-serif-literary text-xs md:text-sm text-zinc-950 dark:text-rose-100 font-bold mt-1 line-clamp-1\\\">\\n            Handwritten letters sealed with vintage wax and pressed rose petals.\\n          </p>\\n        </div>\\n\\n        {/* Hand-Drawn Bow Artwork */}\\n        <div className=\\\"hidden sm:flex items-center gap-2 text-[#BE185D] dark:text-rose-400 shrink-0\\\">\\n          <svg viewBox=\\\"0 0 140 100\\\" className=\\\"w-28 md:w-36 h-auto\\\" fill=\\\"none\\\">\\n            <path\\n              d=\\\"M70 45 C50 15 15 20 15 45 C15 70 50 65 70 52 C90 65 125 70 125 45 C125 20 90 15 70 45 Z\\\"\\n           