  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { useTheme } from \'../context/ThemeContext\';\nimport { StorageService } from \'../services/storage\';\nimport {\n  Mail,\n  UserPlus,\n  Copy,\n  Check,\n  Coffee,\n  Quote,\n  Sparkles,\n  Heart,\n  Users,\n  ShieldAlert,\n  ArrowRight\n} from \'lucide-react\';\n\ninterface PenpalHubProps {\n  onOpenFeedForPenpals: () => void;\n  onOpenProfile: () => void;\n}\n\nexport const PenpalHub: React.FC<PenpalHubProps> = ({\n  onOpenFeedForPenpals,\n  onOpenProfile\n}) => {\n  const { currentUser, addPenpal, removePenpal } = useAuth();\n  const { theme } = useTheme();\n\n  const [inputPenpalId, setInputPenpalId] = useState(\'\');\n  const [copiedMyId, setCopiedMyId] = useState(false);\n  const [statusMessage, setStatusMessage] = useState<{ text: string; isError: boolean } | null>(null);\n\n  // Retrieve penpals from global user directory based on IDs\n  const allUsers = StorageService.getAllUsers();\n  const myPenpals = allUsers.filter(u => currentUser.penpalIds.includes(u.penpalId));\n\n  const handleCopyId = () => {\n    navigator.clipboard.writeText(currentUser.penpalId);\n    setCopiedMyId(true);\n    setTimeout(() => setCopiedMyId(false), 2000);\n  };\n\n  const handleAddSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setStatusMessage(null);\n    const res = addPenpal(inputPenpalId);\n    setStatusMessage({\n      text: res.message,\n      isError: !res.success\n    });\n    if (res.success) {\n      setInputPenpalId(\'\');\n    }\n  };\n\n  return (\n    <div className=\"max-w-4xl mx-auto px-4 py-8 space-y-8 animate-in fade-in duration-200\">\n      {/* Hero Banner with Theme Motif */}\n      <div className=\"p-6 md:p-8 rounded-3xl bg-zinc-100/80 dark:bg-zinc-900/80 border border-black/5 dark:border-white/10 relative overflow-hidden\">\n        <div className=\"relative z-10 max-w-xl space-y-3\">\n          <div className=\"flex items-center gap-2 text-xs font-semibold text-pink-600 dark:text-pink-400\">\n            <Mail className=\"w-4 h-4\" />\n            <span>Penpal Circle & Creative Network</span>\n          </div>\n\n          <h2 className=\"font-display-chic text-2xl md:text-3xl font-bold text-zinc-900 dark:text-white\">\n            Letters & Verses Between Kindred Spirits\n          </h2>\n\n          <p className=\"font-serif-literary text-zinc-600 dark:text-zinc-300 text-base leading-relaxed\">\n            Exchange writings exclusively with chosen friends. Connect through uniquely generated Penpal IDs with complete email privacy.\n          </p>\n        </div>\n\n        <div className=\"absolute right-4 bottom-2 text-8xl opacity-10 select-none pointer-events-none\" aria-hidden=\"true\">\n          {theme.motifSymbol}\n        </div>\n      </div>\n\n      {/* Grid: My Penpal Identity Card & Add Penpal Box */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        {/* Card 1: My Personal Penpal Identity */}\n        <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-black/5 dark:border-white/10 space-y-5 shadow-xs\">\n          <div className=\"flex items-start justify-between\">\n            <div className=\"flex items-center gap-3\">\n              <img\n                src={currentUser.avatar}\n                alt={currentUser.displayName}\n                className=\"w-12 h-12 rounded-full object-cover ring-2 ring-pink-500/20\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div>\n                <h3 className=\"font-display-chic text-lg font-bold text-zinc-900 dark:text-white\">\n                  {currentUser.displayName}\n                </h3>\n                <p className=\"text-xs text-zinc-400\">Your Public Identity</p>\n              </div>\n            </div>\n\n            <button\n              onClick={onOpenProfile}\n              className=\"text-xs font-semibold text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white underline underline-offset-4\"\n            >\n              Edit Bio\n            </button>\n          </div>\n\n          {/* Penpal ID Copy Box */}\n          <div className=\"p-4 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-black/5 dark:border-white/5 space-y-2\">\n            <div className=\"text-[11px] font-semibold text-zinc-400 uppercase tracking-wider\">\n              Your Unique Penpal ID\n            </div>\n            <div className=\"flex items-center justify-between\">\n              <span className=\"font-mono text-xl font-bold text-pink-600 dark:text-pink-400 tracking-wider\">\n                {currentUser.penpalId}\n              </span>\n              <button\n                onClick={handleCopyId}\n                className=\"px-3 py-1.5 rounded-lg text-xs font-medium bg-white dark:bg-zinc-700 text-zinc-800 dark:text-zinc-200 border border-black/5 flex items-center gap-1.5 hover:bg-zinc-100 transition-colors\"\n              >\n                {copiedMyId ? <Check className=\"w-3.5 h-3.5 text-emerald-500\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                <span>{copiedMyId ? \'Copied!\' : \'Copy Code\'}</span>\n              </button>\n            </div>\n            <p className=\"text-[11px] text-zinc-400\">\n              Share this code with fellow writers so they can add you to their circle.\n            </p>\n          </div>\n\n          {/* Get To Know Me Snippet */}\n          <div className=\"space-y-2 text-xs text-zinc-600 dark:text-zinc-400 pt-2 border-t border-black/5 dark:border-white/5\">\n            <div className=\"flex items-center gap-2\">\n              <Coffee className=\"w-3.5 h-3.5 text-amber-500 shrink-0\" />\n              <span>Beverage of choice: <strong>{currentUser.favoriteDrink || \'Matcha Latte\'}</strong></span>\n            </div>\n            <div className=\"flex items-start gap-2\">\n              <Quote className=\"w-3.5 h-3.5 text-purple-500 shrink-0 mt-0.5\" />\n              <span className=\"italic\">\342\200\234{currentUser.favoriteQuote || \'Writing is thinking made visible.\'}\342\200\235</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Card 2: Add Penpal Form */}\n        <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-black/5 dark:border-white/10 flex flex-col justify-between shadow-xs\">\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-2 text-zinc-900 dark:text-white font-display-chic text-lg font-bold\">\n              <UserPlus className=\"w-5 h-5 text-pink-500\" />\n              <span>Connect with a Penpal</span>\n            </div>\n\n            <p className=\"text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed\">\n              Enter a friend\'s unique 8-character Penpal ID (e.g. <code className=\"font-mono text-zinc-700 dark:text-zinc-300\">PEN-7K3N1</code> or <code className=\"font-mono text-zinc-700 dark:text-zinc-300\">PEN-4B8W2</code>).\n            </p>\n\n            <form onSubmit={handleAddSubmit} className=\"space-y-3\">\n              <div className=\"flex gap-2\">\n                <input\n                  type=\"text\"\n                  value={inputPenpalId}\n                  onChange={e => setInputPenpalId(e.target.value.toUpperCase())}\n                  placeholder=\"e.g. PEN-7K3N1\"\n                  className=\"flex-1 px-4 py-2.5 rounded-xl text-sm font-mono uppercase bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border-none outline-none focus:ring-1 focus:ring-pink-500\"\n                />\n                <button\n                  type=\"submit\"\n                  disabled={!inputPenpalId.trim()}\n                  className=\"px-4 py-2.5 rounded-xl text-xs font-semibold bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 disabled:opacity-40 hover:opacity-90 transition-all flex items-center gap-1.5 shrink-0\"\n                >\n                  <UserPlus className=\"w-4 h-4\" />\n                  <span>Add Friend</span>\n                </button>\n              </div>\n\n              {statusMessage && (\n                <div\n                  className={`p-3 rounded-xl text-xs ${\n                    statusMessage.isError\n                      ? \'bg-rose-50 text-rose-700 dark:bg-rose-950/40 dark:text-rose-300\'\n                      : \'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300\'\n                  }`}\n                >\n                  {statusMessage.text}\n                </div>\n              )}\n            </form>\n          </div>\n\n          {/* Privacy Guarantee Note */}\n          <div className=\"mt-6 pt-4 border-t border-black/5 dark:border-white/5 flex items-start gap-2 text-[11px] text-zinc-400\">\n            <ShieldAlert className=\"w-4 h-4 text-emerald-500 shrink-0 mt-0.5\" />\n            <span>\n              <strong>Privacy Protection:</strong> Your email address is strictly hidden and never exposed to other writers. Only your display name, Penpal ID, and bio are shared.\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Penpal Friends Roster */}\n      <div className=\"space-y-4 pt-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Users className=\"w-4 h-4 text-zinc-500\" />\n            <h3 className=\"font-display-chic text-xl font-bold text-zinc-900 dark:text-white\">\n              My Penpal Circle ({myPenpals.length})\n            </h3>\n          </div>\n\n          {myPenpals.length > 0 && (\n            <button\n              onClick={onOpenFeedForPenpals}\n              className=\"text-xs font-semibold text-pink-600 dark:text-pink-400 hover:underline flex items-center gap-1\"\n            >\n              <span>View Shared Pieces</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          )}\n        </div>\n\n        {myPenpals.length > 0 ? (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n            {myPenpals.map(friend => (\n              <div\n                key={friend.id}\n                className=\"p-5 rounded-2xl bg-white dark:bg-zinc-900 border border-black/5 dark:border-white/10 space-y-4 shadow-xs hover:border-pink-500/30 transition-colors\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2.5\">\n                    <img\n                      src={friend.avatar}\n                      alt={friend.displayName}\n                      className=\"w-10 h-10 rounded-full object-cover ring-1 ring-black/10\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                    <div>\n                      <h4 className=\"font-semibold text-sm text-zinc-900 dark:text-white\">\n                        {friend.displayName}\n                      </h4>\n                      <span className=\"font-mono text-xs text-pink-600 dark:text-pink-400\">\n                        {friend.penpalId}\n                      </span>\n                    </div>\n                  </div>\n\n                  <button\n                    onClick={() => removePenpal(friend.penpalId)}\n                    className=\"text-xs text-zinc-400 hover:text-rose-500 transition-colors\"\n                    title=\"Remove penpal\"\n                  >\n                    Remove\n                  </button>\n                </div>\n\n                <p className=\"text-xs text-zinc-600 dark:text-zinc-300 line-clamp-2 italic\">\n                  \342\200\234{friend.bio}\342\200\235\n                </p>\n\n                <div className=\"pt-2 border-t border-black/5 dark:border-white/5 space-y-1 text-[11px] text-zinc-400\">\n                  <div>\342\230\225 Favorite drink: <span className=\"text-zinc-600 dark:text-zinc-300\">{friend.favoriteDrink}</span></div>\n                  <div>\360\237\223\226 Favorite quote: <span className=\"text-zinc-600 dark:text-zinc-300 truncate block\">{friend.favoriteQuote}</span></div>\n                </div>\n              </div>\n            ))}\n          </div>\n        ) : (\n          <div className=\"p-8 rounded-2xl bg-zinc-50 dark:bg-zinc-900/40 border border-dashed border-zinc-200 dark:border-zinc-800 text-center space-y-3\">\n            <Mail className=\"w-8 h-8 text-zinc-400 mx-auto\" />\n            <h4 className=\"text-sm font-semibold text-zinc-700 dark:text-zinc-300\">\n              No Penpals in your circle yet\n            </h4>\n            <p className=\"text-xs text-zinc-400 max-w-sm mx-auto\">\n              Add sample penpals like <code className=\"font-mono text-pink-500\">PEN-7K3N1</code> (Clara) or <code className=\"font-mono text-pink-500\">PEN-4B8W2</code> (Julian) to read their letters!\n            </p>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/PenpalHub.tsx"
        }
        overwrite: true
      }
    }
