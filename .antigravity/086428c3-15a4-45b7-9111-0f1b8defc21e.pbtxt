        target_content: "          {/* Identity Pill Card */}\n          <div className=\"p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/80 border-2 border-zinc-200 dark:border-zinc-700 flex items-center justify-between\">\n            <div className=\"flex items-center gap-3\">\n              <img\n                src={avatar}\n                alt={currentUser.displayName}\n                className=\"w-12 h-12 rounded-full object-cover ring-2 ring-zinc-300 dark:ring-zinc-600\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <h3 className=\"font-bold text-sm text-zinc-950 dark:text-white\">\n                    {currentUser.displayName}\n                  </h3>\n                  {isDeveloper && (\n                    <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-indigo-100 dark:bg-indigo-950/70 border border-indigo-300 dark:border-indigo-700 text-indigo-800 dark:text-indigo-300 font-bold flex items-center gap-1\">\n                      <ShieldCheck className=\"w-3 h-3\" />\n                      <span>Developer Mode</span>\n                    </span>\n                  )}\n                </div>\n                <div className=\"text-xs text-zinc-600 dark:text-zinc-400 font-mono mt-0.5 font-bold\">\n                  ID: <span className=\"text-pink-600 dark:text-pink-400\">{currentUser.penpalId}</span>\n                </div>\n              </div>\n            </div>\n\n            <button\n              onClick={handleCopyId}\n              className=\"px-3 py-1.5 rounded-lg text-xs font-bold bg-white dark:bg-zinc-700 text-zinc-800 dark:text-zinc-200 border border-zinc-300 dark:border-zinc-600 flex items-center gap-1.5 shadow-2xs\"\n            >\n              {copiedId ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n              <span>{copiedId ? \'Copied\' : \'Copy\'}</span>\n            </button>\n          </div>"
        replacement_content: "          {/* Identity Pill Card */}\n          <div\n            style={glassStyle}\n            className={`p-4 rounded-2xl border-2 ${cardStyle.border} flex items-center justify-between shadow-2xs backdrop-blur-md`}\n          >\n            <div className=\"flex items-center gap-3\">\n              <img\n                src={avatar}\n                alt={currentUser.displayName}\n                className=\"w-12 h-12 rounded-full object-cover ring-2 ring-black dark:ring-white shadow-sm\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <h3 className=\"font-black text-sm text-black dark:text-white\">\n                    {currentUser.displayName}\n                  </h3>\n                  {isDeveloper && (\n                    <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-indigo-600 text-white font-black flex items-center gap-1 shadow-2xs\">\n                      <ShieldCheck className=\"w-3 h-3 stroke-[2.5]\" />\n                      <span>Developer Mode</span>\n                    </span>\n                  )}\n                </div>\n                <div className=\"text-xs text-black dark:text-zinc-200 font-mono mt-0.5 font-black\">\n                  ID: <span className=\"text-pink-700 dark:text-pink-400\">{currentUser.penpalId}</span>\n                </div>\n              </div>\n            </div>\n\n            <button\n              onClick={handleCopyId}\n              className=\"px-3 py-1.5 rounded-xl text-xs font-black bg-black text-white dark:bg-white dark:text-black border-2 border-black dark:border-white flex items-center gap-1.5 shadow-2xs hover:opacity-90 active:scale-95 transition-all\"\n            >\n              {copiedId ? <Check className=\"w-3.5 h-3.5 text-emerald-400 stroke-[3]\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n              <span>{copiedId ? \'Copied\' : \'Copy\'}</span>\n            </button>\n          </div>"
        start_line: 114
        end_line: 149
      }
