    content: "                alt={currentUser.displayName}\n                className=\"w-12 h-12 rounded-full object-cover ring-2 ring-zinc-300 dark:ring-zinc-700\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div>\n                <h3 className=\"font-display-chic text-lg font-bold text-zinc-950 dark:text-white\">\n                  {currentUser.displayName}\n                </h3>\n                <p className=\"text-xs text-zinc-500 font-semibold\">Your Public Identity</p>\n              </div>\n            </div>\n\n            <button\n              onClick={onOpenProfile}\n              className=\"text-xs font-bold text-zinc-800 dark:text-zinc-200 hover:underline\"\n            >\n              Edit Bio\n            </button>\n          </div>\n\n          {/* Penpal ID Copy Box */}\n          <div className=\"p-4 rounded-xl bg-zinc-50 dark:bg-zinc-800/80 border-2 border-zinc-200 dark:border-zinc-700 space-y-2\">\n            <div className=\"text-[11px] font-bold text-zinc-500 uppercase tracking-wider\">\n              Your Unique Penpal ID\n            </div>\n            <div className=\"flex items-center justify-between\">\n              <span className=\"font-mono text-xl font-black text-pink-600 dark:text-pink-400 tracking-wider\">\n                {currentUser.penpalId}\n              </span>\n              <button\n                onClick={handleCopyId}\n                className=\"px-3 py-1.5 rounded-lg text-xs font-bold bg-white dark:bg-zinc-700 text-zinc-900 dark:text-zinc-100 border border-zinc-300 dark:border-zinc-600 flex items-center gap-1.5 hover:bg-zinc-100 shadow-2xs\"\n              >\n                {copiedMyId ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                <span>{copiedMyId ? \'Copied!\' : \'Copy Code\'}</span>\n              </button>\n            </div>\n            <p className=\"text-[11px] text-zinc-600 dark:text-zinc-400 font-medium\">\n              Share this code with fellow writers so they can add you to their circle.\n            </p>\n          </div>\n\n          {/* Get To Know Me Snippet */}\n          <div className=\"space-y-2 text-xs text-zinc-700 dark:text-zinc-300 pt-2 border-t-2 border-zinc-100 dark:border-zinc-800 font-medium\">\n            <div className=\"flex items-center gap-2\">\n              <Coffee className=\"w-3.5 h-3.5 text-amber-600 shrink-0\" />\n              <span>Beverage of choice: <strong className=\"text-zinc-950 dark:text-white font-bold\">{currentUser.favoriteDrink || \'Matcha Latte\'}</strong></span>\n            </div>\n            <div className=\"flex items-start gap-2\">\n              <Quote className=\"w-3.5 h-3.5 text-purple-600 shrink-0 mt-0.5\" />\n              <span className=\"italic text-zinc-800 dark:text-zinc-200\">\342\200\234{currentUser.favoriteQuote || \'Writing is thinking made visible.\'}\342\200\235</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Card 2: Add Penpal Form */}\n        <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 flex flex-col justify-between shadow-xs\">\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-2 text-zinc-950 dark:text-white font-display-chic text-lg font-bold\">\n              <UserPlus className=\"w-5 h-5 text-pink-600\" />\n              <span>Connect with a Penpal</span>\n            </div>\n\n            <p className=\"text-xs text-zinc-600 dark:text-zinc-400 font-medium leading-relaxed\">\n              Enter a friend\'s unique 8-character Penpal ID (e.g. <code className=\"font-mono text-zinc-950 dark:text-zinc-200 font-bold bg-zinc-100 dark:bg-zinc-800 px-1 py-0.5 rounded\">PEN-7K3N1</code> or <code className=\"font-mono text-zinc-950 dark:text-zinc-200 font-bold bg-zinc-100 dark:bg-zinc-800 px-1 py-0.5 rounded\">PEN-4B8W2</code>).\n            </p>\n\n            <form onSubmit={handleAddSubmit} className=\"space-y-3\">\n              <div className=\"flex gap-2\">\n                <input\n                  type=\"text\"\n                  value={inputPenpalId}\n                  onChange={e => setInputPenpalId(e.target.value.toUpperCase())}\n                  placeholder=\"e.g. PEN-7K3N1\"\n                  className=\"flex-1 px-4 py-2.5 rounded-xl text-sm font-mono uppercase font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-100 border-2 border-zinc-300 dark:border-zinc-700 outline-none focus:border-zinc-900\"\n                />\n                <button\n                  type=\"submit\"\n                  disabled={!inputPenpalId.trim()}\n                  className=\"px-4 py-2.5 rounded-xl text-xs font-bold bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 disabled:opacity-40 hover:opacity-90 transition-all flex items-center gap-1.5 shrink-0\"\n                >\n                  <UserPlus className=\"w-4 h-4\" />\n                  <span>Add Friend</span>\n                </button>\n              </div>\n\n              {statusMessage && (\n                <div\n                  className={`p-3 rounded-xl text-xs font-bold ${\n                    statusMessage.isError\n                      ? \'bg-rose-50 text-rose-800 dark:bg-rose-950/60 dark:text-rose-200 border border-rose-200\'"
    num_lines: 281
