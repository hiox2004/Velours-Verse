    content: "          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n            {/* Left: Compose Form (7 cols) */}\n            <form onSubmit={handleDispatchNote} className=\"lg:col-span-7 p-6 rounded-3xl bg-white dark:bg-zinc-900 border-3 border-black dark:border-zinc-700 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-none space-y-5\">\n              <div className=\"flex items-center justify-between pb-2 border-b-2 border-black/15 dark:border-white/15\">\n                <span className=\"font-display-chic text-base font-black text-black dark:text-white flex items-center gap-2\">\n                  <Send className=\"w-4 h-4 text-pink-600\" />\n                  <span>Compose Dispatch</span>\n                </span>\n                <button\n                  type=\"button\"\n                  onClick={() => setIsPreviewModalOpen(true)}\n                  className=\"px-3 py-1 rounded-xl text-xs font-black bg-zinc-100 dark:bg-zinc-800 text-black dark:text-white border-2 border-black/30 dark:border-zinc-600 hover:bg-zinc-200 flex items-center gap-1.5 transition-colors cursor-pointer\"\n                >\n                  <Sparkles className=\"w-3.5 h-3.5 text-amber-500\" />\n                  <span>Preview Card Live</span>\n                </button>\n              </div>\n\n              {/* Title Field */}\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-black text-black dark:text-white uppercase tracking-wider block\">\n                  Letter Title / Subject\n                </label>\n                <input\n                  type=\"text\"\n                  value={noteTitle}\n                  onChange={e => setNoteTitle(e.target.value)}\n                  placeholder=\"e.g. A Handwritten Note from the Creator \360\237\222\214\"\n                  required\n                  className=\"w-full px-3.5 py-2.5 rounded-xl border-2 border-black dark:border-zinc-600 bg-white dark:bg-zinc-800 text-black dark:text-white text-xs font-bold focus:outline-none focus:ring-2 focus:ring-pink-500\"\n                />\n                {/* Quick Presets */}\n                <div className=\"flex flex-wrap gap-1.5 pt-1\">\n                  {[\n                    \'A Handwritten Note from the Creator \360\237\222\214\',\n                    \'Midnight Thoughts on Writing & Solitude \342\234\250\',\n                    \'A Personal Letter for You \360\237\214\277\',\n                    \'Behind the Scenes: Notes from the Studio \342\230\225\'\n                  ].map(preset => (\n                    <button\n                      key={preset}\n                      type=\"button\"\n                      onClick={() => setNoteTitle(preset)}\n                      className=\"text-[10px] font-bold px-2 py-0.5 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-black dark:text-zinc-200 border border-black/20 hover:border-black\"\n                    >\n                      {preset}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Category Tag & Author Signature */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div className=\"space-y-1.5\">\n                  <label className=\"text-xs font-black text-black dark:text-white uppercase tracking-wider block\">\n                    Category Tag / Badge\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={noteTag}\n                    onChange={e => setNoteTag(e.target.value)}\n                    placeholder=\"e.g. Creator Dispatch\"\n                    className=\"w-full px-3 py-2 rounded-xl border-2 border-black dark:border-zinc-600 bg-white dark:bg-zinc-800 text-black dark:text-white text-xs font-bold\"\n                  />\n                </div>\n\n                <div className=\"space-y-1.5\">\n                  <label className=\"text-xs font-black text-black dark:text-white uppercase tracking-wider block\">\n                    Author Name Signature\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={noteAuthorName}\n                    onChange={e => setNoteAuthorName(e.target.value)}\n                    placeholder=\"e.g. Aura Dev\"\n                    className=\"w-full px-3 py-2 rounded-xl border-2 border-black dark:border-zinc-600 bg-white dark:bg-zinc-800 text-black dark:text-white text-xs font-bold\"\n                  />\n                </div>\n              </div>\n\n              {/* Recipient Targeting Selector */}"
