    content: "\n/**\n * Rich Thematic Vector Banners with Gen Z Humanlike Art\n */\nexport const ThemeHeroIllustration: React.FC<{ themeId: AestheticThemeId }> = ({ themeId }) => {\n  if (themeId === \'coquette\') {\n    return (\n      <div className=\"relative w-full h-32 md:h-36 rounded-2xl overflow-hidden bg-gradient-to-r from-rose-100 via-pink-50 to-rose-100 dark:from-rose-950/40 dark:via-pink-900/20 dark:to-rose-950/40 border-2 border-rose-200/80 dark:border-rose-800/60 p-4 md:p-6 flex items-center justify-between\">\n        <div className=\"z-10 max-w-md\">\n          <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-rose-200/80 dark:bg-rose-900/60 text-rose-900 dark:text-rose-200 text-[11px] font-bold tracking-wide uppercase\">\n            <CoquetteBowIcon className=\"w-3.5 h-3.5 text-rose-600 dark:text-rose-300\" />\n            <span>Coquette Atelier Edition</span>\n          </div>\n          <h2 className=\"font-display-chic text-xl md:text-2xl font-black text-rose-950 dark:text-white mt-1.5 leading-tight\">\n            Poetry of Silk, Ribbons & Melancholy\n          </h2>\n          <p className=\"font-serif-literary text-xs md:text-sm text-rose-800 dark:text-rose-200/80 mt-1 line-clamp-1\">\n            Handwritten letters sealed with vintage wax and pressed rose petals.\n          </p>\n        </div>\n\n        {/* Hand-Drawn Bow Artwork */}\n        <div className=\"hidden sm:flex items-center gap-2 opacity-90 text-rose-400 dark:text-rose-500 shrink-0\">\n          <svg viewBox=\"0 0 140 100\" className=\"w-28 md:w-36 h-auto\" fill=\"none\">\n            <path\n              d=\"M70 45 C50 15 15 20 15 45 C15 70 50 65 70 52 C90 65 125 70 125 45 C125 20 90 15 70 45 Z\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.25\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.5\"\n            />\n            <ellipse cx=\"70\" cy=\"48\" rx=\"8\" ry=\"10\" fill=\"currentColor\" fillOpacity=\"0.7\" />\n            <path\n              d=\"M66 55 C55 75 40 92 25 98 C35 92 45 92 58 98 C65 80 67 65 68 55\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.35\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2\"\n            />\n            <path\n              d=\"M74 55 C85 75 100 92 115 98 C105 92 95 92 82 98 C75 80 73 65 72 55\"\n              fill=\"currentColor\"\n              fillOpacity=\"0.35\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2\"\n            />\n            <circle cx=\"20\" cy=\"20\" r=\"3\" fill=\"currentColor\" fillOpacity=\"0.5\" />\n            <circle cx=\"120\" cy=\"22\" r=\"2.5\" fill=\"currentColor\" fillOpacity=\"0.5\" />\n          </svg>\n        </div>\n      </div>\n    );\n  }\n\n  if (themeId === \'y2k\') {\n    return (\n      <div className=\"relative w-full h-32 md:h-36 rounded-2xl overflow-hidden bg-gradient-to-r from-indigo-100 via-sky-50 to-indigo-100 dark:from-indigo-950/50 dark:via-slate-900/40 dark:to-indigo-950/50 border-2 border-indigo-200/80 dark:border-indigo-800/60 p-4 md:p-6 flex items-center justify-between\">\n        <div className=\"z-10 max-w-md\">\n          <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-indigo-200/80 dark:bg-indigo-900/60 text-indigo-950 dark:text-indigo-200 text-[11px] font-bold tracking-wide uppercase\">\n            <Y2kStarIcon className=\"w-3.5 h-3.5 text-indigo-600 dark:text-indigo-300\" />\n            <span>Cyber Twilight Edition</span>\n          </div>\n          <h2 className=\"font-display-chic text-xl md:text-2xl font-black text-indigo-950 dark:text-white mt-1.5 leading-tight\">\n            Chrome Starlight & Neon Digital Verse\n          </h2>\n          <p className=\"font-serif-literary text-xs md:text-sm text-indigo-800 dark:text-indigo-200/80 mt-1 line-clamp-1\">"
    num_lines: 346
    num_bytes: 14499
