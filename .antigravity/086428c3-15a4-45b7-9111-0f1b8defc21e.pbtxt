        target_content: "        {/* Top Metadata & Visibility (Solid, High-Contrast Black Text) */}\n        <div className=\"flex items-center justify-between text-xs text-black dark:text-zinc-200 font-bold mb-2.5 pt-1 pr-6\">\n          {/* Metadata */}\n          <div className=\"flex items-center gap-1.5 flex-wrap\">\n            <span className=\"font-black uppercase tracking-wider text-black dark:text-white\">\n              {typeLabels[piece.type] || \'Piece\'}\n            </span>\n            <span aria-hidden=\"true\" className=\"text-black/60 dark:text-zinc-400\">\302\267</span>\n            <span className=\"text-black dark:text-zinc-200\">{piece.wordCount} words</span>\n            <span aria-hidden=\"true\" className=\"text-black/60 dark:text-zinc-400\">\302\267</span>\n            <span className=\"text-black dark:text-zinc-200\">{piece.readTimeMinutes} min read</span>\n          </div>\n\n          {/* Status Visibility Indicator */}\n          <div className=\"flex items-center gap-1 text-[11px] font-black shrink-0\">\n            {piece.status === \'draft\' && (\n              <span className=\"flex items-center gap-1 text-amber-900 dark:text-amber-300 bg-amber-200/80 dark:bg-amber-950/60 px-2 py-0.5 rounded-full border border-amber-400\">\n                <Lock className=\"w-3 h-3 stroke-[3]\" />\n                <span>Draft</span>\n              </span>\n            )}\n            {piece.status === \'penpals\' && (\n              <span className=\"flex items-center gap-1 text-pink-950 dark:text-pink-200 bg-pink-200/80 dark:bg-pink-950/60 px-2 py-0.5 rounded-full border border-pink-400\">\n                <Mail className=\"w-3 h-3 stroke-[3]\" />\n                <span>Penpals</span>\n              </span>\n            )}\n            {piece.status === \'published\' && (\n              <span className=\"flex items-center gap-1 text-emerald-950 dark:text-emerald-200 bg-emerald-200/80 dark:bg-emerald-950/60 px-2 py-0.5 rounded-full border border-emerald-400\">\n                <Globe className=\"w-3 h-3 stroke-[3]\" />\n                <span>Public</span>\n              </span>\n            )}\n          </div>\n        </div>\n\n        {/* Title in Deep Solid Black Display Typography */}\n        <h3 className=\"font-display-chic text-xl font-black tracking-tight text-black dark:text-white mb-2 leading-snug line-clamp-1\">\n          {piece.title}\n        </h3>\n\n        {/* Excerpt Snippet with Solid Jet Black Color (Never Gray!) */}\n        <p className=\"font-serif-literary text-base text-black dark:text-zinc-100 font-bold line-clamp-3 leading-relaxed mb-4\">\n          {piece.content}\n        </p>\n\n        {/* Mood Tags (Solid Black Text) */}\n        {piece.moodTags && piece.moodTags.length > 0 && (\n          <div className=\"flex items-center gap-1.5 text-xs text-black dark:text-zinc-200 mb-4 flex-wrap font-bold\">\n            <span className=\"text-black/70 dark:text-zinc-400\">Mood:</span>\n            {piece.moodTags.map((tag, idx) => (\n              <span key={idx} className=\"italic text-black dark:text-white font-black underline decoration-black/30 underline-offset-2\">\n                #{tag}\n                {idx < piece.moodTags.length - 1 && <span className=\"not-italic ml-1 text-black/50 no-underline\">\302\267</span>}\n              </span>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Bottom Footer: Author credit, Stars, Comments, and Quick Actions */}\n      <div className=\"pt-3 border-t-2 border-black/15 dark:border-white/15 flex items-center justify-between gap-2 mt-auto\">\n        {/* Author display name & Penpal ID (Privacy Guaranteed: never show email) */}\n        <div className=\"flex items-center gap-2.5 min-w-0\">\n          <img\n            src={piece.authorAvatar}\n            alt={piece.authorDisplayName}\n            className=\"w-7 h-7 rounded-full object-cover shrink-0 ring-2 ring-black/40 dark:ring-white/40\"\n            referrerPolicy=\"no-referrer\"\n          />\n          <div className=\"truncate text-xs\">\n            <span className=\"font-black text-black dark:text-white block truncate\">\n              {piece.authorDisplayName}\n            </span>\n            <span className=\"text-black/80 dark:text-zinc-300 text-[11px] font-bold\">\n              {formattedDate}\n            </span>\n          </div>\n        </div>"
        replacement_content: "        {/* Top Metadata & Visibility (Solid, High-Contrast Black Text) */}\n        <div className=\"flex items-center justify-between text-xs text-black dark:text-zinc-200 font-bold mb-2.5 pt-1 pr-6\">\n          {/* Metadata */}\n          <div className=\"flex items-center gap-1.5 flex-wrap\">\n            <span className={`px-2 py-0.5 rounded-lg text-[10px] font-black uppercase tracking-wider ${cardStyle.badgeBg} ${cardStyle.badgeText} border border-black/20`}>\n              {typeLabels[piece.type] || \'Piece\'}\n            </span>\n            <span aria-hidden=\"true\" className=\"text-black dark:text-zinc-400 font-black\">\302\267</span>\n            <span className=\"text-black dark:text-zinc-200 font-black\">{piece.wordCount} words</span>\n            <span aria-hidden=\"true\" className=\"text-black dark:text-zinc-400 font-black\">\302\267</span>\n            <span className=\"text-black dark:text-zinc-200 font-black\">{piece.readTimeMinutes} min read</span>\n          </div>\n\n          {/* Status Visibility Indicator */}\n          <div className=\"flex items-center gap-1 text-[11px] font-black shrink-0\">\n            {piece.status === \'draft\' && (\n              <span className=\"flex items-center gap-1 text-amber-950 dark:text-amber-300 bg-amber-200 dark:bg-amber-950/60 px-2 py-0.5 rounded-full border-2 border-amber-500 font-black\">\n                <Lock className=\"w-3 h-3 stroke-[3]\" />\n                <span>Draft</span>\n              </span>\n            )}\n            {piece.status === \'penpals\' && (\n              <span className=\"flex items-center gap-1 text-pink-950 dark:text-pink-200 bg-pink-200 dark:bg-pink-950/60 px-2 py-0.5 rounded-full border-2 border-pink-500 font-black\">\n                <Mail className=\"w-3 h-3 stroke-[3]\" />\n                <span>Penpals</span>\n              </span>\n            )}\n            {piece.status === \'published\' && (\n              <span className=\"flex items-center gap-1 text-emerald-950 dark:text-emerald-200 bg-emerald-200 dark:bg-emerald-950/60 px-2 py-0.5 rounded-full border-2 border-emerald-500 font-black\">\n                <Globe className=\"w-3 h-3 stroke-[3]\" />\n                <span>Public</span>\n              </span>\n            )}\n          </div>\n        </div>\n\n        {/* Title in Deep Solid Black Display Typography */}\n        <h3 className=\"font-display-chic text-xl font-black tracking-tight text-black dark:text-white mb-2 leading-snug line-clamp-1\">\n          {piece.title}\n        </h3>\n\n        {/* Excerpt Snippet with Solid Jet Black Color (Never Gray!) */}\n        <p className=\"font-serif-literary text-base text-black dark:text-zinc-100 font-bold line-clamp-3 leading-relaxed mb-4\">\n          {piece.content}\n        </p>\n\n        {/* Mood Tags (Solid Black Text) */}\n        {piece.moodTags && piece.moodTags.length > 0 && (\n          <div className=\"flex items-center gap-1.5 text-xs text-black dark:text-zinc-200 mb-4 flex-wrap font-black\">\n            <span className=\"text-black dark:text-zinc-300 font-black\">Mood:</span>\n            {piece.moodTags.map((tag, idx) => (\n              <span key={idx} className=\"italic text-black dark:text-white font-black underline decoration-black/40 underline-offset-2\">\n                #{tag}\n                {idx < piece.moodTags.length - 1 && <span className=\"not-italic ml-1 text-black dark:text-zinc-400 no-underline\">\302\267</span>}\n              </span>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Bottom Footer: Author credit, Stars, Comments, and Quick Actions */}\n      <div className=\"pt-3 border-t-2 border-black/20 dark:border-white/15 flex items-center justify-between gap-2 mt-auto\">\n        {/* Author display name & Penpal ID (Privacy Guaranteed: never show email) */}\n        <div className=\"flex items-center gap-2.5 min-w-0\">\n          <img\n            src={piece.authorAvatar}\n            alt={piece.authorDisplayName}\n            className=\"w-7 h-7 rounded-full object-cover shrink-0 ring-2 ring-black dark:ring-white\"\n            referrerPolicy=\"no-referrer\"\n          />\n          <div className=\"truncate text-xs\">\n            <span className=\"font-black text-black dark:text-white block truncate\">\n              {piece.authorDisplayName}\n            </span>\n            <span className=\"text-black dark:text-zinc-300 text-[11px] font-black\">\n              {formattedDate}\n            </span>\n          </div>\n        </div>"
