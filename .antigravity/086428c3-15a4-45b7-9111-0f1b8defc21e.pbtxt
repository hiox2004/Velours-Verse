    content: "                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* User Accounts Directory Table */}\n          <div className=\"space-y-3 pt-4\">\n            <h3 className=\"font-display-chic text-lg font-bold text-zinc-950 dark:text-white\">\n              User Accounts Directory (God Mode Display)\n            </h3>\n\n            <div className=\"overflow-x-auto rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-2xs\">\n              <table className=\"w-full text-left text-xs\">\n                <thead className=\"bg-zinc-50 dark:bg-zinc-800/80 border-b-2 border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-bold\">\n                  <tr>\n                    <th className=\"p-3\">User</th>\n                    <th className=\"p-3\">Private Gmail (Dev View)</th>\n                    <th className=\"p-3\">Penpal ID</th>\n                    <th className=\"p-3\">Role</th>\n                    <th className=\"p-3\">Pieces Authored</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-zinc-200 dark:divide-zinc-800\">\n                  {allUsers.map(user => {\n                    const count = pieces.filter(p => p.authorId === user.id || p.authorEmail === user.email).length;\n                    return (\n                      <tr key={user.id} className=\"hover:bg-zinc-50 dark:hover:bg-zinc-800/40\">\n                        <td className=\"p-3 flex items-center gap-2\">\n                          <img src={user.avatar} alt=\"\" className=\"w-6 h-6 rounded-full object-cover ring-1 ring-zinc-300\" />\n                          <span className=\"font-bold text-zinc-950 dark:text-white\">{user.displayName}</span>\n                        </td>\n                        <td className=\"p-3 font-mono text-indigo-600 dark:text-indigo-400 font-bold\">{user.email}</td>\n                        <td className=\"p-3 font-mono text-pink-600 font-bold\">{user.penpalId}</td>\n                        <td className=\"p-3\">\n                          <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold ${\n                            user.role === \'developer\' ? \'bg-indigo-100 text-indigo-800\' : \'bg-zinc-100 text-zinc-700\'\n                          }`}>\n                            {user.role}\n                          </span>\n                        </td>\n                        <td className=\"p-3 font-mono font-bold text-zinc-900 dark:text-white\">{count}</td>\n                      </tr>\n                    );\n                  })}\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n      )}"
    num_lines: 1435
    num_bytes: 75741
  }
}
