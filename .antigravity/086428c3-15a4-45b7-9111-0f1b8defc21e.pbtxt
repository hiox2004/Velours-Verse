            }
            lines {
              text: "        localStorage.setItem(STORAGE_KEYS.PIECES, JSON.stringify(SEED_PIECES));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        return SEED_PIECES;"
