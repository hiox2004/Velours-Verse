  view_file {
    absolute_path_uri: "file:///src/components/Navigation.tsx"
    start_line: 124
    end_line: 284
    content: "            )}\n          </nav>\n\n          {/* Zone 3: Actions (Theme Picker, Dark Toggle, Profile, New Piece) */}\n          <div className=\"flex items-center gap-2.5 shrink-0\">\n            {/* Theme Picker Dropdown */}\n            <div className=\"relative\">\n              <button\n                onClick={() => setShowThemePicker(!showThemePicker)}\n                className=\"h-9 px-3 rounded-xl flex items-center gap-1.5 text-black dark:text-white bg-white dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 border-2 border-black/30 dark:border-zinc-700 transition-colors font-black text-xs shadow-2xs\"\n                title=\"Change aesthetic theme\"\n                aria-label=\"Change aesthetic theme\"\n              >\n                <ThemeMotifIcon themeId={themeId} className=\"w-3.5 h-3.5\" />\n                <span className=\"hidden sm:inline font-black\">{theme.name.split(\' \')[0]}</span>\n              </button>\n\n              {showThemePicker && (\n                <div className=\"absolute right-0 mt-2 w-56 py-2 bg-white dark:bg-zinc-900 rounded-2xl shadow-2xl border-3 border-black dark:border-zinc-700 z-50 animate-in fade-in zoom-in-95 duration-100\">\n                  <div className=\"px-3.5 py-1.5 text-[11px] font-black text-black dark:text-zinc-300 uppercase tracking-wider\">\n                    Select Aesthetic Theme\n                  </div>\n                  {themeOptions.map(t => (\n                    <button\n                      key={t.id}\n                      onClick={() => {\n                        setThemeId(t.id);\n                        setShowThemePicker(false);\n                      }}\n                      className={`w-full px-3.5 py-2.5 text-left text-xs flex items-center justify-between transition-colors ${\n                        themeId === t.id\n                          ? \'bg-zinc-200 dark:bg-zinc-800 font-black text-black dark:text-white\'\n                          : \'text-black dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800/60 font-bold\'\n                      }`}\n                    >\n                      <span className=\"flex items-center gap-2.5\">\n                        <div className=\"w-6 h-6 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center border-2 border-black/30 dark:border-zinc-700\">\n                          <ThemeMotifIcon themeId={t.id} className=\"w-3.5 h-3.5\" />\n                        </div>\n                        <div>\n                          <div className=\"font-black text-black dark:text-white\">{t.name}</div>\n                          <div className=\"text-[10px] text-black/70 dark:text-zinc-400 font-bold\">{t.motif}</div>\n                        </div>\n                      </span>\n                      {themeId === t.id && <Check className=\"w-4 h-4 text-black dark:text-white stroke-[3]\" />}\n                    </button>\n                  ))}\n                </div>\n              )}\n            </div>\n\n            {/* Dark / Light Toggle with explicit White Moon in light mode */}\n            <button\n              onClick={toggleMode}\n              className={`h-9 px-3 rounded-xl flex items-center gap-1.5 transition-all shadow-sm border-2 ${\n                mode === \'light\'\n                  ? \'bg-black text-white border-zinc-700 hover:bg-zinc-900\'\n                  : \'bg-amber-400 text-black border-amber-300 hover:bg-amber-300\'\n              }`}\n              title={`Switch to ${mode === \'light\' ? \'Dark\' : \'Light\'} Mode`}\n              aria-label=\"Toggle theme mode\"\n            >\n              {mode === \'light\' ? (\n                <>\n                  <Moon className=\"w-4 h-4 text-white fill-white stroke-white\" />\n                  <span className=\"text-xs font-black text-white\">White Moon</span>\n                </>\n              ) : (\n                <>\n                  <Sun className=\"w-4 h-4 text-black fill-black stroke-black\" />\n                  <span className=\"text-xs font-black text-black\">Light Sun</span>\n                </>\n              )}\n            </button>\n\n            {/* Profile Avatar / Login */}\n            <button\n              onClick={onOpenProfile}\n              className=\"flex items-center gap-2 pl-1.5 pr-3 py-1 rounded-xl bg-white dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 border-2 border-black/30 dark:border-zinc-700 transition-colors shadow-2xs\"\n              title=\"Open profile & penpal info\"\n            >\n              <img\n                src={currentUser.avatar}\n                alt={currentUser.displayName}\n                className=\"w-6 h-6 rounded-full object-cover ring-2 ring-black dark:ring-white\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <span className=\"text-xs font-black text-black dark:text-white max-w-[90px] truncate\">\n                {currentUser.displayName}\n              </span>\n            </button>\n\n            {/* Primary Action Button */}\n            <button\n              onClick={onOpenNewPiece}\n              className=\"flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-black text-white bg-black dark:bg-white dark:text-black hover:opacity-90 active:scale-[0.98] transition-all shadow-sm border-2 border-black dark:border-white\"\n            >\n              <Plus className=\"w-4 h-4 stroke-[3]\" />\n              <span>Write Piece</span>\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* MOBILE TOP BAR (High contrast header) */}\n      <header className=\"md:hidden sticky top-0 z-40 backdrop-blur-md bg-white dark:bg-zinc-950 border-b-2 border-black/20 dark:border-zinc-800 px-4 h-14 flex items-center justify-between no-print\">\n        <button\n          onClick={() => onSelectView(\'feed\')}\n          className=\"flex items-center gap-2 text-left\"\n        >\n          <div className=\"w-7 h-7 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center border-2 border-black/30 dark:border-zinc-700\">\n            <ThemeMotifIcon themeId={themeId} className=\"w-3.5 h-3.5 text-black dark:text-white\" />\n          </div>\n          <span className=\"font-display-chic text-lg font-black tracking-tight text-black dark:text-white truncate max-w-[150px]\">\n            Velours & Verse\n          </span>\n        </button>\n\n        <div className=\"flex items-center gap-1.5\">\n          <button\n            onClick={() => setShowThemePicker(!showThemePicker)}\n            className=\"w-9 h-9 rounded-xl flex items-center justify-center text-black dark:text-white bg-white dark:bg-zinc-800 border-2 border-black/30 dark:border-zinc-700\"\n            aria-label=\"Theme\"\n          >\n            <ThemeMotifIcon themeId={themeId} className=\"w-4 h-4\" />\n          </button>\n\n          <button\n            onClick={toggleMode}\n            className={`h-9 px-2.5 rounded-xl flex items-center gap-1 transition-all border-2 ${\n              mode === \'light\'\n                ? \'bg-black text-white border-zinc-700\'\n                : \'bg-amber-400 text-black border-amber-300\'\n            }`}\n            aria-label=\"Toggle dark mode\"\n          >\n            {mode === \'light\' ? (\n              <>\n                <Moon className=\"w-4 h-4 text-white fill-white stroke-white\" />\n                <span className=\"text-[11px] font-black text-white\">White Moon</span>\n              </>\n            ) : (\n              <>\n                <Sun className=\"w-4 h-4 text-black fill-black stroke-black\" />\n                <span className=\"text-[11px] font-black text-black\">Sun</span>\n              </>\n            )}\n          </button>\n\n          <button\n            onClick={onOpenProfile}\n            className=\"w-9 h-9 rounded-xl flex items-center justify-center ml-0.5\"\n            aria-label=\"Profile\"\n          >\n            <img\n              src={currentUser.avatar}\n              alt={currentUser.displayName}\n              className=\"w-7 h-7 rounded-full object-cover ring-2 ring-black dark:ring-white\"\n              referrerPolicy=\"no-referrer\"\n            />\n          </button>"
