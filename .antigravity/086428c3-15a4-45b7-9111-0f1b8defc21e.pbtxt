ems-center gap-1.5 text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-2\">\n                <Palette className=\"w-3.5 h-3.5\" />\n                <span>Card Accent Tint</span>\n              </div>\n              <div className=\"flex items-center gap-2 flex-wrap\">\n                {CARD_TINT_OPTIONS.map(opt => (\n                  <button\n                    key={opt.id}\n                    type=\"button\"\n                    onClick={() => setCardTint(opt.id)}\n                    className={`px-3 py-1.5 rounded-xl text-xs flex items-center gap-2 border-2 transition-all font-semibold ${\n                      cardTint === opt.id\n                        ? \'border-zinc-950 dark:border-white shadow-xs scale-105 bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-white\'\n                        : \'border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-zinc-400\'\n                    }`}\n                  >\n                    <span\n                      className=\"w-3 h-3 rounded-full shrink-0 ring-1 ring-black/20\"\n                      style={{ backgroundColor: opt.colorDot }}\n                    />\n                    <span>{opt.name}</span>\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Mood Tags Selection */}\n            <div>\n              <div className=\"flex items-center gap-1.5 text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-2\">\n                <Tag className=\"w-3.5 h-3.5\" />"
