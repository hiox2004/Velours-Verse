            }
            lines {
              text: "    moodTags: [\'Melancholy\', \'Autumn\', \'Tea & Rain\'],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    cardTint: \'rose\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
