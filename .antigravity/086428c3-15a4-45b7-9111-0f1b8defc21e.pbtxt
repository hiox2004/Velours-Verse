    content: "      {/* MOBILE FIXED BOTTOM TAB BAR (Navigation Anchor, Touch targets >= 44px, High Contrast) */}\n      <nav className=\"md:hidden fixed bottom-0 left-0 right-0 z-40 backdrop-blur-md bg-white/98 dark:bg-zinc-950/98 border-t-2 border-zinc-200 dark:border-zinc-800 h-16 grid grid-cols-4 items-center pb-safe no-print\">\n        <button\n          onClick={() => onSelectView(\'feed\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n            currentView === \'feed\'\n              ? \'text-zinc-950 dark:text-white font-bold\'\n              : \'text-zinc-500 dark:text-zinc-400\'\n          }`}\n        >\n          <BookOpen className=\"w-5 h-5\" />\n          <span className=\"text-[10px] mt-1 font-semibold\">Logs</span>\n        </button>\n\n        <button\n          onClick={() => onSelectView(\'penpals\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n            currentView === \'penpals\'\n              ? \'text-zinc-950 dark:text-white font-bold\'\n              : \'text-zinc-500 dark:text-zinc-400\'\n          }`}\n        >\n          <Mail className=\"w-5 h-5\" />\n          <span className=\"text-[10px] mt-1 font-semibold\">Penpals</span>\n        </button>\n\n        <button\n          onClick={() => onSelectView(\'widgets\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n            currentView === \'widgets\'\n              ? \'text-zinc-950 dark:text-white font-bold\'\n              : \'text-zinc-500 dark:text-zinc-400\'\n          }`}\n        >\n          <Sparkles className=\"w-5 h-5\" />\n          <span className=\"text-[10px] mt-1 font-semibold\">Studio</span>\n        </button>\n\n        {isDeveloper ? (\n          <button\n            onClick={() => onSelectView(\'dev_academy\')}\n            className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n              currentView === \'dev_academy\'\n                ? \'text-indigo-600 dark:text-indigo-400 font-bold\'\n                : \'text-zinc-500 dark:text-zinc-400\'\n            }`}\n          >\n            <ShieldCheck className=\"w-5 h-5\" />\n            <span className=\"text-[10px] mt-1 font-semibold\">Dev</span>\n          </button>\n        ) : (\n          <button\n            onClick={onOpenProfile}\n            className=\"min-h-[44px] flex flex-col items-center justify-center text-zinc-500 dark:text-zinc-400\"\n          >\n            <User className=\"w-5 h-5\" />\n            <span className=\"text-[10px] mt-1 font-semibold\">Profile</span>\n          </button>\n        )}\n      </nav>\n    </>\n  );\n};\n"
    num_lines: 383
