    content: "              className={`p-4 rounded-xl flex flex-col items-center justify-center gap-2 border-2 transition-all font-black ${\n                activeSound === \'rain\'\n                  ? \'border-black bg-indigo-100 dark:bg-indigo-950/60 text-indigo-950 dark:text-indigo-300 shadow-xs\'\n                  : \'border-black/30 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-black dark:text-zinc-300\'\n              }`}\n            >\n              <CloudRain className=\"w-6 h-6 stroke-[2.5]\" />\n              <span className=\"text-xs\">Gentle Rain</span>\n              {activeSound === \'rain\' && <span className=\"text-[10px] text-indigo-800 dark:text-indigo-400 font-black\">Playing</span>}\n            </button>\n\n            {/* Cafe */}\n            <button\n              onClick={() => handleToggleSound(\'cafe\')}\n              className={`p-4 rounded-xl flex flex-col items-center justify-center gap-2 border-2 transition-all font-black ${\n                activeSound === \'cafe\'\n                  ? \'border-black bg-amber-100 dark:bg-amber-950/60 text-amber-950 dark:text-amber-300 shadow-xs\'\n                  : \'border-black/30 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-black dark:text-zinc-300\'\n              }`}\n            >\n              <Coffee className=\"w-6 h-6 stroke-[2.5]\" />\n              <span className=\"text-xs\">Cozy Caf\303\251</span>\n              {activeSound === \'cafe\' && <span className=\"text-[10px] text-amber-800 dark:text-amber-400 font-black\">Playing</span>}\n            </button>\n\n            {/* Vinyl */}\n            <button\n              onClick={() => handleToggleSound(\'vinyl\')}\n              className={`p-4 rounded-xl flex flex-col items-center justify-center gap-2 border-2 transition-all font-black ${\n                activeSound === \'vinyl\'\n                  ? \'border-black bg-purple-100 dark:bg-purple-950/60 text-purple-950 dark:text-purple-300 shadow-xs\'\n                  : \'border-black/30 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-black dark:text-zinc-300\'\n              }`}\n            >\n              <Disc className=\"w-6 h-6 stroke-[2.5]\" />\n              <span className=\"text-xs\">Lo-Fi Vinyl</span>\n              {activeSound === \'vinyl\' && <span className=\"text-[10px] text-purple-800 dark:text-purple-400 font-black\">Playing</span>}\n            </button>\n          </div>\n\n          {/* Volume Control */}\n          <div className=\"space-y-2 pt-2 border-t-2 border-black/10 dark:border-zinc-800\">\n            <div className=\"flex items-center justify-between text-xs text-black dark:text-zinc-300 font-black\">\n              <span className=\"flex items-center gap-1.5\">\n                {volume > 0 ? <Volume2 className=\"w-4 h-4\" /> : <VolumeX className=\"w-4 h-4\" />}\n                <span>Volume</span>\n              </span>\n              <span className=\"font-mono text-black dark:text-white font-black\">{Math.round(volume * 100)}%</span>\n            </div>\n\n            <input\n              type=\"range\"\n              min=\"0\"\n              max=\"1\"\n              step=\"0.05\"\n              value={volume}\n              onChange={handleVolumeChange}\n              className=\"w-full accent-black dark:accent-pink-500 cursor-pointer\"\n            />\n          </div>\n        </div>\n\n        {/* Card 2: Daily Word Goal & Streak */}\n        <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-3 border-black/20 dark:border-zinc-800 space-y-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-none\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2\">\n              <Target className=\"w-5 h-5 text-pink-700 dark:text-pink-400 stroke-[2.5]\" />\n              <h3 className=\"font-display-chic text-lg font-black text-black dark:text-white\">\n                Daily Word Goal & Streak\n              </h3>\n            </div>\n\n            <div className=\"flex items-center gap-1 px-3 py-1 rounded-full bg-amber-100 dark:bg-amber-950/60 border-2 border-amber-400 dark:border-amber-700 text-amber-950 dark:text-amber-300 text-xs font-black\">\n              <Flame className=\"w-3.5 h-3.5 fill-current\" />\n              <span>{streakCount} Day Streak</span>\n            </div>\n          </div>\n\n          {/* Progress Ring / Bar */}\n          <div className=\"space-y-3\">\n            <div className=\"flex items-end justify-between\">\n              <div>\n                <span className=\"font-mono text-3xl font-black text-black dark:text-white\">\n                  {wordsWrittenToday}\n                </span>\n                <span className=\"text-black/80 dark:text-zinc-400 font-black text-sm ml-1.5\">/ {goalWords} words</span>\n              </div>\n              <span className=\"font-mono text-sm font-black text-pink-700 dark:text-pink-400\">\n                {progressPercent}%\n              </span>\n            </div>\n\n            {/* Clean Progress Track */}\n            <div className=\"h-3.5 w-full bg-zinc-200 dark:bg-zinc-800 rounded-full overflow-hidden border-2 border-black/30 dark:border-zinc-700\">\n              <div\n                className=\"h-full bg-black dark:bg-white rounded-full transition-all duration-500\"\n                style={{ width: `${progressPercent}%` }}\n              />\n            </div>\n\n            <p className=\"text-xs text-black dark:text-zinc-200 font-bold\">\n              {progressPercent >= 100\n                ? \'Target reached! Your creative output is shining today.\'\n                : `${goalWords - wordsWrittenToday} more words to complete today\'s milestone.`}\n            </p>\n          </div>\n\n          {/* Quick Target Changer */}\n          <div className=\"flex items-center justify-between pt-4 border-t-2 border-black/10 dark:border-zinc-800 text-xs text-black dark:text-zinc-300 font-black\">\n            <span>Change goal:</span>\n            <div className=\"flex items-center gap-1.5\">\n              {[300, 500, 1000].map(words => (\n                <button\n                  key={words}\n                  onClick={() => updateProfile({ writingGoalWords: words })}\n                  className={`px-3 py-1 rounded-lg border-2 transition-colors font-black ${\n                    goalWords === words\n                      ? \'bg-black dark:bg-white text-white dark:text-black border-black dark:border-white shadow-2xs\'\n                      : \'bg-white dark:bg-zinc-800 text-black dark:text-zinc-300 border-black/30 dark:border-zinc-700 hover:bg-zinc-100\'\n                  }`}"
    num_lines: 305
    num_bytes: 13650
  }
}
