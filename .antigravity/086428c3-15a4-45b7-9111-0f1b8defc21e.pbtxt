        instruction: "import React, { useState } from \'react\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { useTheme } from \'../context/ThemeContext\';\nimport { SUPER_ADMIN_EMAIL, SEED_USERS } from \'../services/storage\';\nimport {\n  X,\n  User,\n  Coffee,\n  Quote,\n  ShieldCheck,\n  Check,\n  Copy,\n  LogOut,\n  Sparkles,\n  LogIn,\n  Key\n} from \'lucide-react\';\n\ninterface ProfileModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nconst AVATAR_OPTIONS = [\n  \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80\',\n  \'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=150&auto=format&fit=crop&q=80\',\n  \'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80\',\n  \'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=150&auto=format&fit=crop&q=80\',\n  \'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=150&auto=format&fit=crop&q=80\'\n];\n\nexport const ProfileModal: React.FC<ProfileModalProps> = ({ isOpen, onClose }) => {\n  const { currentUser, isDeveloper, updateProfile, loginWithGoogle, loginAs, logout } = useAuth();\n  const { theme } = useTheme();\n\n  const [displayName, setDisplayName] = useState(currentUser.displayName);\n  const [avatar, setAvatar] = useState(currentUser.avatar);\n  const [bio, setBio] = useState(currentUser.bio);\n  const [favoriteDrink, setFavoriteDrink] = useState(currentUser.favoriteDrink);\n  const [favoriteQuote, setFavoriteQuote] = useState(currentUser.favoriteQuote);\n  const [copiedId, setCopiedId] = useState(false);\n\n  // Custom Google Login input\n  const [customEmail, setCustomEmail] = useState(\'\');\n  const [customName, setCustomName] = useState(\'\');\n  const [showCustomLogin, setShowCustomLogin] = useState(false);\n\n  if (!isOpen) return null;\n\n  const handleSave = (e: React.FormEvent) => {\n    e.preventDefault();\n    updateProfile({\n      displayName: displayName.trim() || currentUser.displayName,\n      avatar,\n      bio,\n      favoriteDrink,\n      favoriteQuote\n    });\n    onClose();\n  };\n\n  const handleCopyId = () => {\n    navigator.clipboard.writeText(currentUser.penpalId);\n    setCopiedId(true);\n    setTimeout(() => setCopiedId(false), 2000);\n  };\n\n  const handleCustomGoogleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!customEmail.trim()) return;\n    loginWithGoogle(customEmail.trim(), customName.trim() || undefined);\n    setShowCustomLogin(false);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in duration-150 no-print\">\n      <div className=\"w-full max-w-lg bg-white dark:bg-zinc-900 rounded-3xl shadow-2xl border border-black/10 dark:border-white/10 flex flex-col max-h-[90vh] overflow-hidden\">\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-black/5 dark:border-white/10 flex items-center justify-between shrink-0 bg-zinc-50/50 dark:bg-zinc-900/50\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-lg\" aria-hidden=\"true\">{theme.motifSymbol}</span>\n            <h2 className=\"font-display-chic text-lg font-bold text-zinc-900 dark:text-white\">\n              Writer Profile & Account\n            </h2>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"w-8 h-8 rounded-xl flex items-center justify-center text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Scrollable Body */}\n        <div className=\"flex-1 overflow-y-auto p-6 space-y-6\">\n          {/* Identity Pill Card */}\n          <div className=\"p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 border border-black/5 dark:border-white/5 flex items-center justify-between\">\n            <div className=\"flex items-center gap-3\">\n              <img\n                src={avatar}\n                alt={currentUser.displayName}\n                className=\"w-12 h-12 rounded-full object-cover ring-2 ring-pink-500/20\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <h3 className=\"font-semibold text-sm text-zinc-900 dark:text-white\">\n                    {currentUser.displayName}\n                  </h3>\n                  {isDeveloper && (\n                    <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 font-bold flex items-center gap-1\">\n                      <ShieldCheck className=\"w-3 h-3\" />\n                      <span>Developer Mode</span>\n                    </span>\n                  )}\n                </div>\n                <div className=\"text-xs text-zinc-500 dark:text-zinc-400 font-mono mt-0.5\">\n                  ID: <span className=\"text-pink-600 dark:text-pink-400 font-bold\">{currentUser.penpalId}</span>\n                </div>\n              </div>\n            </div>\n\n            <button\n              onClick={handleCopyId}\n              className=\"px-2.5 py-1.5 rounded-lg text-xs font-medium bg-white dark:bg-zinc-700 text-zinc-700 dark:text-zinc-200 border border-black/5 flex items-center gap-1.5 shadow-2xs\"\n            >\n              {copiedId ? <Check className=\"w-3.5 h-3.5 text-emerald-500\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n              <span>{copiedId ? \'Copied\' : \'Copy\'}</span>\n            </button>\n          </div>\n\n          {/* Google Sign-In & Switcher */}\n          <div className=\"space-y-3 p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/30 border border-black/5 dark:border-white/5\">\n            <div className=\"text-xs font-semibold text-zinc-700 dark:text-zinc-300 flex items-center justify-between\">\n              <span className=\"flex items-center gap-1.5\">\n                <LogIn className=\"w-3.5 h-3.5 text-pink-500\" />\n                <span>Google Account Sign-In & Dev Mode</span>\n              </span>\n              <span className=\"text-[11px] text-zinc-400 font-normal\">\n                Active: <code className=\"text-zinc-600 dark:text-zinc-300\">{currentUser.email}</code>\n              </span>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs\">\n              {/* Lead Developer Quick Button */}\n              <button\n                type=\"button\"\n                onClick={() => loginWithGoogle(SUPER_ADMIN_EMAIL, \'Aura Dev (Lead)\')}\n                className=\"p-2.5 rounded-xl border border-indigo-200 dark:border-indigo-800 bg-indigo-50/50 dark:bg-indigo-950/30 text-left hover:bg-indigo-100/60 transition-colors\"\n              >\n                <div className=\"font-semibold text-indigo-700 dark:text-indigo-300 flex items-center gap-1\">\n                  <Key className=\"w-3 h-3\" />\n                  <span>Lead Developer ({SUPER_ADMIN_EMAIL})</span>\n                </div>\n                <div className=\"text-[10px] text-indigo-500/80 mt-0.5\">\n                  Unlocks Developer God Mode & Academy\n                </div>\n              </button>\n\n              {/* Clara Penpal Button */}\n              <button\n                type=\"button\"\n                onClick={() => loginAs(SEED_USERS[1])}\n                className=\"p-2.5 rounded-xl border border-black/5 dark:border-white/5 bg-white dark:bg-zinc-800 text-left hover:bg-zinc-100 transition-colors\"\n              >\n                <div className=\"font-semibold text-zinc-800 dark:text-zinc-200\">\n                  Clara D. (Poet)\n                </div>\n                <div className=\"text-[10px] text-zinc-400 mt-0.5\">\n                  PEN-7K3N1 \302\267 Regular Writer\n                </div>\n              </button>\n            </div>\n\n            {/* Custom Google Sign-In Form Toggle */}\n            <div className=\"pt-2\">\n              {!showCustomLogin ? (\n                <button\n                  type=\"button\"\n                  onClick={() => setShowCustomLogin(true)}\n                  className=\"text-xs text-pink-600 dark:text-pink-400 hover:underline flex items-center gap-1\"\n                >\n                  <span>Or sign in with custom Google Account...</span>\n                </button>\n              ) : (\n                <form onSubmit={handleCustomGoogleSubmit} className=\"space-y-2 pt-2 border-t border-black/5\">\n                  <div className=\"grid grid-cols-2 gap-2\">\n                    <input\n                      type=\"email\"\n                      value={customEmail}\n                      onChange={e => setCustomEmail(e.target.value)}\n                      placeholder=\"e.g. hiox2004@gmail.com\"\n                      className=\"px-3 py-1.5 text-xs rounded-xl bg-white dark:bg-zinc-800 border border-black/10 dark:border-white/10 outline-none\"\n                    />\n                    <input\n                      type=\"text\"\n                      value={customName}\n                      onChange={e => setCustomName(e.target.value)}\n                      placeholder=\"Display Name\"\n                      className=\"px-3 py-1.5 text-xs rounded-xl bg-white dark:bg-zinc-800 border border-black/10 dark:border-white/10 outline-none\"\n                    />\n                  </div>\n                  <div className=\"flex gap-2\">\n                    <button\n                      type=\"submit\"\n                      disabled={!customEmail.trim()}\n                      className=\"px-3 py-1 text-xs font-semibold bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 rounded-lg hover:opacity-90 disabled:opacity-40\"\n                    >\n                      Authenticate Google Account\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => setShowCustomLogin(false)}\n                      className=\"px-3 py-1 text-xs text-zinc-400 hover:text-zinc-600\"\n                    >\n                      Cancel\n                    </button>\n                  </div>\n                </form>\n              )}\n            </div>\n          </div>\n\n          {/* Profile Form */}\n          <form onSubmit={handleSave} className=\"space-y-4\">\n            {/* Display Name */}\n            <div>\n              <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1\">\n                Display Name (Public to Penpals)\n              </label>\n              <input\n                type=\"text\"\n                value={displayName}\n                onChange={e => setDisplayName(e.target.value)}\n                className=\"w-full px-3.5 py-2 text-xs rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border-none outline-none focus:ring-1 focus:ring-pink-500\"\n              />\n            </div>\n\n            {/* Avatar Selector */}\n            <div>\n              <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1\">\n                Choose Aesthetic Avatar\n              </label>\n              <div className=\"flex items-center gap-2\">\n                {AVATAR_OPTIONS.map((img, i) => (\n                  <button\n                    key={i}\n                    type=\"button\"\n                    onClick={() => setAvatar(img)}\n                    className={`w-9 h-9 rounded-full overflow-hidden transition-all ${\n                      avatar === img ? \'ring-2 ring-pink-500 scale-110\' : \'opacity-60 hover:opacity-100\'\n                    }`}\n                  >\n                    <img src={img} alt=\"Avatar\" className=\"w-full h-full object-cover\" referrerPolicy=\"no-referrer\" />\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Bio */}\n            <div>\n              <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1\">\n                Get to Know Me \342\200\224 Bio\n              </label>\n              <textarea\n                value={bio}\n                onChange={e => setBio(e.target.value)}\n                rows={2}\n                placeholder=\"What inspires your writing?\"\n                className=\"w-full px-3.5 py-2 text-xs rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border-none outline-none focus:ring-1 focus:ring-pink-500 resize-none\"\n              />\n            </div>\n\n            {/* Favorite Beverage */}\n            <div>\n              <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1\">\n                Writing Beverage of Choice\n              </label>\n              <div className=\"relative\">\n                <Coffee className=\"w-3.5 h-3.5 absolute left-3 top-3 text-zinc-400\" />\n                <input\n                  type=\"text\"\n                  value={favoriteDrink}\n                  onChange={e => setFavoriteDrink(e.target.value)}\n                  placeholder=\"e.g. Iced Matcha Latte with Oat Milk\"\n                  className=\"w-full pl-9 pr-3.5 py-2 text-xs rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border-none outline-none focus:ring-1 focus:ring-pink-500\"\n                />\n              </div>\n            </div>\n\n            {/* Favorite Quote */}\n            <div>\n              <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1\">\n                Guiding Literary Quote\n              </label>\n              <div className=\"relative\">\n                <Quote className=\"w-3.5 h-3.5 absolute left-3 top-3 text-zinc-400\" />\n                <input\n                  type=\"text\"\n                  value={favoriteQuote}\n                  onChange={e => setFavoriteQuote(e.target.value)}\n                  placeholder=\"e.g. Words are sacred.\"\n                  className=\"w-full pl-9 pr-3.5 py-2 text-xs rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 border-none outline-none focus:ring-1 focus:ring-pink-500\"\n                />\n              </div>\n            </div>\n\n            <div className=\"pt-2 flex items-center justify-end gap-2\">\n              <button\n                type=\"button\"\n                onClick={onClose}\n                className=\"px-4 py-2 rounded-xl text-xs text-zinc-500 hover:text-zinc-700\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                className=\"px-5 py-2 rounded-xl text-xs font-semibold text-white bg-zinc-900 dark:bg-white dark:text-zinc-900 hover:opacity-90 active:scale-95 transition-all\"\n              >\n                Save Changes\n              </button>\n            </div>\n          </form>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/ProfileModal.tsx"
        }
        overwrite: true
      }
    }
