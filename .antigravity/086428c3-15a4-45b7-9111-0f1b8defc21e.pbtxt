    end_line: 109
    content: "import React, { useState } from \'react\';\nimport { WritingPiece } from \'../types/writing\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { useTheme } from \'../context/ThemeContext\';\nimport { CARD_TINT_OPTIONS } from \'../types/theme\';\nimport { ThemeMotifIcon } from \'./ThemeIllustrations\';\nimport {\n  X,\n  Star,\n  MessageCircle,\n  Printer,\n  Download,\n  Edit3,\n  Lock,\n  Globe,\n  Mail,\n  Send,\n  Share2,\n  Check\n} from \'lucide-react\';\n\ninterface ReaderModalProps {\n  piece: WritingPiece | null;\n  isOpen: boolean;\n  onClose: () => void;\n  onEdit: (piece: WritingPiece) => void;\n  onToggleStar: (pieceId: string) => void;\n  onAddComment: (pieceId: string, text: string) => void;\n  onPrintPreview: (piece: WritingPiece) => void;\n}\n\nexport const ReaderModal: React.FC<ReaderModalProps> = ({\n  piece,\n  isOpen,\n  onClose,\n  onEdit,\n  onToggleStar,\n  onAddComment,\n  onPrintPreview\n}) => {\n  const { currentUser, isDeveloper } = useAuth();\n  const { mode, themeId } = useTheme();\n\n  const [commentText, setCommentText] = useState(\'\');\n  const [copiedLink, setCopiedLink] = useState(false);\n  const [fontSize, setFontSize] = useState<\'normal\' | \'large\' | \'extra\'>(\'large\');\n\n  if (!isOpen || !piece) return null;\n\n  const isOwner = currentUser.id === piece.authorId || currentUser.email === piece.authorEmail;\n  const canEdit = isOwner || isDeveloper;\n\n  const tint = CARD_TINT_OPTIONS.find(t => t.id === piece.cardTint) || CARD_TINT_OPTIONS[0];\n\n  const formattedDate = new Date(piece.createdAt).toLocaleDateString(undefined, {\n    month: \'long\',\n    day: \'numeric\',\n    year: \'numeric\'\n  });\n\n  const handleDownload = (format: \'md\' | \'txt\') => {\n    let textToExport = \'\';\n    if (format === \'md\') {\n      textToExport = `# ${piece.title}\\n*by ${piece.authorDisplayName} (${piece.authorPenpalId})*\\n*Date: ${formattedDate}*\\n\\n${piece.content}\\n\\n---\\n*Archived in Velours & Verse*`;\n    } else {\n      textToExport = `${piece.title.toUpperCase()}\\nBy ${piece.authorDisplayName} (${piece.authorPenpalId})\\nDate: ${formattedDate}\\n\\n${piece.content}\\n\\n[Velours & Verse]`;\n    }\n\n    const blob = new Blob([textToExport], { type: \'text/plain;charset=utf-8\' });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.download = `${piece.title.toLowerCase().replace(/[^a-z0-9]+/g, \'-\')}.${format}`;\n    link.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const handleShare = () => {\n    navigator.clipboard.writeText(\n      `\"${piece.title}\" by ${piece.authorDisplayName} on Velours & Verse (${piece.authorPenpalId})\\n\\n${piece.content.slice(0, 120)}...`\n    );\n    setCopiedLink(true);\n    setTimeout(() => setCopiedLink(false), 2000);\n  };\n\n  const handleSubmitComment = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!commentText.trim()) return;\n    onAddComment(piece.id, commentText.trim());\n    setCommentText(\'\');\n  };\n\n  const fontSizeClass =\n    fontSize === \'normal\'\n      ? \'text-base md:text-lg leading-relaxed\'\n      : fontSize === \'large\'\n      ? \'text-lg md:text-xl leading-loose\'\n      : \'text-xl md:text-2xl leading-loose\';\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-0 md:p-4 bg-black/75 backdrop-blur-sm animate-in fade-in duration-150 no-print\">\n      <div className=\"w-full h-full md:h-auto md:max-h-[92vh] md:max-w-3xl bg-white dark:bg-zinc-900 md:rounded-3xl shadow-2xl border-2 border-zinc-300 dark:border-zinc-700 flex flex-col overflow-hidden relative\">\n        {/* Accent Bar */}\n        <div className={`h-1.5 w-full ${tint.accentBar}`} />\n\n        {/* Sticky Reader Top Bar (High Contrast) */}\n        <div className=\"px-5 py-4 border-b-2 border-black/20 dark:border-zinc-800 flex items-center justify-between gap-4 shrink-0 bg-white dark:bg-zinc-900\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-7 h-7 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center border-2 border-black/30 dark:border-zinc-700\">\n              <ThemeMotifIcon themeId={themeId} className=\"w-3.5 h-3.5 text-black dark:text-white\" />"
    num_lines: 343
