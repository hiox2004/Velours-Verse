        target_content: "        {/* Card 2: Add Penpal Form */}\n        <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 flex flex-col justify-between shadow-xs\">\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-2 text-zinc-950 dark:text-white font-display-chic text-lg font-bold\">\n              <UserPlus className=\"w-5 h-5 text-pink-600\" />\n              <span>Connect with a Penpal</span>\n            </div>\n\n            <p className=\"text-xs text-zinc-600 dark:text-zinc-400 font-medium leading-relaxed\">\n              Enter a friend\'s unique 8-character Penpal ID (e.g. <code className=\"font-mono text-zinc-950 dark:text-zinc-200 font-bold bg-zinc-100 dark:bg-zinc-800 px-1 py-0.5 rounded\">PEN-7K3N1</code> or <code className=\"font-mono text-zinc-950 dark:text-zinc-200 font-bold bg-zinc-100 dark:bg-zinc-800 px-1 py-0.5 rounded\">PEN-4B8W2</code>).\n            </p>\n\n            <form onSubmit={handleAddSubmit} className=\"space-y-3\">\n              <div className=\"flex gap-2\">\n                <input\n                  type=\"text\"\n                  value={inputPenpalId}\n                  onChange={e => setInputPenpalId(e.target.value.toUpperCase())}\n                  placeholder=\"e.g. PEN-7K3N1\"\n                  className=\"flex-1 px-4 py-2.5 rounded-xl text-sm font-mono uppercase font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-100 border-2 border-zinc-300 dark:border-zinc-700 outline-none focus:border-zinc-900\"\n                />\n                <button\n                  type=\"submit\"\n                  disabled={!inputPenpalId.trim()}\n                  className=\"px-4 py-2.5 rounded-xl text-xs font-bold bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 disabled:opacity-40 hover:opacity-90 transition-all flex items-center gap-1.5 shrink-0\"\n                >\n                  <UserPlus className=\"w-4 h-4\" />\n                  <span>Add Friend</span>\n                </button>\n              </div>\n\n              {statusMessage && (\n                <div\n                  className={`p-3 rounded-xl text-xs font-bold ${\n                    statusMessage.isError\n                      ? \'bg-rose-50 text-rose-800 dark:bg-rose-950/60 dark:text-rose-200 border border-rose-200\'\n                      : \'bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-200 border border-emerald-200\'\n                  }`}\n                >\n                  {statusMessage.text}\n                </div>\n              )}\n            </form>\n          </div>\n\n          {/* Privacy Guarantee Note */}\n          <div className=\"mt-6 pt-4 border-t-2 border-zinc-100 dark:border-zinc-800 flex items-start gap-2 text-[11px] text-zinc-600 dark:text-zinc-400\">\n            <ShieldAlert className=\"w-4 h-4 text-emerald-600 shrink-0 mt-0.5\" />\n            <span>\n              <strong className=\"text-zinc-900 dark:text-white\">Privacy Protection:</strong> Your email address is strictly hidden and never exposed to other writers. Only your display name, Penpal ID, and bio are shared.\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Penpal Friends Roster */}\n      <div className=\"space-y-4 pt-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Users className=\"w-4 h-4 text-zinc-600 dark:text-zinc-300\" />\n            <h3 className=\"font-display-chic text-xl font-bold text-zinc-950 dark:text-white\">\n              My Penpal Circle ({myPenpals.length})\n            </h3>\n          </div>\n\n          {myPenpals.length > 0 && (\n            <button\n              onClick={onOpenFeedForPenpals}\n              className=\"text-xs font-bold text-pink-600 dark:text-pink-400 hover:underline flex items-center gap-1\"\n            >\n              <span>View Shared Pieces</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          )}\n        </div>\n\n        {myPenpals.length > 0 ? (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n            {myPenpals.map(friend => (\n              <div\n                key={friend.id}\n                className=\"p-5 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 space-y-4 shadow-xs hover:border-pink-500/50 transition-colors\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2.5\">\n                    <img\n                      src={friend.avatar}\n                      alt={friend.displayName}\n                      className=\"w-10 h-10 rounded-full object-cover ring-2 ring-zinc-300 dark:ring-zinc-700\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                    <div>\n                      <h4 className=\"font-bold text-sm text-zinc-950 dark:text-white\">\n                        {friend.displayName}\n                      </h4>\n                      <span className=\"font-mono text-xs font-bold text-pink-600 dark:text-pink-400\">\n                        {friend.penpalId}\n                      </span>\n                    </div>\n                  </div>\n\n                  <button\n                    onClick={() => removePenpal(friend.penpalId)}\n                    className=\"text-xs text-zinc-500 hover:text-rose-600 font-bold transition-colors\"\n                    title=\"Remove penpal\"\n                  >\n                    Remove\n                  </button>\n                </div>\n\n                <p className=\"text-xs text-zinc-700 dark:text-zinc-300 line-clamp-2 italic font-serif-literary\">\n                  \342\200\234{friend.bio}\342\200\235\n                </p>\n\n                <div className=\"pt-2 border-t border-zinc-100 dark:border-zinc-800 space-y-1 text-[11px] text-zinc-600 dark:text-zinc-400 font-medium\">\n                  <div>Coffee/Tea: <span className=\"text-zinc-900 dark:text-zinc-200 font-bold\">{friend.favoriteDrink}</span></div>\n                  <div>Quote: <span className=\"text-zinc-900 dark:text-zinc-200 italic truncate block\">\342\200\234{friend.favoriteQuote}\342\200\235</span></div>\n                </div>\n              </div>\n            ))}\n          </div>\n        ) : (\n          <div className=\"p-8 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-dashed border-zinc-300 dark:border-zinc-700 text-center space-y-3\">\n            <Mail className=\"w-8 h-8 text-zinc-400 mx-auto\" />\n            <h4 className=\"text-sm font-bold text-zinc-800 dark:text-zinc-200\">\n              No Penpals in your circle yet\n            </h4>\n            <p className=\"text-xs text-zinc-500 max-w-sm mx-auto\">\n              Add sample penpals like <code className=\"font-mono text-pink-600 font-bold\">PEN-7K3N1</code> (Clara) or <code className=\"font-mono text-pink-600 font-bold\">PEN-4B8W2</code> (Julian) to read their letters!\n            </p>\n          </div>\n        )}"
        replacement_content: "        {/* Card 2: Add Penpal Form */}\n        <div className=\"p-6 rounded-2xl bg-white dark:bg-zinc-900 border-3 border-black/20 dark:border-zinc-800 flex flex-col justify-between shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-none\">\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center gap-2 text-black dark:text-white font-display-chic text-lg font-black\">\n              <UserPlus className=\"w-5 h-5 text-pink-700 stroke-[2.5]\" />\n              <span>Connect with a Penpal</span>\n            </div>\n\n            <p className=\"text-xs text-black dark:text-zinc-300 font-bold leading-relaxed\">\n              Enter a friend\'s unique 8-character Penpal ID (e.g. <code className=\"font-mono text-black dark:text-zinc-200 font-black bg-zinc-200 dark:bg-zinc-800 px-1 py-0.5 rounded border border-black/20\">PEN-7K3N1</code> or <code className=\"font-mono text-black dark:text-zinc-200 font-black bg-zinc-200 dark:bg-zinc-800 px-1 py-0.5 rounded border border-black/20\">PEN-4B8W2</code>).\n            </p>\n\n            <form onSubmit={handleAddSubmit} className=\"space-y-3\">\n              <div className=\"flex gap-2\">\n                <input\n                  type=\"text\"\n                  value={inputPenpalId}\n                  onChange={e => setInputPenpalId(e.target.value.toUpperCase())}\n                  placeholder=\"e.g. PEN-7K3N1\"\n                  className=\"flex-1 px-4 py-2.5 rounded-xl text-sm font-mono uppercase font-black bg-white dark:bg-zinc-800 text-black dark:text-zinc-100 border-2 border-black/30 dark:border-zinc-700 outline-none focus:border-black\"\n                />\n                <button\n                  type=\"submit\"\n                  disabled={!inputPenpalId.trim()}\n                  className=\"px-4 py-2.5 rounded-xl text-xs font-black bg-black dark:bg-white text-white dark:text-black disabled:opacity-40 hover:opacity-90 transition-all flex items-center gap-1.5 shrink-0 shadow-xs\"\n                >\n                  <UserPlus className=\"w-4 h-4 stroke-[2.5]\" />\n                  <span>Add Friend</span>\n                </button>\n              </div>\n\n              {statusMessage && (\n                <div\n                  className={`p-3 rounded-xl text-xs font-black ${\n                    statusMessage.isError\n                      ? \'bg-rose-100 text-rose-950 dark:bg-rose-950/60 dark:text-rose-200 border-2 border-rose-400\'\n                      : \'bg-emerald-100 text-emerald-950 dark:bg-emerald-950/60 dark:text-emerald-200 border-2 border-emerald-400\'\n                  }`}\n                >\n                  {statusMessage.text}\n                </div>\n              )}\n            </form>\n          </div>\n\n          {/* Privacy Guarantee Note */}\n          <div className=\"mt-6 pt-4 border-t-2 border-black/10 dark:border-zinc-800 flex items-start gap-2 text-[11px] text-black dark:text-zinc-300 font-bold\">\n            <ShieldAlert className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5 stroke-[2.5]\" />\n            <span>\n              <strong className=\"text-black dark:text-white font-black\">Privacy Protection:</strong> Your email address is strictly hidden and never exposed to other writers. Only your display name, Penpal ID, and bio are shared.\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Penpal Friends Roster */}\n      <div className=\"space-y-4 pt-4\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Users className=\"w-4 h-4 text-black dark:text-zinc-300 stroke-[2.5]\" />\n            <h3 className=\"font-display-chic text-xl font-black text-black dark:text-white\">\n              My Penpal Circle ({myPenpals.length})\n            </h3>\n          </div>\n\n          {myPenpals.length > 0 && (\n            <button\n              onClick={onOpenFeedForPenpals}\n              className=\"text-xs font-black text-pink-700 dark:text-pink-400 hover:underline flex items-center gap-1\"\n            >\n              <span>View Shared Pieces</span>\n              <ArrowRight className=\"w-3.5 h-3.5 stroke-[3]\" />\n            </button>\n          )}\n        </div>\n\n        {myPenpals.length > 0 ? (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n            {myPenpals.map(friend => (\n              <div\n                key={friend.id}\n                className=\"p-5 rounded-2xl bg-white dark:bg-zinc-900 border-3 border-black/20 dark:border-zinc-800 space-y-4 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-none hover:border-black transition-all\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2.5\">\n                    <img\n                      src={friend.avatar}\n                      alt={friend.displayName}\n                      className=\"w-10 h-10 rounded-full object-cover ring-2 ring-black dark:ring-white\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                    <div>\n                      <h4 className=\"font-black text-sm text-black dark:text-white\">\n                        {friend.displayName}\n                      </h4>\n                      <span className=\"font-mono text-xs font-black text-pink-700 dark:text-pink-400\">\n                        {friend.penpalId}\n                      </span>\n                    </div>\n                  </div>\n\n                  <button\n                    onClick={() => removePenpal(friend.penpalId)}\n                    className=\"text-xs text-black/70 hover:text-rose-700 font-black transition-colors\"\n                    title=\"Remove penpal\"\n                  >\n                    Remove\n                  </button>\n                </div>\n\n                <p className=\"text-xs text-black dark:text-zinc-200 line-clamp-2 italic font-serif-literary font-bold\">\n                  \342\200\234{friend.bio}\342\200\235\n                </p>\n\n                <div className=\"pt-2 border-t-2 border-black/10 dark:border-zinc-800 space-y-1 text-[11px] text-black dark:text-zinc-300 font-bold\">\n                  <div>Coffee/Tea: <span className=\"text-black dark:text-zinc-100 font-black\">{friend.favoriteDrink}</span></div>\n                  <div>Quote: <span className=\"text-black dark:text-zinc-100 italic truncate block font-bold\">\342\200\234{friend.favoriteQuote}\342\200\235</span></div>\n                </div>\n              </div>\n            ))}\n          </div>\n        ) : (\n          <div className=\"p-8 rounded-2xl bg-white dark:bg-zinc-900 border-3 border-dashed border-black/30 dark:border-zinc-700 text-center space-y-3\">\n            <Mail className=\"w-8 h-8 text-black/40 dark:text-zinc-500 mx-auto stroke-[2]\" />\n            <h4 className=\"text-sm font-black text-black dark:text-zinc-200\">\n              No Penpals in your circle yet\n            </h4>\n            <p className=\"text-xs text-black dark:text-zinc-300 max-w-sm mx-auto font-bold\">\n              Add sample penpals like <code className=\"font-mono text-pink-700 font-black\">PEN-7K3N1</code> (Clara) or <code className=\"font-mono text-pink-700 font-black\">PEN-4B8W2</code> (Julian) to read their letters!\n            </p>\n          </div>\n        )}"
