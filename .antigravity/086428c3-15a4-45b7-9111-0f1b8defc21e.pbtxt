              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    id: \'piece-2\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    title: \'Subway Starlight and 2 AM Transistors\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    content: `The neon tube above car 4 flickered at roughly sixty hertz\342\200\224a buzz that sounded less like electricity and more like a cicada trapped inside an aluminum can."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "Julian turned the cassette over. The magnetic tape was worn thin at the splice, but the piano line was still there, floating across three decades of static."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "\"Next stop: Atlantic Avenue.\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "A girl in an oversized sage knit sweater was sketching something into an unlined leather journal across the aisle. She didn\'t look up when the brakes shrieked against the curved rails. People who make art in public transit possess a specific brand of armor: they can inhabit a cathedral while standing three inches from a spilled energy drink."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "He pulled his notebook out. Just three sentences before the doors slid open. Just three words before the city swallowed the cadence whole.`,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    type: \'story\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
