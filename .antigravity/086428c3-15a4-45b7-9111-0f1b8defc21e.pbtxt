        target_content: "          {/* Format & Visibility Controls */}\n          <div className=\"flex flex-wrap items-center justify-between gap-3 pb-4 border-b-2 border-zinc-200 dark:border-zinc-800 text-xs\">\n            {/* Format Selector */}\n            <div className=\"flex items-center gap-1 p-1 bg-zinc-100 dark:bg-zinc-800 rounded-xl border border-zinc-300 dark:border-zinc-700\">\n              {([\'poem\', \'story\', \'prose\', \'journal\'] as WritingType[]).map(t => (\n                <button\n                  key={t}\n                  type=\"button\"\n                  onClick={() => setType(t)}\n                  className={`px-3 py-1.5 rounded-lg font-bold transition-all capitalize ${\n                    type === t\n                      ? \'bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 shadow-xs\'\n                      : \'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white\'\n                  }`}\n                >\n                  {t === \'story\' ? \'Short Story\' : t}\n                </button>\n              ))}\n            </div>\n\n            {/* Visibility Selector: Draft, Penpals, Published */}\n            <div className=\"flex items-center gap-1 p-1 bg-zinc-100 dark:bg-zinc-800 rounded-xl border border-zinc-300 dark:border-zinc-700\">\n              <button\n                type=\"button\"\n                onClick={() => setStatus(\'draft\')}\n                className={`px-3 py-1.5 rounded-lg font-bold flex items-center gap-1.5 transition-all ${\n                  status === \'draft\'\n                    ? \'bg-amber-600 text-white shadow-xs\'\n                    : \'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white\'\n                }`}\n              >\n                <Lock className=\"w-3.5 h-3.5\" />\n                <span>Draft</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setStatus(\'penpals\')}\n                className={`px-3 py-1.5 rounded-lg font-bold flex items-center gap-1.5 transition-all ${\n                  status === \'penpals\'\n                    ? \'bg-pink-600 text-white shadow-xs\'\n                    : \'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white\'\n                }`}\n              >\n                <Mail className=\"w-3.5 h-3.5\" />\n                <span>Penpals</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setStatus(\'published\')}\n                className={`px-3 py-1.5 rounded-lg font-bold flex items-center gap-1.5 transition-all ${\n                  status === \'published\'\n                    ? \'bg-emerald-700 text-white shadow-xs\'\n                    : \'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white\'\n                }`}\n              >\n                <Globe className=\"w-3.5 h-3.5\" />\n                <span>Published</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Title Input (High Contrast, Bold) */}\n          <div>\n            <input\n              type=\"text\"\n              value={title}\n              onChange={e => setTitle(e.target.value)}\n              placeholder=\"Title of your poem, story or verse...\"\n              className=\"w-full text-2xl md:text-3xl font-display-chic font-black text-zinc-950 dark:text-white placeholder:text-zinc-400 dark:placeholder:text-zinc-600 bg-transparent border-none outline-none focus:ring-0 px-0\"\n            />\n          </div>\n\n          {/* Main Textarea (High Contrast, Deep Readable Color) */}\n          <div>\n            <textarea\n              value={content}\n              onChange={e => setContent(e.target.value)}\n              placeholder={\n                type === \'poem\'\n                  ? \'Pour your verses here...\\n\\nEvery line break a breath,\\nEvery word a quiet sanctuary.\'\n                  : \'Start writing your narrative or journal reflection...\'\n              }\n              rows={12}\n              className=\"w-full font-serif-literary text-lg md:text-xl text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-600 bg-transparent border-none outline-none focus:ring-0 p-0 resize-none leading-relaxed font-normal\"\n            />\n          </div>"
        replacement_content: "          {/* Format & Visibility Controls */}\n          <div className=\"flex flex-wrap items-center justify-between gap-3 pb-4 border-b-2 border-black/15 dark:border-zinc-800 text-xs\">\n            {/* Format Selector */}\n            <div className=\"flex items-center gap-1 p-1 bg-zinc-100 dark:bg-zinc-800 rounded-xl border-2 border-black/20 dark:border-zinc-700\">\n              {([\'poem\', \'story\', \'prose\', \'journal\'] as WritingType[]).map(t => (\n                <button\n                  key={t}\n                  type=\"button\"\n                  onClick={() => setType(t)}\n                  className={`px-3 py-1.5 rounded-lg font-black transition-all capitalize ${\n                    type === t\n                      ? \'bg-black dark:bg-white text-white dark:text-black shadow-xs\'\n                      : \'text-black dark:text-zinc-300 hover:text-black dark:hover:text-white\'\n                  }`}\n                >\n                  {t === \'story\' ? \'Short Story\' : t}\n                </button>\n              ))}\n            </div>\n\n            {/* Visibility Selector: Draft, Penpals, Published */}\n            <div className=\"flex items-center gap-1 p-1 bg-zinc-100 dark:bg-zinc-800 rounded-xl border-2 border-black/20 dark:border-zinc-700\">\n              <button\n                type=\"button\"\n                onClick={() => setStatus(\'draft\')}\n                className={`px-3 py-1.5 rounded-lg font-black flex items-center gap-1.5 transition-all ${\n                  status === \'draft\'\n                    ? \'bg-amber-600 text-white shadow-xs\'\n                    : \'text-black dark:text-zinc-300 hover:text-black dark:hover:text-white\'\n                }`}\n              >\n                <Lock className=\"w-3.5 h-3.5 stroke-[2.5]\" />\n                <span>Draft</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setStatus(\'penpals\')}\n                className={`px-3 py-1.5 rounded-lg font-black flex items-center gap-1.5 transition-all ${\n                  status === \'penpals\'\n                    ? \'bg-pink-600 text-white shadow-xs\'\n                    : \'text-black dark:text-zinc-300 hover:text-black dark:hover:text-white\'\n                }`}\n              >\n                <Mail className=\"w-3.5 h-3.5 stroke-[2.5]\" />\n                <span>Penpals</span>\n              </button>\n\n              <button\n                type=\"button\"\n                onClick={() => setStatus(\'published\')}\n                className={`px-3 py-1.5 rounded-lg font-black flex items-center gap-1.5 transition-all ${\n                  status === \'published\'\n                    ? \'bg-emerald-700 text-white shadow-xs\'\n                    : \'text-black dark:text-zinc-300 hover:text-black dark:hover:text-white\'\n                }`}\n              >\n                <Globe className=\"w-3.5 h-3.5 stroke-[2.5]\" />\n                <span>Published</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Title Input (High Contrast, Bold) */}\n          <div>\n            <input\n              type=\"text\"\n              value={title}\n              onChange={e => setTitle(e.target.value)}\n              placeholder=\"Title of your poem, story or verse...\"\n              className=\"w-full text-2xl md:text-3xl font-display-chic font-black text-black dark:text-white placeholder:text-black/50 dark:placeholder:text-zinc-500 bg-transparent border-none outline-none focus:ring-0 px-0\"\n            />\n          </div>\n\n          {/* Main Textarea (High Contrast, Deep Readable Color) */}\n          <div>\n            <textarea\n              value={content}\n              onChange={e => setContent(e.target.value)}\n              placeholder={\n                type === \'poem\'\n                  ? \'Pour your verses here...\\n\\nEvery line break a breath,\\nEvery word a quiet sanctuary.\'\n                  : \'Start writing your narrative or journal reflection...\'\n              }\n              rows={12}\n              className=\"w-full font-serif-literary text-lg md:text-xl text-black dark:text-zinc-100 placeholder:text-black/50 dark:placeholder:text-zinc-500 bg-transparent border-none outline-none focus:ring-0 p-0 resize-none leading-relaxed font-medium\"\n            />\n          </div>"
        start_line: 204
        end_line: 292
      }
