              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              When a writer is writing on an airplane or subway train with no cellular data, the app uses dual-tier persistence:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            </p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            <div className=\"p-4 rounded-xl bg-zinc-950 text-emerald-400 font-mono text-xs space-y-1\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <div>1. [User Edits Piece] --&gt; Written instantly to LocalStorage + Memory Cache</div>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <div>2. [Browser Network Event] --&gt; window.addEventListener(\'online\', ...)</div>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <div>3. [Sync Engine] --&gt; Flushes pending changes to cloud database (Supabase/Firebase)</div>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              <div>4. [Sync Status Pill] --&gt; Reflects \'Offline\', \'Syncing...\', or \'Synced\'</div>"
