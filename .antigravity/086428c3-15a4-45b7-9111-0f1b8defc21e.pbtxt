            }
            lines {
              text: "              <li><strong>Reactive Stores:</strong> React context hooks (<code className=\"font-mono text-pink-700 dark:text-pink-400 font-black\">useTheme</code>, <code className=\"font-mono text-pink-700 dark:text-pink-400 font-black\">useAuth</code>) broadcast changes across cards, modals, and bottom navigation bars without page reloads.</li>"
