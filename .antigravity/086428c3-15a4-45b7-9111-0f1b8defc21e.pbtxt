    content: "          <div className=\"flex items-center gap-2\">\n            <span className=\"px-3 py-1 rounded-full bg-indigo-600 text-white text-[11px] font-bold uppercase tracking-wider flex items-center gap-1.5 shadow-2xs\">\n              <ShieldCheck className=\"w-3.5 h-3.5\" />\n              <span>Developer God Mode</span>\n            </span>\n            <span className=\"text-xs text-indigo-900 dark:text-indigo-300 font-mono font-bold\">\n              Authenticated: {currentUser.email}\n            </span>\n          </div>\n\n          <h2 className=\"font-display-chic text-2xl md:text-3xl font-black text-zinc-950 dark:text-white\">\n            Engineering Console & Academy\n          </h2>\n\n          <p className=\"font-serif-literary text-zinc-700 dark:text-zinc-300 text-base max-w-2xl font-normal leading-relaxed\">\n            Complete platform observability, ethical moderation oversight (including user drafts review), developer roster management, and architectural learning guides.\n          </p>\n        </div>\n\n        <div className=\"absolute right-4 bottom-2 text-indigo-100 dark:text-indigo-950 opacity-60 pointer-events-none\" aria-hidden=\"true\">\n          <ThemeMotifIcon themeId={themeId} className=\"w-24 h-24\" />\n        </div>\n      </div>\n\n      {/* Navigation Tabs (God Mode, Dev Roster, Academy, Database) */}\n      <div className=\"flex items-center gap-1 p-1 bg-zinc-200/70 dark:bg-zinc-800/80 rounded-2xl overflow-x-auto text-xs font-bold border border-zinc-300 dark:border-zinc-700\">\n        <button\n          onClick={() => setActiveTab(\'godmode\')}\n          className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'godmode\'\n              ? \'bg-white dark:bg-zinc-700 text-zinc-950 dark:text-white shadow-xs\'\n              : \'text-zinc-700 dark:text-zinc-300 hover:text-zinc-950\'\n          }`}\n        >\n          <Eye className=\"w-3.5 h-3.5 text-pink-600\" />\n          <span>God Mode Moderation ({totalPieces})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'roster\')}\n          className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'roster\'\n              ? \'bg-white dark:bg-zinc-700 text-zinc-950 dark:text-white shadow-xs\'\n              : \'text-zinc-700 dark:text-zinc-300 hover:text-zinc-950\'\n          }`}\n        >\n          <Users className=\"w-3.5 h-3.5 text-indigo-600\" />\n          <span>Developer Roster ({devRoster.length})</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'academy\')}\n          className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'academy\'\n              ? \'bg-white dark:bg-zinc-700 text-zinc-950 dark:text-white shadow-xs\'\n              : \'text-zinc-700 dark:text-zinc-300 hover:text-zinc-950\'\n          }`}\n        >\n          <BookOpen className=\"w-3.5 h-3.5 text-emerald-600\" />\n          <span>App Dev Academy & Blueprints</span>\n        </button>\n\n        <button\n          onClick={() => setActiveTab(\'database\')}\n          className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 whitespace-nowrap ${\n            activeTab === \'database\'\n              ? \'bg-white dark:bg-zinc-700 text-zinc-950 dark:text-white shadow-xs\'\n              : \'text-zinc-700 dark:text-zinc-300 hover:text-zinc-950\'\n          }`}\n        >\n          <Database className=\"w-3.5 h-3.5 text-amber-600\" />\n          <span>Raw Database Inspector</span>\n        </button>\n      </div>\n\n      {/* TAB 1: GOD MODE & ETHICAL MODERATION */}\n      {activeTab === \'godmode\' && (\n        <div className=\"space-y-6\">\n          {/* Ethical Moderation Policy Banner */}\n          <div className=\"p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border-2 border-amber-300 dark:border-amber-700 text-xs text-amber-950 dark:text-amber-200 flex items-start gap-3\">\n            <ShieldAlert className=\"w-5 h-5 text-amber-600 shrink-0 mt-0.5\" />\n            <div>\n              <strong className=\"block font-bold\">Ethical Moderation Disclosure:</strong>\n              As lead developer, you have God Mode access to all writings across the system\342\200\224including private drafts and penpal-shared pieces. This allows ensuring platform safety, community guidelines compliance, and preventing harmful content. Draft access is strictly confidential for moderation and will be explicitly disclosed in the public Privacy Policy upon commercial launch.\n            </div>\n          </div>\n\n          {/* Quick Metrics Cards */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 text-center\">\n            <div className=\"p-4 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 shadow-2xs\">\n              <span className=\"font-mono text-2xl font-black text-zinc-950 dark:text-white\">{totalPieces}</span>\n              <div className=\"text-[11px] text-zinc-500 font-bold mt-1\">Total Pieces</div>\n            </div>\n            <div className=\"p-4 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 shadow-2xs\">\n              <span className=\"font-mono text-2xl font-black text-amber-600\">{draftPieces.length}</span>\n              <div className=\"text-[11px] text-zinc-500 font-bold mt-1\">Private Drafts</div>\n            </div>\n            <div className=\"p-4 rounded-2xl bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 shadow-2xs\">\n              <span className=\"font-mono text-2xl font-black text-emerald-600\">{publishedPieces.length}</span>\n              <div className=\"text-[11px] text-zinc-500 font-bold mt-1\">Published Pieces</div>\n            </div>"
    num_lines: 588
    num_bytes: 29895
  }
}
