    content: "          className=\"w-14 h-14 rounded-full flex items-center justify-center bg-black dark:bg-white text-white dark:text-black shadow-2xl border-2 border-white/40 active:scale-95 transition-transform\"\n          aria-label=\"Compose new piece\"\n        >\n          <Plus className=\"w-6 h-6 stroke-[3]\" />\n        </button>\n      </div>\n\n      {/* MOBILE FIXED BOTTOM TAB BAR (Navigation Anchor, Touch targets >= 44px, Solid Black Text in Light Mode) */}\n      <nav className=\"md:hidden fixed bottom-0 left-0 right-0 z-40 backdrop-blur-md bg-white/98 dark:bg-zinc-950/98 border-t-3 border-black/20 dark:border-zinc-800 h-16 grid grid-cols-4 items-center pb-safe no-print\">\n        <button\n          onClick={() => onSelectView(\'feed\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n            currentView === \'feed\'\n              ? \'text-black dark:text-white font-black\'\n              : \'text-black/80 dark:text-zinc-400 font-bold\'\n          }`}\n        >\n          <BookOpen className=\"w-5 h-5 stroke-[2.5]\" />\n          <span className=\"text-[10px] mt-1 font-black\">Logs</span>\n        </button>\n\n        <button\n          onClick={() => onSelectView(\'penpals\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n            currentView === \'penpals\'\n              ? \'text-black dark:text-white font-black\'\n              : \'text-black/80 dark:text-zinc-400 font-bold\'\n          }`}\n        >\n          <Mail className=\"w-5 h-5 stroke-[2.5]\" />\n          <span className=\"text-[10px] mt-1 font-black\">Penpals</span>\n        </button>\n\n        <button\n          onClick={() => onSelectView(\'widgets\')}\n          className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n            currentView === \'widgets\'\n              ? \'text-black dark:text-white font-black\'\n              : \'text-black/80 dark:text-zinc-400 font-bold\'\n          }`}\n        >\n          <Sparkles className=\"w-5 h-5 stroke-[2.5]\" />\n          <span className=\"text-[10px] mt-1 font-black\">Studio</span>\n        </button>\n\n        {isDeveloper ? (\n          <button\n            onClick={() => onSelectView(\'dev_academy\')}\n            className={`min-h-[44px] flex flex-col items-center justify-center transition-colors ${\n              currentView === \'dev_academy\'\n                ? \'text-indigo-800 dark:text-indigo-400 font-black\'\n                : \'text-indigo-950 dark:text-zinc-400 font-bold\'\n            }`}\n          >\n            <ShieldCheck className=\"w-5 h-5 stroke-[2.5]\" />\n            <span className=\"text-[10px] mt-1 font-black\">Dev</span>\n          </button>\n        ) : (\n          <button\n            onClick={onOpenProfile}\n            className=\"min-h-[44px] flex flex-col items-center justify-center text-black/80 dark:text-zinc-400 font-bold\"\n          >\n            <User className=\"w-5 h-5 stroke-[2.5]\" />\n            <span className=\"text-[10px] mt-1 font-black\">Profile</span>\n          </button>\n        )}\n      </nav>\n    </>\n  );\n};\n"
