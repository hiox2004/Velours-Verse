        instruction: "export type AestheticThemeId = \'coquette\' | \'y2k\' | \'matcha\' | \'midnight\';\n\nexport type ThemeMode = \'light\' | \'dark\';\n\nexport interface AestheticTheme {\n  id: AestheticThemeId;\n  name: string;\n  tagline: string;\n  motifName: string;\n  motifSymbol: string;\n  light: {\n    bg: string;\n    surface: string;\n    surfaceHover: string;\n    border: string;\n    textPrimary: string;\n    textSecondary: string;\n    accent: string;\n    accentHover: string;\n    accentSoft: string;\n    badgeBg: string;\n  };\n  dark: {\n    bg: string;\n    surface: string;\n    surfaceHover: string;\n    border: string;\n    textPrimary: string;\n    textSecondary: string;\n    accent: string;\n    accentHover: string;\n    accentSoft: string;\n    badgeBg: string;\n  };\n}\n\nexport interface CardTintOption {\n  id: string;\n  name: string;\n  lightBg: string;\n  lightBorder: string;\n  darkBg: string;\n  darkBorder: string;\n  colorDot: string;\n}\n\nexport const CARD_TINT_OPTIONS: CardTintOption[] = [\n  {\n    id: \'default\',\n    name: \'Theme Default\',\n    lightBg: \'bg-white\',\n    lightBorder: \'border-black/5\',\n    darkBg: \'bg-zinc-900\',\n    darkBorder: \'border-white/10\',\n    colorDot: \'#94A3B8\'\n  },\n  {\n    id: \'rose\',\n    name: \'Blush Ribbon\',\n    lightBg: \'bg-rose-50/70\',\n    lightBorder: \'border-rose-200/60\',\n    darkBg: \'bg-rose-950/25\',\n    darkBorder: \'border-rose-800/40\',\n    colorDot: \'#FB7185\'\n  },\n  {\n    id: \'lavender\',\n    name: \'Lilac Dream\',\n    lightBg: \'bg-purple-50/70\',\n    lightBorder: \'border-purple-200/60\',\n    darkBg: \'bg-purple-950/25\',\n    darkBorder: \'border-purple-800/40\',\n    colorDot: \'#C084FC\'\n  },\n  {\n    id: \'matcha\',\n    name: \'Matcha Sage\',\n    lightBg: \'bg-emerald-50/70\',\n    lightBorder: \'border-emerald-200/60\',\n    darkBg: \'bg-emerald-950/25\',\n    darkBorder: \'border-emerald-800/40\',\n    colorDot: \'#34D399\'\n  },\n  {\n    id: \'starlight\',\n    name: \'Cosmic Blue\',\n    lightBg: \'bg-indigo-50/70\',\n    lightBorder: \'border-indigo-200/60\',\n    darkBg: \'bg-indigo-950/25\',\n    darkBorder: \'border-indigo-800/40\',\n    colorDot: \'#818CF8\'\n  },\n  {\n    id: \'honey\',\n    name: \'Honey Amber\',\n    lightBg: \'bg-amber-50/70\',\n    lightBorder: \'border-amber-200/60\',\n    darkBg: \'bg-amber-950/25\',\n    darkBorder: \'border-amber-800/40\',\n    colorDot: \'#FBBF24\'\n  }\n];\n\nexport const THEMES: Record<AestheticThemeId, AestheticTheme> = {\n  coquette: {\n    id: \'coquette\',\n    name: \'Coquette Blush\',\n    tagline: \'Silk ribbons, delicate prose & sweet melancholia\',\n    motifName: \'Bow\',\n    motifSymbol: \'\360\237\216\200\',\n    light: {\n      bg: \'#FFF5F8\',\n      surface: \'#FFFFFF\',\n      surfaceHover: \'#FFF0F5\',\n      border: \'#FCE7F0\',\n      textPrimary: \'#4A1D2E\',\n      textSecondary: \'#9F5B74\',\n      accent: \'#DB2777\',\n      accentHover: \'#BE185D\',\n      accentSoft: \'#FDF2F8\',\n      badgeBg: \'#FCE7F3\'\n    },\n    dark: {\n      bg: \'#180B12\',\n      surface: \'#24101B\',\n      surfaceHover: \'#2E1523\',\n      border: \'#3F1A2F\',\n      textPrimary: \'#FDF2F8\',\n      textSecondary: \'#D977A6\',\n      accent: \'#F472B6\',\n      accentHover: \'#EC4899\',\n      accentSoft: \'#2E1523\',\n      badgeBg: \'#381628\'\n    }\n  },\n  y2k: {\n    id: \'y2k\',\n    name: \'Cyber Y2K Stars\',\n    tagline: \'Holographic starlight, chrome vibes & twilight verse\',\n    motifName: \'Star\',\n    motifSymbol: \'\342\234\247\',\n    light: {\n      bg: \'#F5F7FF\',\n      surface: \'#FFFFFF\',\n      surfaceHover: \'#EEF2FF\',\n      border: \'#E0E7FF\',\n      textPrimary: \'#1E1B4B\',\n      textSecondary: \'#6366F1\',\n      accent: \'#4F46E5\',\n      accentHover: \'#4338CA\',\n      accentSoft: \'#EEF2FF\',\n      badgeBg: \'#E0E7FF\'\n    },\n    dark: {\n      bg: \'#0A0C16\',\n      surface: \'#12172A\',\n      surfaceHover: \'#18203B\',\n      border: \'#232D4E\',\n      textPrimary: \'#EEF2FF\',\n      textSecondary: \'#94A3B8\',\n      accent: \'#818CF8\',\n      accentHover: \'#A5B4FC\',\n      accentSoft: \'#18203B\',\n      badgeBg: \'#1E294B\'\n    }\n  },\n  matcha: {\n    id: \'matcha\',\n    name: \'Matcha Latte\',\n    tagline: \'Cozy steam, botanical serenity & mindful journal\',\n    motifName: \'Matcha Leaf\',\n    motifSymbol: \'\360\237\214\277\',\n    light: {\n      bg: \'#F6F8F3\',\n      surface: \'#FFFFFF\',\n      surfaceHover: \'#EDF2E8\',\n      border: \'#E2EBD9\',\n      textPrimary: \'#1B3519\',\n      textSecondary: \'#4A6B44\',\n      accent: \'#2F6E2C\',\n      accentHover: \'#235320\',\n      accentSoft: \'#EEF5EA\',\n      badgeBg: \'#E3EEDC\'\n    },\n    dark: {\n      bg: \'#0D140E\',\n      surface: \'#152118\',\n      surfaceHover: \'#1D2D21\',\n      border: \'#273E2C\',\n      textPrimary: \'#F1F7F0\',\n      textSecondary: \'#8CAE88\',\n      accent: \'#4ADE80\',\n      accentHover: \'#86EFAC\',\n      accentSoft: \'#1A2A1D\',\n      badgeBg: \'#213625\'\n    }\n  },\n  midnight: {\n    id: \'midnight\',\n    name: \'Midnight Muse\',\n    tagline: \'Nocturnal thoughts, ink shadows & celestial poetry\',\n    motifName: \'Moon\',\n    motifSymbol: \'\360\237\214\231\',\n    light: {\n      bg: \'#F8F9FA\',\n      surface: \'#FFFFFF\',\n      surfaceHover: \'#F1F3F5\',\n      border: \'#E9ECEF\',\n      textPrimary: \'#181A1E\',\n      textSecondary: \'#6C757D\',\n      accent: \'#6366F1\',\n      accentHover: \'#4F46E5\',\n      accentSoft: \'#F3F4F6\',\n      badgeBg: \'#E5E7EB\'\n    },\n    dark: {\n      bg: \'#090A0F\',\n      surface: \'#11131C\',\n      surfaceHover: \'#181C29\',\n      border: \'#212738\',\n      textPrimary: \'#F8FAFC\',\n      textSecondary: \'#94A3B8\',\n      accent: \'#A78BFA\',\n      accentHover: \'#C4B5FD\',\n      accentSoft: \'#171B2B\',\n      badgeBg: \'#1F2438\'\n    }\n  }\n};\n"
