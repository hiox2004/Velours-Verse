    content: "export type AestheticThemeId = \'coquette\' | \'y2k\' | \'matcha\' | \'midnight\';\n\nexport type ThemeMode = \'light\' | \'dark\';\n\nexport interface AestheticTheme {\n  id: AestheticThemeId;\n  name: string;\n  tagline: string;\n  motifName: string;\n  light: {\n    bg: string;\n    surface: string;\n    surfaceElevated: string;\n    border: string;\n    borderStrong: string;\n    textPrimary: string;\n    textSecondary: string;\n    textMuted: string;\n    accent: string;\n    accentHover: string;\n    accentSoft: string;\n    badgeBg: string;\n    badgeText: string;\n  };\n  dark: {\n    bg: string;\n    surface: string;\n    surfaceElevated: string;\n    border: string;\n    borderStrong: string;\n    textPrimary: string;\n    textSecondary: string;\n    textMuted: string;\n    accent: string;\n    accentHover: string;\n    accentSoft: string;\n    badgeBg: string;\n    badgeText: string;\n  };\n}\n\nexport interface CardTintOption {\n  id: string;\n  name: string;\n  lightBg: string;\n  lightBorder: string;\n  darkBg: string;\n  darkBorder: string;\n  accentBar: string;\n  colorDot: string;\n}\n\nexport const CARD_TINT_OPTIONS: CardTintOption[] = [\n  {\n    id: \'default\',\n    name: \'Theme Default\',\n    lightBg: \'bg-white\',\n    lightBorder: \'border-zinc-300 shadow-[2px_2px_0px_0px_rgba(24,24,27,0.06)]\',\n    darkBg: \'bg-zinc-900\',\n    darkBorder: \'border-zinc-700/80 shadow-[2px_2px_0px_0px_rgba(0,0,0,0.5)]\',\n    accentBar: \'bg-zinc-400\',\n    colorDot: \'#71717A\'\n  },\n  {\n    id: \'rose\',\n    name: \'Blush Ribbon\',\n    lightBg: \'bg-white\',\n    lightBorder: \'border-rose-300 shadow-[2px_2px_0px_0px_rgba(225,29,72,0.12)]\',\n    darkBg: \'bg-zinc-900\',\n    darkBorder: \'border-rose-800/80 shadow-[2px_2px_0px_0px_rgba(225,29,72,0.25)]\',\n    accentBar: \'bg-rose-500\',\n    colorDot: \'#F43F5E\'\n  },\n  {\n    id: \'lavender\',\n    name: \'Lilac Dream\',\n    lightBg: \'bg-white\',\n    lightBorder: \'border-purple-300 shadow-[2px_2px_0px_0px_rgba(147,51,234,0.12)]\',\n    darkBg: \'bg-zinc-900\',\n    darkBorder: \'border-purple-800/80 shadow-[2px_2px_0px_0px_rgba(147,51,234,0.25)]\',\n    accentBar: \'bg-purple-500\',\n    colorDot: \'#A855F7\'\n  },\n  {\n    id: \'matcha\',\n    name: \'Matcha Sage\',\n    lightBg: \'bg-white\',\n    lightBorder: \'border-emerald-300 shadow-[2px_2px_0px_0px_rgba(5,150,105,0.12)]\',\n    darkBg: \'bg-zinc-900\',\n    darkBorder: \'border-emerald-800/80 shadow-[2px_2px_0px_0px_rgba(5,150,105,0.25)]\',\n    accentBar: \'bg-emerald-600\',\n    colorDot: \'#10B981\'\n  },\n  {\n    id: \'starlight\',\n    name: \'Cosmic Indigo\',\n    lightBg: \'bg-white\',\n    lightBorder: \'border-indigo-300 shadow-[2px_2px_0px_0px_rgba(79,70,229,0.12)]\',\n    darkBg: \'bg-zinc-900\',\n    darkBorder: \'border-indigo-800/80 shadow-[2px_2px_0px_0px_rgba(79,70,229,0.25)]\',\n    accentBar: \'bg-indigo-600\',\n    colorDot: \'#6366F1\'\n  },\n  {\n    id: \'honey\',\n    name: \'Honey Amber\',\n    lightBg: \'bg-white\',\n    lightBorder: \'border-amber-300 shadow-[2px_2px_0px_0px_rgba(217,119,6,0.12)]\',\n    darkBg: \'bg-zinc-900\',\n    darkBorder: \'border-amber-800/80 shadow-[2px_2px_0px_0px_rgba(217,119,6,0.25)]\',\n    accentBar: \'bg-amber-500\',\n    colorDot: \'#F59E0B\'\n  }\n];\n\nexport const THEMES: Record<AestheticThemeId, AestheticTheme> = {\n  coquette: {\n    id: \'coquette\',\n    name: \'Coquette Blush\',\n    tagline: \'Silk ribbons, delicate prose & sweet melancholia\',\n    motifName: \'Silk Bow\',\n    light: {\n      bg: \'#FDF7F9\', // Warm crisp porcelain with delicate rose undertone\n      surface: \'#FFFFFF\',\n      surfaceElevated: \'#FFF1F5\',\n      border: \'#FBCFE8\', // Crisp pink-200\n      borderStrong: \'#F472B6\', // pink-400\n      textPrimary: \'#18181B\', // Deep high-contrast black\n      textSecondary: \'#475569\', // Slate-600, sharp and readable\n      textMuted: \'#64748B\', // Slate-500\n      accent: \'#E11D48\', // Rich rose red\n      accentHover: \'#BE123C\',\n      accentSoft: \'#FFE4E6\',\n      badgeBg: \'#FCE7F3\',\n      badgeText: \'#9D174D\'\n    },\n    dark: {\n      bg: \'#140A0F\', // Velvet obsidian plum\n      surface: \'#1F1118\',\n      surfaceElevated: \'#2B1722\',\n      border: \'#4C1D38\',\n      borderStrong: \'#831843\',\n      textPrimary: \'#FDF2F8\', // Pure soft white\n      textSecondary: \'#E2E8F0\', // Very high contrast slate-200\n      textMuted: \'#CBD5E1\',\n      accent: \'#FB7185\', // Radiant pink rose\n      accentHover: \'#F43F5E\',\n      accentSoft: \'#381628\',\n      badgeBg: \'#4A1531\',\n      badgeText: \'#FCE7F3\'\n    }\n  },\n  y2k: {\n    id: \'y2k\',\n    name: \'Cyber Y2K Stars\',\n    tagline: \'Holographic starlight, chrome vibes & twilight verse\',\n    motifName: \'Chrome Star\',\n    light: {\n      bg: \'#F8FAFC\', // Crisp cool digital canvas\n      surface: \'#FFFFFF\',\n      surfaceElevated: \'#EEF2FF\',\n      border: \'#CBD5E1\', // Slate-300\n      borderStrong: \'#6366F1\', // Indigo\n      textPrimary: \'#0F172A\', // Slate-900, razor sharp\n      textSecondary: \'#334155\', // Slate-700\n      textMuted: \'#64748B\',\n      accent: \'#4F46E5\', // Electric indigo\n      accentHover: \'#4338CA\',\n      accentSoft: \'#E0E7FF\',\n      badgeBg: \'#E0E7FF\',\n      badgeText: \'#3730A3\'\n    },\n    dark: {\n      bg: \'#080A12\', // Deep cosmic twilight\n      surface: \'#101424\',\n      surfaceElevated: \'#171E36\',\n      border: \'#2A3660\',\n      borderStrong: \'#4F46E5\',\n      textPrimary: \'#F8FAFC\',\n      textSecondary: \'#E2E8F0\',\n      textMuted: \'#94A3B8\',\n      accent: \'#818CF8\', // Glowing starlight\n      accentHover: \'#A5B4FC\',\n      accentSoft: \'#1E2748\',\n      badgeBg: \'#1E2958\',\n      badgeText: \'#E0E7FF\'\n    }\n  },\n  matcha: {\n    id: \'matcha\',\n    name: \'Matcha Latte\',\n    tagline: \'Cozy steam, botanical serenity & mindful journal\',\n    motifName: \'Tea Leaf\',\n    light: {\n      bg: \'#F9FBF7\', // Clean organic tea steam ivory\n      surface: \'#FFFFFF\',\n      surfaceElevated: \'#EDF5EB\',\n      border: \'#D1E3CE\', // Botanical sage-300\n      borderStrong: \'#2D6A28\', // Deep forest matcha\n      textPrimary: \'#142614\', // Deep organic dark spruce\n      textSecondary: \'#374151\', // Gray-700\n      textMuted: \'#4B5563\',\n      accent: \'#235D20\', // Rich ceremonial matcha green\n      accentHover: \'#1B4719\',\n      accentSoft: \'#E4F1E1\',\n      badgeBg: \'#DCEDD8\',\n      badgeText: \'#184215\'\n    },\n    dark: {\n      bg: \'#0A120B\', // Deep pine moss\n      surface: \'#132115\',\n      surfaceElevated: \'#1B2F1E\',\n      border: \'#2C4A2F\',\n      borderStrong: \'#4ADE80\',\n      textPrimary: \'#F1F9F1\',\n      textSecondary: \'#D1E7D0\',\n      textMuted: \'#96B894\',\n      accent: \'#4ADE80\', // Fresh green sprout\n      accentHover: \'#86EFAC\',\n      accentSoft: \'#18301B\',\n      badgeBg: \'#1B3B1F\',\n      badgeText: \'#DCFCE7\'\n    }\n  },\n  midnight: {\n    id: \'midnight\',\n    name: \'Midnight Muse\',\n    tagline: \'Nocturnal thoughts, ink shadows & celestial poetry\',\n    motifName: \'Crescent Moon\',\n    light: {\n      bg: \'#F8F9FA\', // Clean literary paper\n      surface: \'#FFFFFF\',\n      surfaceElevated: \'#F1F3F5\',\n      border: \'#D0D5DD\', // Clean crisp slate\n      borderStrong: \'#475467\',\n      textPrimary: \'#101828\', // Rich ink black\n      textSecondary: \'#344054\', // Slate-700\n      textMuted: \'#475467\',\n      accent: \'#5925DC\', // Deep midnight violet\n      accentHover: \'#4A1FB8\',\n      accentSoft: \'#F4EBFF\',\n      badgeBg: \'#F4EBFF\',\n      badgeText: \'#5925DC\'\n    },\n    dark: {\n      bg: \'#08090E\', // Absolute obsidian\n      surface: \'#11131C\',\n      surfaceElevated: \'#181C2A\',\n      border: \'#252B3F\',\n      borderStrong: \'#7A5AF8\',\n      textPrimary: \'#F8FAFC\',\n      textSecondary: \'#E