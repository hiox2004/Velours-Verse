            }
            lines {
              text: "CREATE POLICY \"Public can view published writings\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  ON public.writings FOR SELECT"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
